<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("application.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || t("application.description") %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-[#0F1724] text-white min-h-screen">
    <%# Navigation %>
    <nav class="bg-[#0B0B0B] border-b border-[#6A0DAD]/20 sticky top-0 z-50" role="navigation" aria-label="<%= t("navigation.main") %>">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center">
            <%= link_to root_path, class: "flex items-center space-x-2 hover:opacity-80 transition-opacity" do %>
              <span class="text-2xl font-bold text-[#D4AF37]">GWANA</span>
            <% end %>
          </div>

          <div class="hidden md:flex items-center space-x-8">
            <%= link_to t("navigation.members"), members_path, class: "text-white hover:text-[#D4AF37] transition-colors" %>
            <%= link_to t("navigation.articles"), articles_path, class: "text-white hover:text-[#D4AF37] transition-colors" %>
            
            <% if user_signed_in? %>
              <%= link_to t("navigation.profile"), profile_path, class: "text-white hover:text-[#D4AF37] transition-colors" %>
              <% if current_user.admin? || current_user.admin_reseau? %>
                <%= link_to t("navigation.admin"), admin_root_path, class: "text-[#D4AF37] hover:text-[#B8860B] transition-colors" %>
              <% end %>
              <%= link_to t("devise.sign_out"), destroy_user_session_path, data: { turbo_method: :delete }, class: "text-white hover:text-[#D4AF37] transition-colors" %>
            <% else %>
              <%= link_to t("devise.sign_in"), new_user_session_path, class: "text-white hover:text-[#D4AF37] transition-colors" %>
              <%= link_to t("devise.sign_up"), new_user_registration_path, class: "bg-[#6A0DAD] hover:bg-[#5B21B6] text-white px-4 py-2 rounded-lg transition-colors" %>
            <% end %>
          </div>

          <%# Mobile menu button %>
          <button type="button" class="md:hidden text-white hover:text-[#D4AF37] transition-colors" aria-label="<%= t("navigation.menu") %>" aria-expanded="false" data-controller="mobile-menu" data-action="click->mobile-menu#toggle">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>

        <%# Mobile menu %>
        <div class="md:hidden hidden" data-mobile-menu-target="menu">
          <div class="px-2 pt-2 pb-3 space-y-1 border-t border-[#6A0DAD]/20">
            <%= link_to t("navigation.members"), members_path, class: "block px-3 py-2 text-white hover:text-[#D4AF37] transition-colors" %>
            <%= link_to t("navigation.articles"), articles_path, class: "block px-3 py-2 text-white hover:text-[#D4AF37] transition-colors" %>
            
            <% if user_signed_in? %>
              <%= link_to t("navigation.profile"), profile_path, class: "block px-3 py-2 text-white hover:text-[#D4AF37] transition-colors" %>
              <% if current_user.admin? || current_user.admin_reseau? %>
                <%= link_to t("navigation.admin"), admin_root_path, class: "block px-3 py-2 text-[#D4AF37] hover:text-[#B8860B] transition-colors" %>
              <% end %>
              <%= link_to t("devise.sign_out"), destroy_user_session_path, data: { turbo_method: :delete }, class: "block px-3 py-2 text-white hover:text-[#D4AF37] transition-colors" %>
            <% else %>
              <%= link_to t("devise.sign_in"), new_user_session_path, class: "block px-3 py-2 text-white hover:text-[#D4AF37] transition-colors" %>
              <%= link_to t("devise.sign_up"), new_user_registration_path, class: "block px-3 py-2 bg-[#6A0DAD] hover:bg-[#5B21B6] text-white rounded-lg transition-colors text-center" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <%# Flash messages %>
    <% if notice %>
      <div class="bg-[#6A0DAD] text-white px-4 py-3 rounded-lg mx-4 mt-4" role="alert" aria-live="polite">
        <%= notice %>
      </div>
    <% end %>
    <% if alert %>
      <div class="bg-red-600 text-white px-4 py-3 rounded-lg mx-4 mt-4" role="alert" aria-live="assertive">
        <%= alert %>
      </div>
    <% end %>

    <%# Main content %>
    <main class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>

    <%# Footer %>
    <footer class="bg-[#0B0B0B] border-t border-[#6A0DAD]/20 mt-auto" role="contentinfo">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h3 class="text-[#D4AF37] font-bold mb-4">GWANA</h3>
            <p class="text-gray-400 text-sm"><%= t("footer.description") %></p>
          </div>
          <div>
            <h4 class="text-white font-semibold mb-4"><%= t("footer.links") %></h4>
            <ul class="space-y-2">
              <li><%= link_to t("navigation.members"), members_path, class: "text-gray-400 hover:text-[#D4AF37] transition-colors text-sm" %></li>
              <li><%= link_to t("navigation.articles"), articles_path, class: "text-gray-400 hover:text-[#D4AF37] transition-colors text-sm" %></li>
            </ul>
          </div>
          <div>
            <h4 class="text-white font-semibold mb-4"><%= t("footer.contact") %></h4>
            <p class="text-gray-400 text-sm"><%= t("footer.email") %></p>
          </div>
        </div>
        <div class="mt-8 pt-8 border-t border-[#6A0DAD]/20 text-center text-gray-400 text-sm">
          <p>&copy; <%= Date.current.year %> GWANA. <%= t("footer.rights") %></p>
        </div>
      </div>
    </footer>
  </body>
</html>
