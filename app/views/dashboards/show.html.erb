<% content_for :title, "Mon Espace" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
  <% if @user.user? %>
    <% if @my_mentorship_requests&.any? %>
      <!-- Layout avec sidebar quand il y a des demandes -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
        <!-- Colonne principale : Demandes en cours -->
        <div class="lg:col-span-2">
          <div class="space-y-4">
            <% @my_mentorship_requests.each do |request| %>
              <div class="bg-white rounded-lg border border-gray-200 p-4 sm:p-6 shadow-sm hover:shadow-md transition-shadow">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-4">
                  <div class="flex items-start gap-3 sm:gap-4 flex-1">
                    <div class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center flex-shrink-0">
                      <svg class="w-5 h-5 sm:w-6 sm:h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                      </svg>
                    </div>
                    <div class="flex-1 min-w-0">
                      <h3 class="text-base sm:text-lg font-semibold text-gray-900 mb-1 break-words">
                        Mentorat avec <%= request.mentor.gwana_profile&.full_name || request.mentor.email %>
                      </h3>
                      <p class="text-sm text-gray-600 mb-3 line-clamp-2">
                        <%= request.motivation&.truncate(80) %>
                      </p>
                      <div class="flex items-center gap-4 text-xs text-gray-500">
                        <span>Créé le <%= format_request_date(request.created_at) %></span>
                      </div>
                    </div>
                  </div>
                  <div class="flex-shrink-0">
                    <%= mentorship_request_status_badge(request.status) %>
                  </div>
                </div>
                <div class="flex items-center justify-end pt-4 border-t border-gray-100">
                  <%= link_to mentorship_request_path(request), class: "flex items-center gap-2 px-3 sm:px-4 py-2 bg-gray-800 text-white rounded-lg hover:bg-gray-700 transition-colors text-sm font-medium" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                    Continuer
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Colonne latérale : Actions rapides -->
        <div class="lg:col-span-1">
          <div class="sticky top-8">
            <%= link_to new_mentorship_request_path, class: "w-full flex items-center justify-center gap-2 px-4 py-2.5 bg-gray-800 text-white rounded-lg hover:bg-gray-700 transition-colors text-sm font-medium mb-3" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              Nouvelle demande
            <% end %>
            <p class="text-xs sm:text-sm text-gray-600 text-center">
              <%= @my_mentorship_requests.count %> <%= @my_mentorship_requests.count == 1 ? "en cours" : "en cours" %>
            </p>
          </div>
        </div>
      </div>
    <% else %>
      <!-- État vide : Card centrée au milieu -->
      <div class="flex items-center justify-center min-h-[60vh] sm:min-h-[70vh]">
        <div class="w-full max-w-md bg-white rounded-lg border border-gray-200 p-8 sm:p-12 text-center">
          <div class="w-16 h-16 sm:w-20 sm:h-20 mx-auto mb-6 rounded-lg bg-gray-100 flex items-center justify-center">
            <svg class="w-8 h-8 sm:w-10 sm:h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-3">Aucune demande de mentorat</h3>
          <p class="text-sm sm:text-base text-gray-600 mb-6">
            Commencez votre première demande de mentorat en quelques étapes simples et sécurisées.
          </p>
          <%= link_to new_mentorship_request_path, class: "inline-flex items-center gap-2 px-6 py-3 bg-gray-800 text-white rounded-lg hover:bg-gray-700 transition-colors font-medium text-sm sm:text-base" do %>
            <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            Soumettre une demande
          <% end %>
        </div>
      </div>
    <% end %>
  <% elsif @user.gwana? %>
    <!-- Profil de la gwana comme dashboard -->
    <% content_for :title, "Mon Profil" %>
    
    <!-- Informations de base - Une seule carte -->
    <div class="bg-gradient-to-br from-white via-purple-50/30 to-gray-50 rounded-2xl p-6 md:p-8 mb-8 border border-purple-700/30 shadow-xl hover:shadow-2xl transition-shadow duration-300">
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Photo ou Avatar -->
        <div class="flex-shrink-0 flex justify-center lg:justify-start">
          <% if @gwana&.persisted? && @gwana&.photo&.attached? %>
            <div class="relative">
              <div class="absolute inset-0 bg-gradient-to-br from-purple-700 to-amber-500 rounded-full blur-2xl opacity-50"></div>
              <%= image_tag @gwana.photo, alt: current_user.full_name, class: "relative w-32 h-32 rounded-full object-cover border-4 border-purple-700/50 shadow-2xl" %>
            </div>
          <% else %>
            <div class="relative">
              <div class="absolute inset-0 bg-gradient-to-br from-purple-700 to-amber-500 rounded-full blur-2xl opacity-50"></div>
              <div class="relative w-32 h-32 rounded-full bg-gradient-to-br from-purple-700 to-purple-800 flex items-center justify-center border-4 border-purple-700/50 shadow-2xl">
                <div class="text-4xl font-bold text-white">
                  <%= current_user.first_name&.first&.upcase || 'U' %><%= current_user.last_name&.first&.upcase || '' %>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Informations principales -->
        <div class="flex-1">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-6">
            <div>
              <h1 class="text-3xl md:text-4xl font-bold bg-gradient-to-r from-purple-700 to-purple-800 bg-clip-text text-transparent mb-2">
                <%= current_user.full_name %>
              </h1>
              <% if @gwana&.profession.present? %>
                <p class="text-xl text-amber-500 font-semibold mb-3"><%= @gwana.profession %></p>
              <% end %>
            </div>
            <%= link_to edit_profile_path, class: "inline-flex items-center gap-2 px-4 py-2 bg-purple-700 hover:bg-purple-800 text-white rounded-lg font-semibold transition-all duration-300 hover:scale-105 shadow-lg self-start" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              Modifier
            <% end %>
          </div>

          <!-- Grille d'informations -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Informations personnelles -->
            <div class="space-y-4">
              <h3 class="text-sm font-semibold text-purple-700 uppercase tracking-wide mb-3">Informations personnelles</h3>
              
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-purple-700 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
                <div>
                  <p class="text-xs text-gray-500 uppercase">Email</p>
                  <p class="text-gray-900 font-medium break-all"><%= current_user.email %></p>
                </div>
              </div>

              <% if @gwana&.phone.present? %>
                <div class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-purple-700 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                  </svg>
                  <div>
                    <p class="text-xs text-gray-500 uppercase">Téléphone</p>
                    <p class="text-gray-900 font-medium"><%= @gwana.phone %></p>
                  </div>
                </div>
              <% end %>

              <% if @gwana&.address.present? %>
                <div class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-purple-700 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  <div>
                    <p class="text-xs text-gray-500 uppercase">Adresse</p>
                    <p class="text-gray-900 font-medium break-words"><%= @gwana.address %></p>
                  </div>
                </div>
              <% end %>

              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-purple-700 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
                <div>
                  <p class="text-xs text-gray-500 uppercase">Profil</p>
                  <span class="inline-flex items-center gap-1 bg-purple-700/20 text-purple-700 font-semibold px-3 py-1 rounded-full text-sm border border-purple-700/30">
                    <%= current_user.profile.capitalize %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Localisation et statut -->
            <div class="space-y-4">
              <h3 class="text-sm font-semibold text-purple-700 uppercase tracking-wide mb-3">Localisation & Statut</h3>
              
              <% if @gwana&.region.present? %>
                <div class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-purple-700 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  <div>
                    <p class="text-xs text-gray-500 uppercase">Localisation</p>
                    <p class="text-gray-900 font-medium">
                      <%= @gwana.region %>
                      <% if @gwana.commune.present? && @gwana.commune != "non fourni" %>
                        <span class="text-gray-600">• <%= @gwana.commune %></span>
                      <% end %>
                    </p>
                  </div>
                </div>
              <% end %>

              <% if @gwana&.available_for_mentorship? %>
                <div class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-amber-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                  <div>
                    <p class="text-xs text-gray-500 uppercase">Disponibilité</p>
                    <span class="inline-flex items-center gap-1 bg-gradient-to-r from-purple-700/30 to-purple-800/30 text-amber-500 font-semibold px-3 py-1 rounded-full text-sm border border-amber-500/30">
                      Disponible pour mentorat
                    </span>
                  </div>
                </div>
              <% end %>

              <!-- Réseaux sociaux -->
              <% if @gwana && (@gwana.linkedin_url.present? || @gwana.twitter_url.present? || @gwana.website_url.present?) %>
                <div class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-purple-700 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
                  </svg>
                  <div>
                    <p class="text-xs text-gray-500 uppercase mb-2">Réseaux sociaux</p>
                    <div class="flex items-center gap-2">
                      <% if @gwana.linkedin_url.present? %>
                        <%= link_to @gwana.linkedin_url, target: "_blank", rel: "noopener", class: "w-9 h-9 flex items-center justify-center bg-purple-700/20 hover:bg-purple-700/40 text-purple-700 rounded-full transition-all hover:scale-110 border border-purple-700/30" do %>
                          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                        <% end %>
                      <% end %>
                      <% if @gwana.twitter_url.present? %>
                        <%= link_to @gwana.twitter_url, target: "_blank", rel: "noopener", class: "w-9 h-9 flex items-center justify-center bg-purple-700/20 hover:bg-purple-700/40 text-purple-700 rounded-full transition-all hover:scale-110 border border-purple-700/30" do %>
                          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/></svg>
                        <% end %>
                      <% end %>
                      <% if @gwana.website_url.present? %>
                        <%= link_to @gwana.website_url, target: "_blank", rel: "noopener", class: "w-9 h-9 flex items-center justify-center bg-purple-700/20 hover:bg-purple-700/40 text-purple-700 rounded-full transition-all hover:scale-110 border border-purple-700/30" do %>
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats Section -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <div class="bg-white rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-12 h-12 rounded-full bg-amber-500/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
            </svg>
          </div>
          <div>
            <div class="text-3xl font-bold text-amber-500"><%= current_user.mentorship_requests_as_mentor.count %></div>
            <div class="text-gray-600 text-sm">Demandes reçues</div>
          </div>
        </div>
      </div>
      <div class="bg-white rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-12 h-12 rounded-full bg-green-500/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div>
            <div class="text-3xl font-bold text-green-500"><%= current_user.mentorship_requests_as_mentor.accepted.count %></div>
            <div class="text-gray-600 text-sm">Mentorats actifs</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
      <!-- Left Column - Main Info -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Biographie -->
        <% if @gwana&.bio.present? %>
          <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-amber-500">Biographie</h2>
            </div>
            <div class="text-gray-700 leading-relaxed">
              <%= simple_format(@gwana.bio) %>
            </div>
          </div>
        <% end %>

        <!-- Expériences -->
        <% if @gwana&.experiences.present? %>
          <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-amber-500">Expériences professionnelles</h2>
            </div>
            <div class="text-gray-700 leading-relaxed">
              <%= simple_format(@gwana.experiences) %>
            </div>
          </div>
        <% end %>

        <!-- Formations -->
        <% if @gwana&.formations.present? %>
          <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-amber-500">Formations</h2>
            </div>
            <div class="text-gray-700 leading-relaxed">
              <%= simple_format(@gwana.formations) %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Right Column - Sidebar Info -->
      <div class="space-y-6 lg:sticky lg:top-6 lg:self-start">
        <!-- Compétences -->
        <% if @gwana&.skills.present? && @gwana.skills_array.any? %>
          <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
              </div>
              <h2 class="text-xl font-bold text-amber-500">Compétences</h2>
            </div>
            <div class="flex flex-wrap gap-2">
              <% @gwana.skills_array.each do |skill| %>
                <span class="bg-purple-700/20 text-amber-500 px-4 py-2 rounded-full text-sm font-medium border border-purple-700/30 hover:bg-purple-700/30 hover:border-purple-700/50 transition-all duration-200 cursor-default">
                  <%= skill %>
                </span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
