<% if @user.gwana? %>
  <% content_for :title, "Tableau de bord" %>
<% else %>
<% content_for :title, "Mon Espace" %>
<% end %>

<div>
  <% if @user.user? %>
    <% if @my_mentorship_requests&.any? %>
      <!-- Layout avec sidebar quand il y a des demandes -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
        <!-- Colonne principale : Demandes en cours -->
        <div class="lg:col-span-2">
          <div class="space-y-4">
            <% @my_mentorship_requests.each do |request| %>
              <div class="bg-white rounded-lg border border-gray-200 p-4 sm:p-6 shadow-sm hover:shadow-md transition-shadow">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-4">
                  <div class="flex items-start gap-3 sm:gap-4 flex-1">
                    <div class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center flex-shrink-0">
                      <svg class="w-5 h-5 sm:w-6 sm:h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                      </svg>
                    </div>
                    <div class="flex-1 min-w-0">
                      <h3 class="text-base sm:text-lg font-semibold text-gray-900 mb-1 break-words">
                        Mentorat avec <%= request.mentor.gwana_profile ? "#{request.mentor.gwana_profile.first_name} #{request.mentor.gwana_profile.last_name}" : request.mentor.first_name %>
                      </h3>
                      <p class="text-sm text-gray-600 mb-3 line-clamp-2">
                        <%= request.motivation&.truncate(80) %>
                      </p>
                      <div class="flex items-center gap-4 text-xs text-gray-500">
                        <span>Créé le <%= format_request_date(request.created_at) %></span>
                      </div>
                    </div>
                  </div>
                  <div class="flex-shrink-0">
                    <%= mentorship_request_status_badge(request.status) %>
                  </div>
                </div>
                <div class="flex items-center justify-end pt-4 border-t border-gray-100">
                  <%= link_to mentorship_request_path(request), class: "flex items-center gap-2 px-3 sm:px-4 py-2 bg-gray-800 text-white rounded-lg hover:bg-gray-700 transition-colors text-sm font-medium" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                    Continuer
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Colonne latérale : Actions rapides -->
        <div class="lg:col-span-1">
          <div class="sticky top-8">
            <%= link_to new_mentorship_request_path, class: "w-full flex items-center justify-center gap-2 px-4 py-2.5 bg-gray-800 text-white rounded-lg hover:bg-gray-700 transition-colors text-sm font-medium mb-3" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              Nouvelle demande
            <% end %>
            <p class="text-xs sm:text-sm text-gray-600 text-center">
              <%= @my_mentorship_requests.count %> <%= @my_mentorship_requests.count == 1 ? "en cours" : "en cours" %>
            </p>
          </div>
        </div>
      </div>
    <% else %>
      <!-- État vide : Card centrée au milieu -->
      <div class="flex items-center justify-center min-h-[60vh] sm:min-h-[70vh]">
        <div class="w-full max-w-md bg-white rounded-lg border border-gray-200 p-8 sm:p-12 text-center">
          <div class="w-16 h-16 sm:w-20 sm:h-20 mx-auto mb-6 rounded-lg bg-gray-100 flex items-center justify-center">
            <svg class="w-8 h-8 sm:w-10 sm:h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-3">Aucune demande de mentorat</h3>
          <p class="text-sm sm:text-base text-gray-600 mb-6">
            Commencez votre première demande de mentorat en quelques étapes simples et sécurisées.
          </p>
          <%= link_to new_mentorship_request_path, class: "inline-flex items-center gap-2 px-6 py-3 bg-purple-600 text-white rounded-lg hover:bg-purple-800 transition-colors font-medium text-sm sm:text-base" do %>
            <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            Soumettre une demande
          <% end %>
        </div>
      </div>
    <% end %>
  <% elsif @user.gwana? %>
    <!-- Dashboard gwanas avec métriques -->
    <div class="space-y-8">
      <!-- Cartes de métriques principales -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
      <!-- Total mentorats -->
      <div class="group bg-white rounded-2xl shadow-lg p-6 border border-gray-100 hover:shadow-2xl hover:border-purple-700/30 transition-all duration-300 transform hover:-translate-y-1 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-purple-700/5 to-transparent rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative z-10">
          <div class="flex items-center justify-between mb-4">
            <div class="p-3 bg-gradient-to-br from-purple-700/10 to-purple-800/10 rounded-xl group-hover:from-purple-700/20 group-hover:to-purple-800/20 transition-all duration-300">
              <svg class="w-6 h-6 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
              </svg>
            </div>
          </div>
          <div class="text-4xl font-bold text-gray-900 mb-1"><%= @metrics[:total_mentorships] %></div>
          <div class="text-sm text-gray-600 font-medium">Total mentorats</div>
                </div>
              </div>

      <!-- Mentorats acceptés -->
      <div class="group bg-white rounded-2xl shadow-lg p-6 border border-gray-100 hover:shadow-2xl hover:border-green-500/30 transition-all duration-300 transform hover:-translate-y-1 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-green-500/5 to-transparent rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative z-10">
          <div class="flex items-center justify-between mb-4">
            <div class="p-3 bg-gradient-to-br from-green-500/10 to-green-600/10 rounded-xl group-hover:from-green-500/20 group-hover:to-green-600/20 transition-all duration-300">
              <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  </div>
                </div>
          <div class="text-4xl font-bold text-gray-900 mb-1"><%= @metrics[:accepted_mentorships] %></div>
          <div class="text-sm text-gray-600 font-medium">Acceptés</div>
              </div>
            </div>

      <!-- Mentorats en attente -->
      <div class="group bg-white rounded-2xl shadow-lg p-6 border border-gray-100 hover:shadow-2xl hover:border-yellow-500/30 transition-all duration-300 transform hover:-translate-y-1 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-yellow-500/5 to-transparent rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative z-10">
          <div class="flex items-center justify-between mb-4">
            <div class="p-3 bg-gradient-to-br from-yellow-500/10 to-yellow-600/10 rounded-xl group-hover:from-yellow-500/20 group-hover:to-yellow-600/20 transition-all duration-300">
              <svg class="w-6 h-6 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
            </div>
          </div>
          <div class="text-4xl font-bold text-gray-900 mb-1"><%= @metrics[:pending_mentorships] %></div>
          <div class="text-sm text-gray-600 font-medium">En attente</div>
      </div>
    </div>

      <!-- Mentorats complétés -->
      <div class="group bg-white rounded-2xl shadow-lg p-6 border border-gray-100 hover:shadow-2xl hover:border-blue-500/30 transition-all duration-300 transform hover:-translate-y-1 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-blue-500/5 to-transparent rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative z-10">
          <div class="flex items-center justify-between mb-4">
            <div class="p-3 bg-gradient-to-br from-blue-500/10 to-blue-600/10 rounded-xl group-hover:from-blue-500/20 group-hover:to-blue-600/20 transition-all duration-300">
              <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          </div>
          <div class="text-4xl font-bold text-gray-900 mb-1"><%= @metrics[:completed_mentorships] %></div>
          <div class="text-sm text-gray-600 font-medium">Complétés</div>
        </div>
      </div>
      
      <!-- Mentorats refusés -->
      <div class="group bg-white rounded-2xl shadow-lg p-6 border border-gray-100 hover:shadow-2xl hover:border-red-500/30 transition-all duration-300 transform hover:-translate-y-1 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-red-500/5 to-transparent rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative z-10">
          <div class="flex items-center justify-between mb-4">
            <div class="p-3 bg-gradient-to-br from-red-500/10 to-red-600/10 rounded-xl group-hover:from-red-500/20 group-hover:to-red-600/20 transition-all duration-300">
              <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </div>
          </div>
          <div class="text-4xl font-bold text-gray-900 mb-1"><%= @metrics[:rejected_mentorships] %></div>
          <div class="text-sm text-gray-600 font-medium">Refusés</div>
        </div>
      </div>
    </div>

      <!-- Graphiques et statistiques -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Graphique mentorats par statut -->
        <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100">
        <h2 class="text-lg sm:text-xl font-bold text-gray-900 mb-4">Répartition par statut</h2>
        <% if @metrics[:total_mentorships] > 0 %>
          <%= pie_chart({
            "En attente" => @metrics[:mentorships_by_status][:pending],
            "Acceptés" => @metrics[:mentorships_by_status][:accepted],
            "Refusés" => @metrics[:mentorships_by_status][:rejected],
            "Complétés" => @metrics[:mentorships_by_status][:completed],
            "Annulés" => @metrics[:mentorships_by_status][:cancelled]
          }, colors: ["#eab308", "#22c55e", "#ef4444", "#3b82f6", "#6b7280"], height: "300px") %>
        <% else %>
          <div class="flex items-center justify-center h-64 text-gray-500">
            <p>Aucune donnée disponible</p>
          </div>
        <% end %>
      </div>

        <!-- Graphique mentorats par mois -->
        <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100">
        <h2 class="text-lg sm:text-xl font-bold text-gray-900 mb-4">Évolution mensuelle</h2>
        <% if @metrics[:total_mentorships] > 0 %>
          <%= line_chart @metrics[:mentorships_by_month], colors: ["#7c3aed"], height: "300px", library: { plugins: { legend: { display: false } } } %>
        <% else %>
          <div class="flex items-center justify-center h-64 text-gray-500">
            <p>Aucune donnée disponible</p>
          </div>
        <% end %>
      </div>

      <!-- Mentorats récents -->
      <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4">
        <h2 class="text-lg sm:text-xl font-bold text-gray-900">Mentorats récents</h2>
        <%= link_to mentorship_requests_path, class: "text-sm text-purple-700 hover:text-purple-800 font-semibold inline-flex items-center gap-1" do %>
          Voir tout
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
        <% end %>
      </div>

      <% if @metrics[:recent_mentorships].any? %>
        <div class="space-y-3 sm:space-y-4">
          <% @metrics[:recent_mentorships].each do |request| %>
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 sm:gap-4 p-3 sm:p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
              <div class="flex-1 min-w-0">
                <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 mb-2">
                  <h3 class="text-sm sm:text-base font-semibold text-gray-900 truncate">
                    <%= request.requester.decorate.full_name %>
                  </h3>
                  <span class="px-2 py-1 rounded-full text-xs font-semibold inline-flex items-center w-fit <%= 
                    request.pending? ? 'bg-yellow-100 text-yellow-800' : 
                    request.accepted? ? 'bg-green-100 text-green-800' : 
                    request.rejected? ? 'bg-red-100 text-red-800' : 
                    request.completed? ? 'bg-blue-100 text-blue-800' :
                    'bg-gray-100 text-gray-800' 
                  %>">
                    <%= request.decorate.status_label %>
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-gray-600 line-clamp-2">
                  <%= request.motivation&.truncate(100) %>
                </p>
                <p class="text-xs text-gray-500 mt-1">
                  <%= l(request.created_at, format: :short) %>
                </p>
              </div>
              <div class="flex-shrink-0">
                <%= link_to mentorship_request_path(request), class: "inline-flex items-center gap-1 px-3 py-2 text-sm bg-purple-700 text-white rounded-lg hover:bg-purple-800 transition-colors" do %>
                  Voir
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
                <% end %>
              </div>
            </div>
              <% end %>
            </div>
      <% else %>
        <div class="text-center py-8 text-gray-500">
          <p>Aucun mentorat pour le moment</p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
