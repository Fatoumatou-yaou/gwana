<% content_for :title, @article.title %>

<section data-controller="article-reader" class="bg-gradient-to-b from-white via-gray-50 to-white py-12 md:py-16">
  <!-- Reading Progress Bar -->
  <div data-article-reader-target="progress" class="fixed top-0 left-0 w-full h-1 bg-gray-200 z-50">
    <div class="h-full bg-gradient-to-r from-purple-600 to-purple-700 transition-all duration-150 ease-out"></div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav class="mb-8" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-sm text-gray-600">
        <li>
          <%= link_to "Accueil", root_path, class: "hover:text-purple-700 transition-colors" %>
        </li>
        <li>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </li>
        <li>
          <%= link_to "Actualités", articles_path, class: "hover:text-purple-700 transition-colors" %>
        </li>
        <li>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </li>
        <li class="text-gray-900 font-medium truncate max-w-xs"><%= truncate(@article.title, length: 40) %></li>
      </ol>
    </nav>


    <article class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
      <!-- En-tête de l'article -->
      <div class="px-6 md:px-10 pt-8 md:pt-12 pb-6 border-b border-gray-100">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <span class="text-sm font-semibold text-purple-700 bg-purple-700/10 px-4 py-2 rounded-full border border-purple-700/20">
            <%= @article.category %>
          </span>
          <% if @article.published_at %>
            <time datetime="<%= @article.published_at.iso8601 %>" class="text-sm text-gray-500 flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <%= l(@article.published_at, format: :long) %>
            </time>
          <% end %>
        </div>
        
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-6 leading-tight">
          <%= @article.title %>
        </h1>
        
        <% if @article.author.gwana_profile&.full_name.present? %>
          <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
            <div class="w-10 h-10 bg-gradient-to-br from-purple-700 to-purple-800 rounded-full flex items-center justify-center">
              <span class="text-white font-semibold text-sm"><%= @article.author.gwana_profile.full_name.first.upcase %></span>
            </div>
            <div>
              <p class="text-sm text-gray-500">Par</p>
              <p class="text-base font-semibold text-gray-900"><%= @article.author.gwana_profile.full_name %></p>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Média (Photo ou Vidéo) -->
      <% if @article.photo.attached? %>
        <div class="w-full mb-8">
          <div class="relative overflow-hidden bg-gradient-to-br from-gray-100 to-gray-200">
            <%= image_tag @article.photo, 
                alt: @article.title, 
                class: "w-full h-auto object-cover" 
            %>
          </div>
        </div>
      <% elsif @article.video.attached? %>
        <div class="w-full mb-8 bg-black rounded-lg overflow-hidden">
          <div class="relative aspect-video">
            <video controls class="w-full h-full object-contain">
              <source src="<%= url_for(@article.video) %>" type="<%= @article.video.content_type %>">
              Votre navigateur ne supporte pas la lecture de vidéos.
            </video>
          </div>
        </div>
      <% end %>

      <!-- Contenu de l'article -->
      <div class="px-6 md:px-10 pb-8 md:pb-12">
        <div class="article-content text-gray-700 text-lg leading-relaxed whitespace-pre-wrap">
          <%= simple_format(@article.content.to_s, {}, wrapper_tag: "div") %>
        </div>

        <!-- Tags -->
        <% if @article.tags.present? %>
          <div class="mt-12 pt-8 border-t border-gray-200">
            <div class="flex items-center gap-2 mb-4">
              <svg class="w-5 h-5 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
              </svg>
              <h3 class="text-lg font-semibold text-gray-900">Tags</h3>
            </div>
            <div class="flex flex-wrap gap-2">
              <% @article.tags_array.each do |tag| %>
                <span class="px-4 py-2 bg-gray-100 text-purple-700 text-sm font-medium rounded-full border border-gray-200 hover:bg-purple-700/10 hover:border-purple-700/30 transition-all duration-200 cursor-default">
                  #<%= tag %>
                </span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </article>

    <!-- Articles similaires -->
    <% similar_articles = Article.published.where.not(id: @article.id).where(category: @article.category).limit(3) %>
    <% if similar_articles.any? %>
      <div class="mt-16">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
          <svg class="w-6 h-6 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
          </svg>
          Articles similaires
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% similar_articles.each do |article| %>
            <article class="bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-all duration-300 group">
              <% if article.photo.attached? %>
                <div class="aspect-video overflow-hidden">
                  <%= image_tag article.photo, alt: article.title, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" %>
                </div>
              <% end %>

              <div class="p-6">
                <div class="flex items-center gap-2 mb-3">
                  <span class="text-xs font-semibold text-purple-700 bg-purple-700/10 px-3 py-1 rounded-full">
                    <%= article.category %>
                  </span>
                  <% if article.published_at %>
                    <time class="text-xs text-gray-500">
                      <%= l(article.published_at, format: :short) %>
                    </time>
                  <% end %>
                </div>

                <h3 class="text-lg font-bold text-gray-900 mb-3 line-clamp-2 group-hover:text-purple-700 transition-colors">
                  <%= link_to article.title, article_path(article), class: "hover:underline" %>
                </h3>

                <p class="text-gray-600 text-sm line-clamp-3 mb-4">
                  <%= truncate(strip_tags(article.content.to_s), length: 120) %>
                </p>

                <%= link_to article_path(article), class: "inline-flex items-center gap-2 text-purple-700 font-semibold text-sm hover:text-purple-600 transition-colors" do %>
                  <span>Lire l'article</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                <% end %>
              </div>
            </article>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Navigation vers les autres articles -->
    <div class="mt-12 flex items-center justify-between gap-4 pt-8 border-t border-gray-200">
      <%= link_to articles_path,
          class: "inline-flex items-center gap-2 px-6 py-3 bg-white text-purple-700 hover:text-purple-600 font-semibold rounded-xl border border-gray-200 hover:border-purple-700/30 shadow-sm hover:shadow-md transition-all duration-200" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        <span>Retour aux articles</span>
      <% end %>

      <div class="flex items-center gap-2 text-sm text-gray-500">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span>Lecture : ~<%= (@article.content.to_s.split.size / 200.0).ceil %> min</span>
      </div>
    </div>
  </div>
</section>

