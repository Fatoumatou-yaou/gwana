<% content_for :title, t("navigation.articles") %>

<div class="max-w-7xl mx-auto">
  <h1 class="text-4xl font-bold mb-8 text-[#D4AF37]"><%= t("navigation.articles") %></h1>

  <!-- Search and Filters -->
  <div class="bg-[#0B0B0B] rounded-lg p-6 mb-8 border border-[#6A0DAD]/20">
    <%= form_with url: articles_path, method: :get, local: true, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="md:col-span-2">
          <%= f.text_field :search, placeholder: t("articles.search_placeholder"), value: params[:search], class: "w-full px-4 py-2 bg-[#111111] border border-[#6A0DAD]/20 rounded-lg text-white focus:outline-none focus:border-[#6A0DAD]" %>
        </div>
        <div>
          <%= f.select :category, options_for_select([["Toutes les catégories", ""]] + Article.distinct.pluck(:category).compact.map { |c| [c, c] }, params[:category]), {}, { class: "w-full px-4 py-2 bg-[#111111] border border-[#6A0DAD]/20 rounded-lg text-white focus:outline-none focus:border-[#6A0DAD]" } %>
        </div>
        <div>
          <%= f.submit t("articles.search"), class: "w-full bg-[#6A0DAD] hover:bg-[#5B21B6] text-white px-4 py-2 rounded-lg transition-colors" %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Articles Grid -->
  <% if @articles.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @articles.each do |article| %>
        <article class="bg-[#0B0B0B] rounded-lg overflow-hidden border border-[#6A0DAD]/20 hover:border-[#6A0DAD]/40 transition-all">
          <% if article.featured_image.attached? %>
            <%= image_tag article.featured_image, alt: article.title, class: "w-full h-48 object-cover" %>
          <% end %>
          <div class="p-6">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs text-[#D4AF37] bg-[#6A0DAD]/20 px-2 py-1 rounded-full"><%= article.category %></span>
              <time datetime="<%= article.published_at.iso8601 %>" class="text-xs text-gray-500">
                <%= l(article.published_at, format: :short) if article.published_at %>
              </time>
            </div>
            <h3 class="text-xl font-semibold mb-2">
              <%= link_to article.title, article_path(article), class: "hover:text-[#D4AF37] transition-colors" %>
            </h3>
            <p class="text-gray-400 text-sm mb-4 line-clamp-3">
              <%= truncate(strip_tags(article.content.to_s), length: 150) %>
            </p>
            <% if article.tags.present? %>
              <div class="flex flex-wrap gap-2">
                <% article.tags_array.first(3).each do |tag| %>
                  <span class="text-xs text-gray-500">#<%= tag %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12 text-gray-400">
      <p><%= t("articles.no_results") %></p>
    </div>
  <% end %>
</div>
