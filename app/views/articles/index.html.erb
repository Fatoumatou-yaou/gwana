<% content_for :title, "Actualités" %>

<section class="min-h-screen bg-gradient-to-b from-white via-gray-50 to-white py-8 md:py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header Section -->
    <div class="text-center mb-12">
      <h1 class="text-5xl md:text-6xl font-bold mb-4 bg-gradient-to-r from-purple-700 via-amber-500 to-purple-700 bg-clip-text text-transparent">
        Actualités
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Découvrez les dernières nouvelles, témoignages et événements de notre communauté
      </p>
    </div>

    <!-- Search and Filters - Design Moderne -->
    <div class="bg-white rounded-2xl shadow-xl p-6 md:p-8 mb-12 border border-gray-100">
      <%= form_with url: articles_path, method: :get, local: true, class: "space-y-4" do |f| %>
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
          <!-- Search Input -->
          <div class="md:col-span-7">
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
              </div>
              <%= f.text_field :search, 
                  placeholder: "Rechercher un article...", 
                  value: params[:search], 
                  class: "w-full pl-12 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-700/20 focus:border-purple-700 transition-all" 
              %>
            </div>
          </div>
          
          <!-- Category Select -->
          <div class="md:col-span-4">
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                </svg>
              </div>
              <%= f.select :category, 
                  options_for_select([["Toutes les catégories", ""]] + Article.distinct.pluck(:category).compact.map { |c| [c, c] }, params[:category]), 
                  {}, 
                  { class: "w-full pl-12 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-purple-700/20 focus:border-purple-700 appearance-none cursor-pointer transition-all" 
              } %>
              <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </div>
            </div>
          </div>
          
          <!-- Submit Button -->
          <div class="md:col-span-1">
            <%= f.submit "Rechercher", class: "w-full h-full bg-gradient-to-r from-purple-700 to-purple-800 hover:from-purple-800 hover:to-purple-700 text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-0.5" %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Articles Grid - Design Moderne -->
    <% if @articles.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        <% @articles.each do |article| %>
          <article class="group bg-white rounded-2xl overflow-hidden border border-gray-200 hover:border-purple-700/40 shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
            <!-- Image Container -->
            <div class="relative h-56 overflow-hidden bg-gradient-to-br from-purple-700/10 to-amber-500/10">
              <% if article.photo.attached? %>
                <%= image_tag article.photo, 
                    alt: article.title, 
                    class: "w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" 
                %>
              <% elsif article.video.attached? %>
                <video class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" muted>
                  <source src="<%= url_for(article.video) %>" type="<%= article.video.content_type %>">
                </video>
              <% else %>
                <div class="w-full h-full flex items-center justify-center">
                  <svg class="w-20 h-20 text-purple-700/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                  </svg>
                </div>
              <% end %>
              
              <!-- Gradient Overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              
              <!-- Category Badge -->
              <div class="absolute top-4 left-4">
                <span class="px-3 py-1.5 bg-purple-700/90 backdrop-blur-sm text-white text-xs font-semibold rounded-full border border-white/20 shadow-lg">
                  <%= article.category %>
                </span>
              </div>
              
              <!-- Date Badge -->
              <% if article.published_at %>
                <div class="absolute top-4 right-4">
                  <time datetime="<%= article.published_at.iso8601 %>" class="px-3 py-1.5 bg-white/90 backdrop-blur-sm text-gray-700 text-xs font-medium rounded-full shadow-lg flex items-center gap-1">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    <%= l(article.published_at, format: :short) %>
                  </time>
                </div>
              <% end %>
            </div>
            
            <!-- Content -->
            <div class="p-6">
              <h3 class="text-xl font-bold mb-3 text-gray-900 group-hover:text-purple-700 transition-colors duration-300 line-clamp-2">
                <%= link_to article.title, article_path(article), class: "hover:underline" %>
              </h3>
              
              <p class="text-gray-600 text-sm mb-4 line-clamp-3 leading-relaxed">
                <%= truncate(strip_tags(article.content.to_s), length: 120) %>
              </p>
              
              <!-- Tags -->
              <% if article.tags.present? %>
                <div class="flex flex-wrap gap-2 mb-4">
                  <% article.tags_array.first(3).each do |tag| %>
                    <span class="px-2.5 py-1 bg-gray-100 text-purple-700 text-xs font-medium rounded-full border border-gray-200 hover:bg-purple-700/10 hover:border-purple-700/30 transition-colors">
                      #<%= tag %>
                    </span>
                  <% end %>
                </div>
              <% end %>
              
              <!-- Read More Link -->
              <div class="flex items-center gap-2 text-purple-700 font-semibold text-sm group-hover:gap-3 transition-all duration-300">
                <%= link_to "Lire la suite", article_path(article), class: "flex items-center gap-2" %>
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </div>
            </div>
            
            <!-- Shine Effect on Hover -->
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-1000 pointer-events-none"></div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16">
        <div class="max-w-md mx-auto">
          <svg class="w-24 h-24 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <h3 class="text-xl font-semibold text-gray-700 mb-2">Aucun article trouvé</h3>
          <p class="text-gray-500">Essayez de modifier vos critères de recherche</p>
        </div>
      </div>
    <% end %>
  </div>
</section>
