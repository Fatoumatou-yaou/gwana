<% content_for :title, "Détails de la demande" %>

<div class="max-w-4xl mx-auto">
  <div class="mb-6">
    <%= link_to "← Retour", mentorship_requests_path, class: "text-purple-700 hover:text-purple-600 transition-colors" %>
  </div>

  <h1 class="text-4xl font-bold mb-8 text-gray-900">Détails de la demande</h1>

  <div class="bg-white rounded-lg p-8 border border-gray-200 shadow-sm space-y-6">
    <!-- En-tête -->
    <div class="flex justify-between items-start border-b border-gray-200 pb-4">
      <div>
        <h2 class="text-2xl font-semibold text-purple-700 mb-2">
          <% if current_user.user? %>
            Mentor : <%= @mentorship_request.mentor.gwana_profile&.full_name || @mentorship_request.mentor.email %>
          <% else %>
            Demandeur : <%= @mentorship_request.requester.full_name || @mentorship_request.requester.email %>
          <% end %>
        </h2>
        <span class="px-4 py-2 rounded-full text-sm font-semibold <%= 
          @mentorship_request.pending? ? 'bg-yellow-100 text-yellow-800' : 
          @mentorship_request.accepted? ? 'bg-green-100 text-green-800' : 
          @mentorship_request.rejected? ? 'bg-red-100 text-red-800' : 
          'bg-gray-100 text-gray-800' 
        %>">
          <%= @mentorship_request.status.humanize %>
        </span>
      </div>
      <p class="text-sm text-gray-500">Créée le <%= l(@mentorship_request.created_at, format: :long) %></p>
    </div>

    <!-- Informations du demandeur -->
    <% if current_user.gwana? %>
      <div class="bg-gray-50 rounded-lg p-6">
        <h3 class="text-lg font-semibold mb-4 text-purple-700">Informations du demandeur</h3>
        <div class="grid grid-cols-2 gap-4 text-sm">
          <div>
            <span class="font-semibold text-gray-700">Nom complet :</span>
            <span class="text-gray-600 ml-2"><%= @mentorship_request.requester.full_name %></span>
          </div>
          <div>
            <span class="font-semibold text-gray-700">Email :</span>
            <span class="text-gray-600 ml-2"><%= @mentorship_request.requester.email %></span>
          </div>
          <% if @mentorship_request.requester.gender.present? %>
            <div>
              <span class="font-semibold text-gray-700">Genre :</span>
              <span class="text-gray-600 ml-2"><%= @mentorship_request.requester.gender.humanize %></span>
            </div>
          <% end %>
          <% if @mentorship_request.requester.date_of_birth.present? %>
            <div>
              <span class="font-semibold text-gray-700">Date de naissance :</span>
              <span class="text-gray-600 ml-2"><%= l(@mentorship_request.requester.date_of_birth, format: :long) %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Informations académiques -->
    <div>
      <h3 class="text-lg font-semibold mb-4 text-purple-700">Informations académiques</h3>
      <div class="grid grid-cols-2 gap-4">
        <% if @mentorship_request.niveau_etudes.present? %>
          <div>
            <span class="font-semibold text-gray-700">Niveau d'études :</span>
            <span class="text-gray-600 ml-2"><%= @mentorship_request.niveau_etudes.humanize %></span>
          </div>
        <% end %>
        <% if @mentorship_request.filiere.present? %>
          <div>
            <span class="font-semibold text-gray-700">Filière :</span>
            <span class="text-gray-600 ml-2"><%= @mentorship_request.filiere %></span>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Localisation -->
    <% if @mentorship_request.commune.present? %>
      <div>
        <h3 class="text-lg font-semibold mb-4 text-purple-700">Localisation</h3>
        <p class="text-gray-600">
          <%= @mentorship_request.commune.name %>, 
          <%= @mentorship_request.commune.department.name %>, 
          <%= @mentorship_request.commune.region.name %>
        </p>
      </div>
    <% end %>

    <!-- Motivation -->
    <div>
      <h3 class="text-lg font-semibold mb-4 text-purple-700">Motivation</h3>
      <div class="bg-gray-50 rounded-lg p-6">
        <p class="text-gray-700 whitespace-pre-wrap"><%= @mentorship_request.motivation %></p>
      </div>
    </div>

    <!-- Objectifs -->
    <div>
      <h3 class="text-lg font-semibold mb-4 text-purple-700">Objectifs</h3>
      <div class="bg-gray-50 rounded-lg p-6">
        <p class="text-gray-700 whitespace-pre-wrap"><%= @mentorship_request.objectives %></p>
      </div>
    </div>

    <!-- Message -->
    <div>
      <h3 class="text-lg font-semibold mb-4 text-purple-700">Message</h3>
      <div class="bg-gray-50 rounded-lg p-6">
        <p class="text-gray-700 whitespace-pre-wrap"><%= @mentorship_request.message %></p>
      </div>
    </div>
    <!-- Actions pour gwana -->
    <% if current_user.gwana? && @mentorship_request.pending? %>
      <div class="flex gap-4 pt-4 border-t border-gray-200">
        <%= link_to "Accepter", accept_mentorship_request_path(@mentorship_request), method: :patch, 
            class: "px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors font-semibold",
            data: { confirm: "Êtes-vous sûr de vouloir accepter cette demande ?" } %>
        <%= link_to "Refuser", reject_mentorship_request_path(@mentorship_request), method: :patch,
            class: "px-6 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors font-semibold",
            data: { confirm: "Êtes-vous sûr de vouloir refuser cette demande ?" } %>
      </div>
    <% end %>
  </div>
</div>
