<% content_for :title, "Nouvelle demande de mentorat" %>

<div class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-8 text-purple-600">Nouvelle demande de mentorat</h1>

  <%= form_with model: @mentorship_request, url: mentorship_requests_path, class: "space-y-6" do |f| %>
    <%= render "shared/error_messages", resource: @mentorship_request %>

    <!-- Sélection de la gwana -->
    <div class="bg-white rounded-lg p-6 border border-gray-200 shadow-sm">
      <h2 class="text-xl font-semibold mb-4 text-purple-700">Choisir votre mentor</h2>
      <% mentor_pre_selected = params[:mentor_id].present? && f.object.mentor_id.present? %>
      <% if mentor_pre_selected %>
        <% selected_mentor = @gwanas.find { |u| u.id == f.object.mentor_id.to_i } %>
        <% if selected_mentor %>
          <div class="mb-4 p-4 bg-purple-50 border border-purple-200 rounded-lg">
            <p class="text-sm text-gray-600 mb-2">Mentor sélectionné :</p>
            <p class="text-lg font-semibold text-purple-700">
              <%= selected_mentor.gwana_profile.first_name %> <%= selected_mentor.gwana_profile.last_name %> - <%= selected_mentor.gwana_profile.profession %>
            </p>
            <p class="mt-2 text-xs text-gray-500">Le mentor a été pré-sélectionné depuis la page du profil. Vous pouvez le modifier ci-dessous si nécessaire.</p>
          </div>
        <% end %>
      <% end %>
      <div class="group relative" data-controller="custom-select">
        <%= f.label :mentor_id, "Gwana", class: 'block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-purple-700 transition-colors duration-200' %>
        <%= f.hidden_field :mentor_id, value: f.object.mentor_id, data: { custom_select_target: "input" }, required: true %>
        <button
          type="button"
          data-custom-select-target="button"
          data-action="click->custom-select#toggle"
          data-placeholder="Sélectionnez une gwana"
          class="<%= field_error_class(@mentorship_request, :mentor_id, "w-full px-4 py-3 pr-10 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-purple-700 focus:border-transparent transition-all text-left flex items-center justify-between") %>"
        >
          <span>
            <% if f.object.mentor_id.present? %>
              <% selected_mentor = @gwanas.find { |u| u.id == f.object.mentor_id.to_i } %>
              <%= selected_mentor ? "#{selected_mentor.gwana_profile.first_name} #{selected_mentor.gwana_profile.last_name} - #{selected_mentor.gwana_profile.profession}" : "Sélectionnez une gwana" %>
            <% else %>
              Sélectionnez une gwana
            <% end %>
          </span>
          <svg class="w-5 h-5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div 
          data-custom-select-target="menu"
          class="hidden absolute z-50 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-xl max-h-60 overflow-y-auto"
        >
          <% @gwanas.each do |gwana| %>
            <button
              type="button"
              data-action="click->custom-select#selectOption"
              data-value="<%= gwana.id %>"
              class="w-full px-4 py-3 text-left text-gray-900 hover:bg-purple-50 transition-colors <%= 'bg-purple-50 font-semibold' if f.object.mentor_id.to_i == gwana.id %>"
            >
              <%= gwana.gwana_profile.first_name %> <%= gwana.gwana_profile.last_name %> - <%= gwana.gwana_profile.profession %>
            </button>
          <% end %>
        </div>
        <%= field_error_message(@mentorship_request, :mentor_id) %>
      </div>
    </div>

    <!-- Localisation -->
    <div class="bg-white rounded-lg p-6 border border-gray-200 shadow-sm">
      <h2 class="text-xl font-semibold mb-4 text-purple-700">Votre localisation</h2>
      <div data-controller="location-cascade" class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Région -->
        <div class="relative" data-controller="custom-select">
          <label for="region_id" class="block text-sm font-semibold text-gray-700 mb-2">Région</label>
          <%= hidden_field_tag "region_id", @region_id || params[:region_id], data: { custom_select_target: "input", location_cascade_target: "region" } %>
          <button
            type="button"
            data-custom-select-target="button"
            data-action="click->custom-select#toggle"
            data-placeholder="Sélectionnez une région"
            class="w-full px-4 py-3 pr-10 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-purple-700 focus:border-transparent transition-all text-left flex items-center justify-between"
          >
            <span>
              <% region_id = @region_id || params[:region_id] %>
              <% if region_id.present? %>
                <%= @regions.find { |r| r.id == region_id.to_i }&.name || "Sélectionnez une région" %>
              <% else %>
                Sélectionnez une région
              <% end %>
            </span>
            <svg class="w-5 h-5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div 
            data-custom-select-target="menu"
            class="hidden absolute z-50 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-xl max-h-60 overflow-y-auto"
          >
            <button
              type="button"
              data-action="click->custom-select#selectOption"
              data-value=""
              class="w-full px-4 py-3 text-left text-gray-900 hover:bg-purple-50 transition-colors <%= 'bg-purple-50 font-semibold' if (@region_id || params[:region_id]).blank? %>"
            >
              Sélectionnez une région
            </button>
            <% @regions.each do |region| %>
              <button
                type="button"
                data-action="click->custom-select#selectOption"
                data-value="<%= region.id %>"
                class="w-full px-4 py-3 text-left text-gray-900 hover:bg-purple-50 transition-colors <%= 'bg-purple-50 font-semibold' if (@region_id || params[:region_id]).to_i == region.id %>"
              >
                <%= region.name %>
              </button>
            <% end %>
          </div>
        </div>

        <!-- Département -->
        <div class="relative" data-controller="custom-select">
          <label for="department_id" class="block text-sm font-semibold text-gray-700 mb-2">Département</label>
          <%= hidden_field_tag "department_id", @department_id || params[:department_id], data: { custom_select_target: "input", location_cascade_target: "department" } %>
          <button
            type="button"
            data-custom-select-target="button"
            data-action="click->custom-select#toggle"
            data-placeholder="Sélectionnez un département"
            class="w-full px-4 py-3 pr-10 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-purple-700 focus:border-transparent transition-all text-left flex items-center justify-between"
          >
            <span>Sélectionnez un département</span>
            <svg class="w-5 h-5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div 
            data-custom-select-target="menu"
            class="hidden absolute z-50 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-xl max-h-60 overflow-y-auto"
          >
            <!-- Les options seront ajoutées dynamiquement par location-cascade -->
          </div>
        </div>

        <!-- Commune -->
        <div class="relative" data-controller="custom-select">
          <%= f.label :commune_id, "Commune", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.hidden_field :commune_id, value: f.object.commune_id, data: { custom_select_target: "input", location_cascade_target: "commune" } %>
          <button
            type="button"
            data-custom-select-target="button"
            data-action="click->custom-select#toggle"
            data-placeholder="Sélectionnez une commune"
            class="<%= field_error_class(@mentorship_request, :commune_id, "w-full px-4 py-3 pr-10 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-purple-700 focus:border-transparent transition-all text-left flex items-center justify-between") %>"
          >
            <span>Sélectionnez une commune</span>
            <svg class="w-5 h-5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div 
            data-custom-select-target="menu"
            class="hidden absolute z-50 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-xl max-h-60 overflow-y-auto"
          >
            <!-- Les options seront ajoutées dynamiquement par location-cascade -->
          </div>
          <%= field_error_message(@mentorship_request, :commune_id) %>
        </div>
      </div>
    </div>

    <!-- Informations académiques -->
    <div class="bg-white rounded-lg p-6 border border-gray-200 shadow-sm">
      <h2 class="text-xl font-semibold mb-4 text-purple-700">Informations académiques</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="group">
          <%= f.label :niveau_etudes, "Niveau d'études", class: 'block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-purple-700 transition-colors duration-200' %>
          <%= f.select :niveau_etudes, 
              options_for_select([
                ["Collège", "college"],
                ["BEPC", "bepc"],
                ["Lycée", "lycee"],
                ["Baccalauréat", "bac"],
                ["Bac +1", "bac_plus_1"],
                ["Bac +2", "bac_plus_2"],
                ["Bac +3 (Licence)", "bac_plus_3"],
                ["Bac +4", "bac_plus_4"],
                ["Bac +5 (Master)", "bac_plus_5"]
              ], f.object.niveau_etudes),
              { prompt: "Sélectionnez votre niveau" },
              { required: true, 
                class: field_error_class(@mentorship_request, :niveau_etudes, "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-700 focus:border-transparent outline-none transition-all") } %>
          <%= field_error_message(@mentorship_request, :niveau_etudes) %>
        </div>

        <div class="group">
          <%= f.label :filiere, "Filière", class: 'block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-purple-700 transition-colors duration-200' %>
          <%= f.text_field :filiere,
              class: field_error_class(@mentorship_request, :filiere, "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-700 focus:border-transparent outline-none transition-all"),
              placeholder: "Ex: Informatique, Commerce, Droit..." %>
          <%= field_error_message(@mentorship_request, :filiere) %>
        </div>
      </div>
    </div>

    <!-- Motivation -->
    <div class="bg-white rounded-lg p-6 border border-gray-200 shadow-sm">
      <h2 class="text-xl font-semibold mb-4 text-purple-700">Votre motivation</h2>
      <div class="group">
        <%= f.label :motivation, "Pourquoi souhaitez-vous être mentoré(e) par cette gwana ?", class: 'block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-purple-700 transition-colors duration-200' %>
        <p class="text-xs text-gray-500 mb-2">Décrivez vos motivations, vos objectifs et ce que vous attendez de ce mentorat (minimum 20 caractères)</p>
        <%= f.text_area :motivation, required: true, rows: 8,
            class: field_error_class(@mentorship_request, :motivation, "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-700 focus:border-transparent outline-none transition-all"),
            placeholder: "Expliquez pourquoi vous souhaitez être mentoré(e) par cette gwana, vos objectifs professionnels, vos attentes..." %>
        <%= field_error_message(@mentorship_request, :motivation) %>
      </div>
    </div>

    <!-- Objectifs -->
    <div class="bg-white rounded-lg p-6 border border-gray-200 shadow-sm">
      <h2 class="text-xl font-semibold mb-4 text-purple-700">Vos objectifs</h2>
      <div class="group">
        <%= f.label :objectives, "Objectifs", class: 'block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-purple-700 transition-colors duration-200' %>
        <%= f.text_area :objectives, required: true, rows: 8,
            class: field_error_class(@mentorship_request, :objectives, "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-700 focus:border-transparent outline-none transition-all"),
            placeholder: "Décrivez vos objectifs professionnels, vos attentes..." %>
        <%= field_error_message(@mentorship_request, :objectives) %>
      </div>
    </div>

    <!-- Message -->
    <div class="bg-white rounded-lg p-6 border border-gray-200 shadow-sm">
      <h2 class="text-xl font-semibold mb-4 text-purple-700">Votre message</h2>
      <div class="group">
        <%= f.label :message, "Message", class: 'block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-purple-700 transition-colors duration-200' %>
        <%= f.text_area :message, required: true, rows: 8,
            class: field_error_class(@mentorship_request, :message, "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-700 focus:border-transparent outline-none transition-all"),
            placeholder: "Décrivez votre message à la gwana..." %>
        <%= field_error_message(@mentorship_request, :message) %>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex justify-end gap-4">
      <%= link_to "Annuler", dashboard_path, class: "px-6 py-3 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors" %>
      <%= f.submit "Envoyer la demande", class: "px-6 py-3 bg-purple-600 text-white rounded-lg hover:from-purple-800 hover:to-purple-700 transition-all font-semibold cursor-pointer" %>
    </div>
  <% end %>
</div>
