    <%# Footer %>
    <footer class="bg-gray-900 border-t border-purple-700/20 mt-auto" role="contentinfo">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h3 class="text-amber-500 font-bold mb-4">GWANA</h3>
            <p class="text-gray-400 text-sm"><%= t("footer.description") %></p>
          </div>
          <div>
            <h4 class="text-white font-semibold mb-4"><%= t("footer.links") %></h4>
            <ul class="space-y-2">
              <li><%= link_to "Annuaire", gwanas_path, class: "text-gray-400 hover:text-amber-500 transition-colors text-sm" %></li>
              <li><%= link_to "Actualités", articles_path, class: "text-gray-400 hover:text-amber-500 transition-colors text-sm" %></li>
            </ul>
          </div>
          <div>
            <h4 class="text-white font-semibold mb-4"><%= t("footer.contact") %></h4>
            <p class="text-gray-400 text-sm"><%= t("footer.email") %></p>
          </div>
        </div>
        <div class="mt-8 pt-8 border-t border-purple-700/20 text-center text-gray-400 text-sm">
          <p>&copy; <%= Date.current.year %> GWANA. <%= t("footer.rights") %></p>
        </div>
      </div>
    </footer>