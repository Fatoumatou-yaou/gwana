<%# Footer %>
<footer class="bg-white border-t border-gray-200 mt-auto" role="contentinfo">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Logo et description -->
      <div>
        <%= link_to root_path, class: "inline-block mb-4 hover:opacity-80 transition-opacity" do %>
          <h1 class="text-4xl font-bold text-purple-600 drop-shadow-lg">
            gwana
          </h1>
        <% end %>
        <p class="text-gray-600 text-sm">
          Plateforme de valorisation de femmes pionnières expertes.
        </p>
      </div>
      
      <!-- Liens -->
      <div>
        <h4 class="text-gray-900 font-semibold mb-4">Liens rapides</h4>
        <ul class="grid grid-cols-2 gap-2">
          <li>
            <%= link_to gwanas_path, class: "text-gray-600 hover:text-purple-600 transition-colors text-sm inline-flex items-center gap-2" do %>
              Annuaire
            <% end %>
          </li>
          <li>
            <%= link_to articles_path, class: "text-gray-600 hover:text-purple-600 transition-colors text-sm inline-flex items-center gap-2" do %>
              Actualités
            <% end %>
          </li>
          <li>
            <%= link_to new_gwana_network_request_path, class: "text-gray-600 hover:text-purple-600 transition-colors text-sm inline-flex items-center gap-2" do %>
              Rejoindre le réseau
            <% end %>
          </li>
          <li>
            <%= link_to mentorship_request_path_for_user, class: "text-gray-600 hover:text-purple-600 transition-colors text-sm inline-flex items-center gap-2" do %>
              Demander un mentorat
            <% end %>
          </li>
        </ul>
      </div>
      
      <!-- Contact -->
      <div>
        <h4 class="text-gray-900 font-semibold mb-4">Contact</h4>
        <p class="text-gray-600 text-sm mb-2">
          <div class="transition-colors inline-flex items-center gap-2">
            <span class="material-symbols-outlined bg-purple-200 rounded-md p-1 text-base" style="font-size: 16px;">location_on</span>
            Immeuble BIN, Niamey, Niger
          </div>
        </p>
        <p class="text-gray-600 text-sm mb-2">
          <a href="mailto:contact@gwana.org" class="transition-colors inline-flex items-center gap-2">
            <span class="material-symbols-outlined bg-purple-200 rounded-md p-1 text-base" style="font-size: 16px;">email</span>
            contact@gwana.org
          </a>
        </p>
        <p class="text-gray-600 text-sm mb-2">
          <a href="tel:+22793000000" class="transition-colors inline-flex items-center gap-2">
            <span class="material-symbols-outlined bg-purple-200 rounded-md p-1 text-base" style="font-size: 16px;">phone</span>
            +227 93 00 00 00
          </a>
        </p>
      </div>
    </div>
    
    <!-- Copyright -->
    <div class="mt-12 pt-8 border-t border-gray-200 text-center">
      <p class="text-gray-500 text-sm">
        &copy; 2025 gwana. Tous droits réservés.
      </p>
    </div>
  </div>
</footer>