<%# Footer %>
<footer class="bg-white border-t border-gray-200 mt-auto" role="contentinfo">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Logo et description -->
      <div>
        <%= link_to root_path, class: "inline-block mb-4 hover:opacity-80 transition-opacity" do %>
          <h1 class="text-4xl font-bold text-purple-800 drop-shadow-lg">
            gwana
          </h1>
        <% end %>
      </div>
      
      <!-- Liens -->
      <div>
        <h4 class="text-gray-900 font-semibold mb-4">Liens rapides</h4>
        <ul class="grid grid-cols-2 gap-2">
          <li>
            <%= link_to gwanas_path, class: "text-gray-600 hover:text-purple-800 transition-colors text-sm inline-flex items-center gap-2" do %>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
              </svg>
              Annuaire
            <% end %>
          </li>
          <li>
            <%= link_to articles_path, class: "text-gray-600 hover:text-purple-800 transition-colors text-sm inline-flex items-center gap-2" do %>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
              </svg>
              Actualités
            <% end %>
          </li>
          <li>
            <%= link_to new_gwana_network_request_path, class: "text-gray-600 hover:text-purple-800 transition-colors text-sm inline-flex items-center gap-2" do %>
              <span class="material-symbols-outlined text-base">group_add</span>
              Rejoindre le réseau
            <% end %>
          </li>
          <li>
            <%= link_to mentorship_request_path_for_user, class: "text-gray-600 hover:text-purple-800 transition-colors text-sm inline-flex items-center gap-2" do %>
              <span class="material-symbols-outlined text-base">school</span>
              Demander un mentorat
            <% end %>
          </li>
        </ul>
      </div>
      
      <!-- Contact -->
      <div>
        <h4 class="text-gray-900 font-semibold mb-4">Contact</h4>
        <p class="text-gray-600 text-sm mb-2">
          <a href="mailto:contact@gwana.org" class="hover:text-purple-800 transition-colors inline-flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            contact@gwana.org
          </a>
        </p>
      </div>
    </div>
    
    <!-- Copyright -->
    <div class="mt-12 pt-8 border-t border-gray-200 text-center">
      <p class="text-gray-500 text-sm">
        &copy; <%= Date.current.year %> gwana. Tous droits réservés.
      </p>
    </div>
  </div>
</footer>