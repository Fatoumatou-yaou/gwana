<div class="flex">
  <aside class="w-64 fixed inset-y-0 left-0 z-50 bg-white shadow-sm transition-all duration-300 ease-in-out transform border-r border-gray-200 flex flex-col">
    <!-- Logo Section - Style page de connexion -->
    <div class="flex-shrink-0 flex items-center justify-center py-6 border-b border-gray-200 bg-gradient-to-br from-white to-gray-50">
      <%= link_to current_user&.admin? ? admin_dashboard_path : dashboard_path, class: "group" do %>
        <h1 class="text-4xl font-bold bg-gradient-to-r from-purple-700 to-purple-800 bg-clip-text text-transparent drop-shadow-lg transition-transform duration-200 group-hover:scale-105">
          gwana
        </h1>
      <% end %>
    </div>

    <!-- User Info Section -->
    <% if current_user %>
      <% user = decorated_current_user %>
      <div class="flex-shrink-0 px-6 py-4 border-b border-gray-200">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-gradient-to-br from-purple-700 to-purple-800 rounded-full flex items-center justify-center">
            <span class="text-white font-semibold text-sm"><%= user.full_name&.first&.upcase || 'U' %></span>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-gray-800 font-medium text-sm truncate"><%= user.full_name %></p>
            <p class="text-gray-500 text-xs truncate"><%= user.profile.capitalize %></p>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Navigation Menu -->
    <nav class="flex-1 overflow-y-auto px-4 py-6">
      <div class="space-y-2">
        <% if current_user && policy(current_user).admin_dashboard? %>
          <!-- Menu Admin -->
          <!-- Dashboard -->
          <%= link_to admin_dashboard_path, class: "flex items-center px-4 py-3 text-gray-700 rounded-xl hover:bg-gradient-to-r hover:from-purple-700/10 hover:to-purple-800/10 hover:text-purple-700 transition-all duration-200 group relative overflow-hidden" do %>
            <div class="absolute inset-0 bg-gradient-to-r from-purple-700/10 to-purple-800/10 opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
            <svg class="w-5 h-5 text-gray-500 group-hover:text-purple-700 transition-colors duration-200 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
            <span class="ml-3 font-medium relative z-10">Dashboard</span>
          <% end %>
          <!-- Les GWANA -->
          <%= link_to admin_gwanas_path, class: "flex items-center px-4 py-3 text-gray-700 rounded-xl hover:bg-gradient-to-r hover:from-purple-700/10 hover:to-purple-800/10 hover:text-purple-700 transition-all duration-200 group relative overflow-hidden" do %>
            <div class="absolute inset-0 bg-gradient-to-r from-purple-700/10 to-purple-800/10 opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
            <svg class="w-5 h-5 text-gray-500 group-hover:text-purple-700 transition-colors duration-200 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
            <span class="ml-3 font-medium relative z-10">Les GWANA</span>
          <% end %>

          <!-- Gestion des utilisateurs -->
          <%= link_to admin_users_path, class: "flex items-center px-4 py-3 text-gray-700 rounded-xl hover:bg-gradient-to-r hover:from-purple-700/10 hover:to-purple-800/10 hover:text-purple-700 transition-all duration-200 group relative overflow-hidden" do %>
            <div class="absolute inset-0 bg-gradient-to-r from-purple-700/10 to-purple-800/10 opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
            <svg class="w-5 h-5 text-gray-500 group-hover:text-purple-700 transition-colors duration-200 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
            <span class="ml-3 font-medium relative z-10">Utilisateurs</span>
          <% end %>

          <!-- Tous les mentorats -->
          <%= link_to admin_mentorship_requests_path, class: "flex items-center px-4 py-3 text-gray-700 rounded-xl hover:bg-gradient-to-r hover:from-purple-700/10 hover:to-purple-800/10 hover:text-purple-700 transition-all duration-200 group relative overflow-hidden" do %>
            <div class="absolute inset-0 bg-gradient-to-r from-purple-700/10 to-purple-800/10 opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
            <svg class="w-5 h-5 text-gray-500 group-hover:text-purple-700 transition-colors duration-200 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            <span class="ml-3 font-medium relative z-10">Tous les mentorats</span>
          <% end %>

          <!-- Gestion des actualités -->
          <%= link_to admin_articles_path, class: "flex items-center px-4 py-3 text-gray-700 rounded-xl hover:bg-gradient-to-r hover:from-purple-700/10 hover:to-purple-800/10 hover:text-purple-700 transition-all duration-200 group relative overflow-hidden" do %>
            <div class="absolute inset-0 bg-gradient-to-r from-purple-700/10 to-purple-800/10 opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
            <svg class="w-5 h-5 text-gray-500 group-hover:text-purple-700 transition-colors duration-200 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
            </svg>
            <span class="ml-3 font-medium relative z-10">Gestion des actualités</span>
          <% end %>
        <% else %>
          <!-- Menu User/Gwana -->
          <% if current_user %>
            <!-- Mon profil -->
            <% if policy(current_user).profile? %>
            <%= link_to profile_path, class: "flex items-center px-4 py-3 text-gray-700 rounded-xl hover:bg-gradient-to-r hover:from-purple-700/10 hover:to-purple-800/10 hover:text-purple-700 transition-all duration-200 group relative overflow-hidden" do %>
              <div class="absolute inset-0 bg-gradient-to-r from-purple-700/10 to-purple-800/10 opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
              <svg class="w-5 h-5 text-gray-500 group-hover:text-purple-700 transition-colors duration-200 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                <span class="ml-3 font-medium relative z-10">Mon profil</span>
              <% end %>
            <% end %>

            <!-- Mes demandes de mentorat (pour les users qui font des demandes) -->
            <% if policy(current_user).mentorship_requests? %>
              <%= link_to mentorship_requests_path, class: "flex items-center px-4 py-3 text-gray-700 rounded-xl hover:bg-gradient-to-r hover:from-purple-700/10 hover:to-purple-800/10 hover:text-purple-700 transition-all duration-200 group relative overflow-hidden" do %>
                <div class="absolute inset-0 bg-gradient-to-r from-purple-700/10 to-purple-800/10 opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
                <svg class="w-5 h-5 text-gray-500 group-hover:text-purple-700 transition-colors duration-200 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                <span class="ml-3 font-medium relative z-10">Mes demandes de mentorat</span>
              <% end %>
            <% end %>

            <!-- Mes mentorats (pour les gwanas qui reçoivent des demandes) -->
            <% if policy(current_user).mentor_requests? %>
              <%= link_to mentorship_requests_path, class: "flex items-center px-4 py-3 text-gray-700 rounded-xl hover:bg-gradient-to-r hover:from-purple-700/10 hover:to-purple-800/10 hover:text-purple-700 transition-all duration-200 group relative overflow-hidden" do %>
                <div class="absolute inset-0 bg-gradient-to-r from-purple-700/10 to-purple-800/10 opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
                <svg class="w-5 h-5 text-gray-500 group-hover:text-purple-700 transition-colors duration-200 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
                <span class="ml-3 font-medium relative z-10">Mes mentorats</span>
              <% end %>
            <% end %>
          <% end %>

          <!-- Membres (seulement pour gwanas et admins) -->
          <% if current_user && policy(current_user).members? %>
            <%= link_to gwanas_path, class: "flex items-center px-4 py-3 text-gray-700 rounded-xl hover:bg-gradient-to-r hover:from-purple-700/10 hover:to-purple-800/10 hover:text-purple-700 transition-all duration-200 group relative overflow-hidden" do %>
              <div class="absolute inset-0 bg-gradient-to-r from-purple-700/10 to-purple-800/10 opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
              <svg class="w-5 h-5 text-gray-500 group-hover:text-purple-700 transition-colors duration-200 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
              </svg>
              <span class="ml-3 font-medium relative z-10">Membres</span>
            <% end %>
          <% end %>

          <!-- Actualités -->
          <% if current_user && policy(current_user).articles? %>
            <%= link_to articles_path, class: "flex items-center px-4 py-3 text-gray-700 rounded-xl hover:bg-gradient-to-r hover:from-purple-700/10 hover:to-purple-800/10 hover:text-purple-700 transition-all duration-200 group relative overflow-hidden" do %>
              <div class="absolute inset-0 bg-gradient-to-r from-purple-700/10 to-purple-800/10 opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
              <svg class="w-5 h-5 text-gray-500 group-hover:text-purple-700 transition-colors duration-200 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
              </svg>
              <span class="ml-3 font-medium relative z-10">Actualités</span>
            <% end %>
          <% end %>
        <% end %>

        <!-- Accueil (commun à tous) -->
        <%= link_to root_path, class: "flex items-center px-4 py-3 text-gray-700 rounded-xl hover:bg-gradient-to-r hover:from-purple-700/10 hover:to-purple-800/10 hover:text-purple-700 transition-all duration-200 group relative overflow-hidden" do %>
          <div class="absolute inset-0 bg-gradient-to-r from-purple-700/10 to-purple-800/10 opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
          <svg class="w-5 h-5 text-gray-500 group-hover:text-purple-700 transition-colors duration-200 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
          <span class="ml-3 font-medium relative z-10">Accueil</span>
        <% end %>
      </div>
    </nav>

   <!-- Bottom Section -->
    <% if current_user %>
      <div class="flex-shrink-0 px-4 py-4 border-t border-gray-200 bg-gray-50" data-controller="logout" data-logout-logout-url-value="<%= destroy_user_session_path %>">
        <div class="space-y-2">
          <%= link_to profile_path, class: "flex items-center px-4 py-2 text-gray-600 hover:text-purple-700 transition-colors duration-200" do %>
            <span class="material-symbols-outlined text-gray-500">person</span>
            <span data-sidebar-target="label" class="ml-3 text-sm">Profil</span>
          <% end %>
          <%= link_to destroy_user_session_path, method: :delete, class: "flex items-center px-4 py-2 text-gray-600 hover:text-purple-700 transition-colors duration-200",
            data: { confirm: 'Êtes-vous sûr de vouloir vous déconnecter ?' } do %>
            <span class="material-symbols-outlined text-gray-500">logout</span>
            <span data-sidebar-target="label" class="ml-3 text-sm">Déconnexion</span>
          <% end %>
        </div>

      </div>
    <% end %>
  </aside>

</div>
