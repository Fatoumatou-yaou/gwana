<section class="relative h-screen w-full flex items-center overflow-hidden bg-white">
  <!-- Background Abstract Shapes - Left side -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <!-- Large purple circles/gears - Left side background -->
    <div class="absolute top-0 -left-40 w-[600px] h-[600px] bg-violet-700/10 rounded-full blur-3xl"></div>
    <div class="absolute top-1/4 -left-20 w-[400px] h-[400px] bg-violet-800/8 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 -left-10 w-[300px] h-[300px] bg-violet-700/5 rounded-full blur-2xl"></div>
    
    <!-- Geometric shapes - Gear-like circles on left -->
    <div class="absolute top-1/3 left-1/4 w-64 h-64 border-8 border-violet-700/15 rounded-full blur-xl"></div>
    <div class="absolute bottom-1/3 left-1/3 w-48 h-48 border-6 border-amber-400/10 rounded-full blur-lg"></div>
  </div>

  <!-- Main Container with Flexbox -->
  <div class="w-full h-full px-8 sm:px-12 lg:px-16 xl:px-20 relative z-10 flex items-center">
    <div class="flex flex-col lg:flex-row items-center w-full gap-8 lg:gap-12">
      
      <!-- Left Side - Text and CTA -->
      <div class="flex-1 text-center lg:text-left space-y-6 lg:space-y-8 relative z-10">
        <div class="space-y-3 lg:space-y-4">
          <h1 id="hero-title" class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold leading-[1.1] text-gray-900 tracking-tight">
            Valoriser les Femmes <span class="text-amber-400">Pionnières</span> et Transformer les Métiers au <span class="text-violet-700">Niger</span>
          </h1>
        </div>
        
        <div class="space-y-4 max-w-2xl mx-auto lg:mx-0">
          <p class="text-base md:text-lg lg:text-xl text-gray-700 leading-relaxed font-light">
            Rejoignez notre communauté de femmes expertes qui transforment les métiers traditionnellement masculins au Niger. Connectez-vous, partagez votre expérience et inspirez la prochaine génération.
          </p>
          
          <div class="pt-2">
            <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start">
              <% if user_signed_in? %>
                <%= link_to members_path, class: "group relative bg-gradient-to-r from-violet-700 to-violet-800 hover:from-violet-800 hover:to-violet-700 text-white px-8 py-4 rounded-2xl font-semibold text-base transition-all transform hover:scale-105 shadow-lg shadow-violet-700/50 overflow-hidden" do %>
                  <span class="relative z-10">Découvrir l'annuaire</span>
                  <div class="absolute inset-0 bg-gradient-to-r from-violet-800 to-violet-700 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <% end %>
              <% else %>
                <%= link_to new_user_registration_path, class: "group relative bg-gradient-to-r from-violet-700 to-violet-800 hover:from-violet-800 hover:to-violet-700 text-white px-8 py-4 rounded-2xl font-semibold text-base transition-all transform hover:scale-105 shadow-lg shadow-violet-700/50 overflow-hidden" do %>
                  <span class="relative z-10">Rejoindre GWANA</span>
                  <div class="absolute inset-0 bg-gradient-to-r from-violet-800 to-violet-700 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <% end %>
                <%= link_to "Voir l'annuaire", members_path, class: "bg-white border-2 border-violet-700 text-violet-700 hover:bg-violet-700 hover:text-white px-8 py-4 rounded-2xl font-semibold text-base transition-all" %>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Side - Semi-circle with Group Photo -->
      <div class="flex-1 relative flex items-center justify-center w-full h-full">
        <!-- Semi-circle container - positioned higher -->
        <div class="relative w-full max-w-[500px] lg:max-w-[600px] xl:h-1/2 h-[500px] lg:h-[600px] xl:h-[700px]">
          <!-- Semi-circle shape - larger and higher, containing the photo -->
          <div class="absolute top-0 left-0 right-0 h-full bg-gradient-to-b from-violet-700/20 via-violet-700/25 to-violet-800/30 rounded-t-full"></div>
          
          <!-- Photo container inside semi-circle - well positioned -->
          <div class="absolute top-8 left-1/2 transform -translate-x-1/2 w-[85%] max-w-[450px] lg:max-w-[550px] xl:max-w-[650px]">
            <div class="relative rounded-2xl overflow-hidden shadow-2xl border-4 border-white transform hover:scale-[1.02] transition-transform duration-500">
              <%= image_tag "group-photo.jpeg", alt: "Photo de groupe des membres de GWANA", class: "w-full h-auto object-cover rounded-xl" %>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>
















<!-- Hero Section - Mixed Design -->


<section class="relative h-screen w-full flex items-center overflow-hidden ">
  <!-- NAVBAR (garde la tienne) -->
  <!-- BACKDROP - Left subtle pattern (optional) -->
  <div class="absolute inset-0 pointer-events-none">
    <!-- dark vignette left -->
    <div class="absolute inset-y-0 left-0 w-1/2 bg-gradient-to-r from-black/45 via-transparent to-transparent"></div>
  </div>

  <!-- CONCENTRIC RINGS (SVG) -->
  <div class="absolute inset-0 pointer-events-none overflow-visible z-10">
    <svg viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" class="w-full h-full">
      <!-- Outer ring (big, low opacity) -->
      <circle cx="900" cy="400" r="520"
              fill="none"
              stroke="rgb(45, 2, 61)"
              stroke-width="360"
              stroke-opacity="0.55"
              stroke-linecap="round"
              style="filter: drop-shadow(0 30px 60px rgba(0,0,0,0.45))" />
      <!-- Middle luminous ring (thin bright glow) -->
      <circle cx="900" cy="400" r="420"
              fill="none"
              stroke="rgb(124, 58, 237)"
              stroke-width="120"
              stroke-opacity="0.85"
              stroke-linecap="round"
              style="filter: drop-shadow(0 18px 40px rgba(124,58,237,0.6))" />
      <!-- Inner bright halo -->
      <circle cx="900" cy="400" r="330"
              fill="none"
              stroke="rgb(233, 216, 255)"
              stroke-width="60"
              stroke-opacity="0.95"
              stroke-linecap="round"
              style="filter: drop-shadow(0 10px 30px rgba(233,216,255,0.6))" />
    </svg>
  </div>

  <!-- MAIN CONTENT -->
  <div class="w-full h-full px-6 md:px-12 lg:px-20 relative z-20 flex items-center">
    <div class="flex flex-col lg:flex-row w-full items-center gap-8">

      <!-- LEFT: texte -->
      <div class="flex-1 max-w-xl text-white z-30">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight">
          Addressing Gender<br/>
          <span class="block">Disparities</span>
          <span class="block">Driving Corporate Change</span>
        </h1>
        <p class="mt-6 text-lg font-medium text-white/80 max-w-md">
          Lorem ipsum dolor sit amet, consectetur adipisicing elit. Connectez-vous, partagez, influencez.
        </p>
        <div class="mt-8 flex gap-4">
          <a href="#" class="inline-block bg-violet-600 hover:bg-violet-700 px-6 py-3 rounded-full font-semibold shadow-lg">READ MORE...</a>
        </div>
      </div>

      <!-- RIGHT: image circular + partial crop overlapping rings -->
      <div class="flex-1 relative flex justify-end items-center">
        <!-- Circular photo container (with inner shadow and border) -->
        <div class="relative w-[520px] h-[520px] rounded-full overflow-hidden translate-x-10 md:translate-x-28 lg:translate-x-40"
             style="box-shadow: inset 0 -40px 80px rgba(0,0,0,0.35), 0 30px 80px rgba(0,0,0,0.45);">
          <!-- actual image: replace with your image_tag if Rails -->
          <img src="/assets/YOUR-IMAGE.jpg" alt="people" class="w-full h-full object-cover translate-x-[20%] translate-y-[-6%]"/>
          <!-- subtle gradient overlay to blend into purple rings -->
          <div class="absolute inset-0" style="background: radial-gradient(circle at 60% 40%, rgba(255,255,255,0.04), rgba(0,0,0,0.15)); mix-blend-mode: overlay;"></div>
        </div>

        <!-- Optional small accent circle to the right (like the tiny face in screenshot) -->
        <div class="hidden lg:block absolute bottom-8 right-[-40px] w-36 h-36 rounded-full overflow-hidden ring-4 ring-white/40"
             style="box-shadow: 0 18px 40px rgba(0,0,0,0.4);">
          <img src="/assets/YOUR-IMAGE-2.jpg" alt="accent" class="w-full h-full object-cover"/>
        </div>
      </div>

    </div>
  </div>
</section>
