<% if article.errors.any? %>
  <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
    <ul class="list-disc list-inside text-red-600">
      <% article.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="bg-white rounded-lg p-8 border border-gray-200 shadow-sm" data-controller="media-type-selector">
  <!-- Titre -->
  <div class="mb-6">
    <%= f.label :title, "Titre", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= f.text_field :title, 
        placeholder: "Titre de l'article", 
        class: "w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:border-purple-700 focus:ring-2 focus:ring-purple-700/20 transition-all" %>
  </div>

  <!-- Catégorie -->
  <div class="mb-6">
    <%= f.label :category, "Catégorie", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= f.text_field :category, 
        placeholder: "Ex: Actualités, Événements, Conseils...", 
        class: "w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:border-purple-700 focus:ring-2 focus:ring-purple-700/20 transition-all" %>
  </div>

  <!-- Contenu -->
  <div class="mb-6">
    <%= f.label :content, "Contenu", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= f.text_area :content, 
        rows: 15,
        placeholder: "Contenu de l'article...", 
        class: "w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:border-purple-700 focus:ring-2 focus:ring-purple-700/20 transition-all font-mono" %>
    <p class="text-xs text-gray-500 mt-2">Vous pouvez utiliser du HTML pour formater le contenu</p>
  </div>

  <!-- Tags -->
  <div class="mb-6">
    <%= f.label :tags, "Tags", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= f.text_field :tags, 
        placeholder: "tag1, tag2, tag3 (séparés par des virgules)", 
        class: "w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:border-purple-700 focus:ring-2 focus:ring-purple-700/20 transition-all" %>
  </div>

  <!-- Type de média -->
  <div class="mb-6">
    <%= f.label :media_type, "Type de média", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= f.select :media_type, 
        options_for_select([
          ["Aucun média", "none"],
          ["Photo", "photo"],
          ["Vidéo", "video"]
        ], article.media_type || "none"), 
        {}, 
        { 
          class: "w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:border-purple-700 focus:ring-2 focus:ring-purple-700/20 transition-all",
          data: { media_type_selector_target: "select", action: "change->media-type-selector#toggleFields" }
        } %>
  </div>

  <!-- Photo -->
  <div class="mb-6" data-media-type-selector-target="photoField" style="<%= 'display: none;' unless article.media_type == 'photo' %>">
    <%= f.label :photo, "Photo", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <% if article.persisted? && article.photo.attached? %>
      <div class="mb-4">
        <%= image_tag article.photo, class: "w-full max-w-md rounded-lg border border-gray-300" %>
        <p class="text-xs text-gray-500 mt-2">Photo actuelle</p>
      </div>
    <% end %>
    <%= f.file_field :photo, 
        accept: "image/jpeg,image/jpg,image/png,image/webp",
        class: "w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:border-purple-700 focus:ring-2 focus:ring-purple-700/20 transition-all" %>
    <p class="text-xs text-gray-500 mt-2">Formats acceptés : JPEG, PNG, WebP</p>
  </div>

  <!-- Vidéo -->
  <div class="mb-6" data-media-type-selector-target="videoField" style="<%= 'display: none;' unless article.media_type == 'video' %>">
    <%= f.label :video, "Vidéo", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <% if article.persisted? && article.video.attached? %>
      <div class="mb-4">
        <video controls class="w-full max-w-md rounded-lg border border-gray-300">
          <source src="<%= url_for(article.video) %>" type="<%= article.video.content_type %>">
          Votre navigateur ne supporte pas la lecture de vidéos.
        </video>
        <p class="text-xs text-gray-500 mt-2">Vidéo actuelle</p>
      </div>
    <% end %>
    <%= f.file_field :video, 
        accept: "video/mp4,video/webm,video/ogg,video/quicktime",
        class: "w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:border-purple-700 focus:ring-2 focus:ring-purple-700/20 transition-all" %>
    <p class="text-xs text-gray-500 mt-2">Formats acceptés : MP4, WebM, OGG, QuickTime (max 100 Mo)</p>
  </div>

  <!-- Statut de publication -->
  <div class="mb-6">
    <div class="flex items-center">
      <%= f.check_box :published, class: "w-4 h-4 text-purple-700 bg-white border-gray-300 rounded focus:ring-purple-700" %>
      <%= f.label :published, "Publier l'article", class: "ml-2 text-sm font-semibold text-gray-700" %>
    </div>
    <p class="text-xs text-gray-500 mt-2">Si coché, l'article sera publié immédiatement</p>
  </div>
</div>

