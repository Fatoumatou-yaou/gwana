<% content_for :title, "Modifier l'article" %>

<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-4xl font-bold text-gray-900 mb-2">Modifier l'article</h1>
    <p class="text-gray-600">Modifiez les informations de l'article</p>
  </div>

  <%= form_with model: [:admin, @article], local: true, multipart: true do |f| %>
    <%= render "admin/articles/form", article: @article, f: f %>
    
    <div class="flex justify-end gap-4 mt-8">
      <%= link_to "Annuler", admin_article_path(@article), class: "bg-gray-600 hover:bg-gray-700 text-white px-6 py-3 rounded-lg transition-colors" %>
      <%= f.submit "Enregistrer les modifications", 
          class: "bg-purple-700 hover:bg-purple-800 text-white px-6 py-3 rounded-lg transition-colors font-semibold" %>
    </div>
  <% end %>
</div>

