<%= form_with model: [:admin, @gwana.object, @portrait_video], url: form_url, local: true do |f| %>
  <% if @portrait_video.errors.any? %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
      <ul class="list-disc list-inside text-red-600">
        <% @portrait_video.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-lg p-8 border border-gray-200 shadow-sm">
    <!-- Vidéo YouTube -->
    <div class="mb-6">
      <%= f.label :youtube_video_id, "ID de la vidéo YouTube", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= f.text_field :youtube_video_id, 
          placeholder: "Ex: dQw4w9WgXcQ (l'ID de l'URL youtube.com/watch?v=...)", 
          class: "w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:border-purple-700 focus:ring-2 focus:ring-purple-700/20 transition-all" %>
      <p class="text-xs text-gray-500 mt-2">Indiquez uniquement l'ID de la vidéo (pas l'URL complète)</p>
      <% if @portrait_video.persisted? && @portrait_video.youtube_video_id.present? %>
        <div class="mt-4">
          <iframe width="560" height="315" src="<%= @portrait_video.youtube_embed_url %>" frameborder="0" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen class="rounded-lg"></iframe>
        </div>
      <% end %>
    </div>

    <!-- Phrase d'accroche -->
    <div class="mb-6">
      <%= f.label :teaser_text, "Phrase d'accroche", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= f.text_area :teaser_text, 
          rows: 3,
          placeholder: "Découvrez la vidéo portrait de...", 
          maxlength: 200,
          class: "w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:border-purple-700 focus:ring-2 focus:ring-purple-700/20 transition-all" %>
      <p class="text-xs text-gray-500 mt-2">Maximum 200 caractères</p>
    </div>

    <!-- Ordre d'affichage -->
    <div class="mb-6">
      <%= f.label :display_order, "Ordre d'affichage", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= f.number_field :display_order, 
          min: 0,
          class: "w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:border-purple-700 focus:ring-2 focus:ring-purple-700/20 transition-all" %>
      <p class="text-xs text-gray-500 mt-2">Les vidéos sont affichées dans l'ordre croissant (0 = première position)</p>
    </div>
  </div>

  <div class="flex justify-end gap-4 mt-8">
    <%= link_to "Annuler", admin_gwana_path(@gwana), class: "bg-gray-600 hover:bg-gray-700 text-white px-6 py-3 rounded-lg transition-colors" %>
    <%= f.submit submit_text, 
        class: "bg-purple-700 hover:bg-purple-800 text-white px-6 py-3 rounded-lg transition-colors font-semibold" %>
  </div>
<% end %>

