<% content_for :title, @gwana.full_name %>

<div class="max-w-9xl mx-auto px-4 py-8">
  <div class="bg-white rounded-lg p-8 border border-gray-200 shadow-sm">
    <div class="flex justify-between items-start mb-8">
      <div>
        <h1 class="text-4xl font-bold text-gray-900 mb-2"><%= @gwana.full_name %></h1>
        <p class="text-gray-600">Compte créé le <%= l(@gwana.created_at, format: :long) %></p>
      </div>
      <div class="flex gap-2">
        <%= link_to "Modifier", edit_admin_gwana_path(@gwana), class: "bg-purple-700 hover:bg-purple-800 text-white px-4 py-2 rounded-lg transition-colors" %>
        <%= link_to "Retour", admin_gwanas_path, class: "bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-lg transition-colors" %>
      </div>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
      <!-- Left Column - Main Info -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Biographie -->
        <% if @gwana.bio.present? %>
          <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-purple-700">Biographie</h2>
            </div>
            <div class="text-gray-700 leading-relaxed break-words overflow-wrap-anywhere">
              <%= simple_format(@gwana.bio) %>
            </div>
          </div>
        <% end %>

        <!-- Expériences -->
        <% if @gwana.experiences.present? %>
          <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-purple-700">Expériences professionnelles</h2>
            </div>
            <div class="text-gray-700 leading-relaxed break-words overflow-wrap-anywhere">
              <%= simple_format(@gwana.experiences) %>
            </div>
          </div>
        <% end %>

        <!-- Formations -->
        <% if @gwana.formations.present? %>
          <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-purple-700">Formations</h2>
            </div>
            <div class="text-gray-700 leading-relaxed break-words overflow-wrap-anywhere">
              <%= simple_format(@gwana.formations) %>
            </div>
          </div>
        <% end %>

        <!-- Activités -->
        <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg overflow-hidden">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-purple-700">Activités</h2>
            </div>
            <%= link_to "Nouvelle activité", new_admin_gwana_activity_path(@gwana), class: "bg-purple-700 hover:bg-purple-800 text-white px-4 py-2 rounded-lg transition-colors text-sm" %>
          </div>

          <!-- Liste des activités -->
          <% if @gwana.activities.any? %>
            <div class="space-y-4">
              <% @gwana.activities.recent.each do |activity| %>
                <div class="bg-white rounded-lg p-4 border border-gray-200 overflow-hidden">
                  <div class="flex items-start justify-between mb-2 gap-4">
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2 mb-2 flex-wrap">
                        <span class="px-3 py-1 bg-purple-700/20 text-purple-700 rounded-full text-xs font-semibold whitespace-nowrap">
                          <%= activity.activity_type.humanize %>
                        </span>
                        <span class="text-xs text-gray-500 whitespace-nowrap">
                          <%= l(activity.activity_date, format: :short) %>
                        </span>
                      </div>
                      <p class="text-gray-700 text-sm line-clamp-2 break-words overflow-hidden"><%= activity.description %></p>
                    </div>
                    <div class="flex gap-2 ml-4 flex-shrink-0">
                      <%= link_to "Modifier", edit_admin_gwana_activity_path(@gwana, activity), class: "text-purple-700 hover:text-purple-800 text-sm whitespace-nowrap" %>
                      <%= link_to "Supprimer", admin_gwana_activity_path(@gwana, activity), 
                          data: { turbo_method: :delete, turbo_confirm: "Êtes-vous sûr de vouloir supprimer cette activité ?" },
                          class: "text-red-600 hover:text-red-700 text-sm whitespace-nowrap" %>
                    </div>
                  </div>
                  <% if activity.has_video? %>
                    <div class="mt-2 text-xs text-gray-500">
                      <span class="inline-flex items-center gap-1">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM14.553 7.106A1 1 0 0014 8v4a1 1 0 00.553.894l2 1A1 1 0 0018 13V7a1 1 0 00-1.447-.894l-2 1z"/>
                        </svg>
                        Vidéo YouTube
                      </span>
                    </div>
                  <% end %>
                  <% if activity.has_photos? %>
                    <div class="mt-2 text-xs text-gray-500">
                      <span class="inline-flex items-center gap-1">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/>
                        </svg>
                        <%= activity.photos.count %> photo<%= "s" if activity.photos.count > 1 %>
                      </span>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-gray-500 text-sm">Aucune activité enregistrée pour le moment.</p>
          <% end %>
        </div>

        <!-- Vidéos Portraits -->
        <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg overflow-hidden">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-purple-700">Vidéos Portraits</h2>
            </div>
            <%= link_to "Nouvelle vidéo", new_admin_gwana_portrait_video_path(@gwana), class: "bg-purple-700 hover:bg-purple-800 text-white px-4 py-2 rounded-lg transition-colors text-sm" %>
          </div>

          <!-- Liste des vidéos portraits -->
          <% if @gwana.portrait_videos.any? %>
            <div class="space-y-4">
              <% @gwana.portrait_videos.ordered.each do |portrait_video| %>
                <div class="bg-white rounded-lg p-4 border border-gray-200 overflow-hidden">
                  <div class="flex items-start justify-between mb-2 gap-4">
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2 mb-2 flex-wrap">
                        <span class="px-3 py-1 bg-purple-700/20 text-purple-700 rounded-full text-xs font-semibold whitespace-nowrap">
                          Ordre: <%= portrait_video.display_order %>
                        </span>
                        <span class="text-xs text-gray-500 whitespace-nowrap">
                          <%= l(portrait_video.created_at, format: :short) %>
                        </span>
                      </div>
                      <p class="text-gray-700 text-sm line-clamp-2 break-words overflow-hidden"><%= portrait_video.teaser_text %></p>
                      <% if portrait_video.youtube_video_id.present? %>
                        <div class="mt-2 text-xs text-gray-500">
                          <span class="inline-flex items-center gap-1">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                              <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM14.553 7.106A1 1 0 0014 8v4a1 1 0 00.553.894l2 1A1 1 0 0018 13V7a1 1 0 00-1.447-.894l-2 1z"/>
                            </svg>
                            Vidéo YouTube
                          </span>
                        </div>
                      <% end %>
                    </div>
                    <div class="flex gap-2 ml-4 flex-shrink-0">
                      <%= link_to "Modifier", edit_admin_gwana_portrait_video_path(@gwana, portrait_video), class: "text-purple-700 hover:text-purple-800 text-sm whitespace-nowrap" %>
                      <%= link_to "Supprimer", admin_gwana_portrait_video_path(@gwana, portrait_video), 
                          data: { turbo_method: :delete, turbo_confirm: "Êtes-vous sûr de vouloir supprimer cette vidéo portrait ?" },
                          class: "text-red-600 hover:text-red-700 text-sm whitespace-nowrap" %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-gray-500 text-sm">Aucune vidéo portrait enregistrée pour le moment.</p>
          <% end %>
        </div>
      </div>

      <!-- Right Column - Sidebar Info -->
      <div class="space-y-6 lg:sticky lg:top-6 lg:self-start">
        <!-- Photo -->
        <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg text-center">
          <% if @gwana.photo.attached? %>
            <%= image_tag url_for(@gwana.photo), alt: @gwana.full_name, class: "w-48 h-48 rounded-full mx-auto mb-4 object-cover border-4 border-purple-700/20" %>
          <% else %>
            <div class="w-48 h-48 rounded-full mx-auto mb-4 bg-purple-700 flex items-center justify-center text-6xl font-bold text-white border-4 border-purple-700/20">
              <%= @gwana.first_name[0].upcase %><%= @gwana.last_name[0].upcase %>
            </div>
          <% end %>
          <h3 class="text-xl font-bold text-purple-700 mb-2"><%= @gwana.full_name %></h3>
          <% if @gwana.profession.present? %>
            <p class="text-gray-600 mb-4"><%= @gwana.profession %></p>
          <% end %>
          <% if @gwana.region.present? %>
            <div class="flex items-center justify-center gap-2 text-gray-600 text-sm">
              <svg class="w-4 h-4 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span><%= @gwana.region %></span>
              <% commune_name = @gwana.commune %>
              <% if commune_name.present? && commune_name != "non fourni" %>
                <span class="text-gray-500">• <%= commune_name %></span>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Compétences -->
        <% if @gwana.skills.present? && @gwana.skills_array.any? %>
          <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
              </div>
              <h2 class="text-xl font-bold text-purple-700">Compétences</h2>
            </div>
            <div class="flex flex-wrap gap-2">
              <% @gwana.skills_array.each do |skill| %>
                <span class="bg-purple-700/20 text-purple-700 px-4 py-2 rounded-full text-sm font-medium border border-purple-700/30">
                  <%= skill %>
                </span>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Informations de contact -->
        <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
              <svg class="w-6 h-6 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <h2 class="text-xl font-bold text-purple-700">Contact</h2>
          </div>
          <div class="space-y-3 text-gray-700">
            <div>
              <h3 class="text-sm font-semibold text-purple-700 mb-1">Email</h3>
              <p class="text-sm break-all"><%= @gwana.user.email %></p>
            </div>
            <% if @gwana.phone.present? %>
              <div>
                <h3 class="text-sm font-semibold text-purple-700 mb-1">Téléphone</h3>
                <p class="text-sm"><%= @gwana.phone %></p>
              </div>
            <% end %>
            <% if @gwana.address.present? %>
              <div>
                <h3 class="text-sm font-semibold text-purple-700 mb-1">Adresse</h3>
                <p class="text-sm break-words"><%= @gwana.address %></p>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Disponibilité pour mentorat -->
        <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
              <svg class="w-6 h-6 text-purple-700" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            </div>
            <h2 class="text-xl font-bold text-purple-700">Mentorat</h2>
          </div>
          <div>
            <% if @gwana.available_for_mentorship? %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                Disponible pour mentorat
              </span>
            <% else %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
                Non disponible
              </span>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

