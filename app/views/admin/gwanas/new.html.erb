<% content_for :title, "Créer un compte Gwana" %>

<div class="min-h-screen bg-gradient-to-b from-white to-gray-50 py-4 px-4 sm:px-6 lg:px-8">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-4">
      <h1 class="text-3xl font-bold text-purple-700 mb-1">Créer un compte Gwana</h1>
      <p class="text-sm text-gray-600">Ajouter un nouveau membre à l'annuaire GWANA</p>
    </div>

    <%= form_with model: [:admin, @gwana], local: true, multipart: true do |f| %>
      <%= render MultiStepFormComponent.new(
        form_builder: f,
        model: @gwana,
        regions: @regions,
        departments: @departments || [],
        communes: @communes || [],
        show_identity_document: false,
        submit_label: "Créer le compte",
        cancel_path: admin_gwanas_path,
        cancel_label: "Annuler"
      ) %>
    <% end %>

    <div class="text-center mt-6">
      <%= link_to "← Retour à la liste", admin_gwanas_path, class: "text-purple-700 hover:text-purple-800 transition-colors" %>
    </div>
  </div>
</div>

