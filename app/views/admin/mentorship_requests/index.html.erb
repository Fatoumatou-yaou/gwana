<% content_for :title, "Demandes de mentorat" %>

<div class="max-w-7xl mx-auto px-4 py-8">
  <%= render ItemTableComponent.new(
    items: @mentorship_requests,
    columns: {
      "requester.gwana_profile.full_name" => "Demandeur",
      "mentor.gwana_profile.full_name" => "Mentor",
      status: "Statut",
      formatted_created_at: "Date de création"
    },
    item_type: "mentorship_request",
    scope: ["admin"],
    actions: [:show],
    display_new_button: false,
    empty_message: "Aucune demande de mentorat pour le moment.",
    pagy: @pagy
  ) %>
</div>

