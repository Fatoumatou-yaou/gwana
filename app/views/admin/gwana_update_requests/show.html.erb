<% content_for :title, "Demande de mise à jour - #{@gwana_update_request.gwana.full_name}" %>

<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Retour à la liste", admin_gwana_update_requests_path, class: "text-purple-700 hover:text-purple-800 transition-colors" %>
  </div>

  <div class="bg-white rounded-lg p-8 border border-gray-200 shadow-sm">
    <!-- Header -->
    <div class="flex justify-between items-start mb-8">
      <div>
        <h1 class="text-4xl font-bold text-gray-900 mb-2"><%= @gwana_update_request.gwana.full_name %></h1>
        <div class="flex items-center gap-4">
          <span class="px-4 py-2 rounded-full text-sm <%= @gwana_update_request.pending? ? 'bg-yellow-500/20 text-yellow-500' : @gwana_update_request.approved? ? 'bg-green-500/20 text-green-500' : 'bg-red-500/20 text-red-500' %>">
            <%= @gwana_update_request.status.humanize %>
          </span>
          <span class="text-sm text-gray-600">
            Demandé le <%= l(@gwana_update_request.created_at, format: :long) %>
          </span>
        </div>
      </div>
    </div>

    <!-- Comparison -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
      <!-- Current -->
      <div>
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Profil actuel</h2>
        <div class="space-y-4">
          <div>
            <% if @gwana_update_request.gwana.photo.attached? %>
              <%= image_tag @gwana_update_request.gwana.photo, class: "w-32 h-32 rounded-full object-cover border-4 border-purple-700/20" %>
            <% else %>
              <div class="w-32 h-32 rounded-full bg-purple-700 flex items-center justify-center text-3xl font-bold text-white border-4 border-purple-700/20">
                <%= @gwana_update_request.gwana.first_name[0].upcase %><%= @gwana_update_request.gwana.last_name[0].upcase %>
              </div>
            <% end %>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-purple-700 mb-1">Bio actuelle</h3>
            <p class="text-gray-700 text-sm"><%= @gwana_update_request.gwana.bio.present? ? simple_format(@gwana_update_request.gwana.bio) : "Aucune bio" %></p>
          </div>
        </div>
      </div>

      <!-- Proposed -->
      <div>
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Modifications proposées</h2>
        <div class="space-y-4">
          <% if @gwana_update_request.has_photo_update? %>
            <div>
              <%= image_tag @gwana_update_request.photo, class: "w-32 h-32 rounded-full object-cover border-4 border-purple-700/20" %>
            </div>
          <% end %>
          <% if @gwana_update_request.has_bio_update? %>
            <div>
              <h3 class="text-sm font-semibold text-purple-700 mb-1">Nouvelle bio</h3>
              <p class="text-gray-700 text-sm"><%= simple_format(@gwana_update_request.bio) %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <% if @gwana_update_request.pending? %>
      <div class="flex gap-4 justify-end pt-6 border-t border-gray-200">
        <%= button_to "Approuver", approve_admin_gwana_update_request_path(@gwana_update_request), 
            method: :patch,
            class: "bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-semibold transition-colors" %>
        <%= button_to "Refuser", reject_admin_gwana_update_request_path(@gwana_update_request), 
            method: :patch,
            class: "bg-red-600 hover:bg-red-700 text-white px-6 py-3 rounded-lg font-semibold transition-colors" %>
      </div>
    <% elsif @gwana_update_request.approved? %>
      <div class="pt-6 border-t border-gray-200">
        <p class="text-sm text-gray-600">
          Approuvée par <strong><%= @gwana_update_request.reviewed_by&.email %></strong> 
          le <%= l(@gwana_update_request.reviewed_at, format: :long) if @gwana_update_request.reviewed_at %>
        </p>
      </div>
    <% elsif @gwana_update_request.rejected? %>
      <div class="pt-6 border-t border-gray-200">
        <p class="text-sm text-gray-600">
          Refusée par <strong><%= @gwana_update_request.reviewed_by&.email %></strong> 
          le <%= l(@gwana_update_request.reviewed_at, format: :long) if @gwana_update_request.reviewed_at %>
        </p>
      </div>
    <% end %>
  </div>
</div>

