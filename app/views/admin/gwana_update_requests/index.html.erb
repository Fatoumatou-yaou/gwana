<% content_for :title, "Demandes de mise à jour" %>

<div class="max-w-7xl mx-auto px-4 py-8">
  <h1 class="text-4xl font-bold mb-8 text-gray-900">Demandes de mise à jour de profil</h1>

  <!-- Pending Requests -->
  <% if @pending_requests.any? %>
    <div class="mb-12">
      <h2 class="text-2xl font-semibold mb-4 text-gray-900">En attente de validation (<%= @pending_requests.count %>)</h2>
      <div class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm">
        <div class="divide-y divide-gray-200">
          <% @pending_requests.each do |request| %>
            <div class="p-6 hover:bg-gray-50 transition-colors">
              <div class="flex justify-between items-start">
                <div class="flex-1">
                  <div class="flex items-center gap-4 mb-2">
                    <h3 class="text-xl font-semibold text-gray-900"><%= request.gwana.full_name %></h3>
                    <span class="px-3 py-1 rounded-full text-xs bg-yellow-500/20 text-yellow-500">En attente</span>
                  </div>
                  <div class="text-sm text-gray-600 mb-2">
                    <span class="text-purple-700">Demandé le:</span> <%= l(request.created_at, format: :long) %>
                  </div>
                  <div class="text-sm text-gray-700">
                    <% if request.has_bio_update? %>
                      <span class="inline-block bg-purple-700/20 text-purple-700 px-2 py-1 rounded mr-2">Bio modifiée</span>
                    <% end %>
                    <% if request.has_photo_update? %>
                      <span class="inline-block bg-purple-700/20 text-purple-700 px-2 py-1 rounded">Photo modifiée</span>
                    <% end %>
                  </div>
                </div>
                <div class="flex gap-2 ml-4">
                  <%= link_to "Voir", admin_gwana_update_request_path(request), class: "bg-purple-700 hover:bg-purple-800 text-white px-4 py-2 rounded-lg transition-colors text-sm" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Approved Requests -->
  <% if @approved_requests.any? %>
    <div class="mb-12">
      <h2 class="text-2xl font-semibold mb-4 text-gray-900">Approuvées</h2>
      <div class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm">
        <div class="divide-y divide-gray-200">
          <% @approved_requests.each do |request| %>
            <div class="p-6">
              <div class="flex justify-between items-start">
                <div class="flex-1">
                  <div class="flex items-center gap-4 mb-2">
                    <h3 class="text-lg font-semibold text-gray-900"><%= request.gwana.full_name %></h3>
                    <span class="px-3 py-1 rounded-full text-xs bg-green-500/20 text-green-500">Approuvée</span>
                  </div>
                  <div class="text-sm text-gray-600">
                    Approuvée par <%= request.reviewed_by&.email %> le <%= l(request.reviewed_at, format: :short) if request.reviewed_at %>
                  </div>
                </div>
                <div class="ml-4">
                  <%= link_to "Voir", admin_gwana_update_request_path(request), class: "text-purple-700 hover:text-purple-800 transition-colors text-sm" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Rejected Requests -->
  <% if @rejected_requests.any? %>
    <div>
      <h2 class="text-2xl font-semibold mb-4 text-gray-900">Refusées</h2>
      <div class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm">
        <div class="divide-y divide-gray-200">
          <% @rejected_requests.each do |request| %>
            <div class="p-6">
              <div class="flex justify-between items-start">
                <div class="flex-1">
                  <div class="flex items-center gap-4 mb-2">
                    <h3 class="text-lg font-semibold text-gray-900"><%= request.gwana.full_name %></h3>
                    <span class="px-3 py-1 rounded-full text-xs bg-red-500/20 text-red-500">Refusée</span>
                  </div>
                  <div class="text-sm text-gray-600">
                    Refusée par <%= request.reviewed_by&.email %> le <%= l(request.reviewed_at, format: :short) if request.reviewed_at %>
                  </div>
                </div>
                <div class="ml-4">
                  <%= link_to "Voir", admin_gwana_update_request_path(request), class: "text-purple-700 hover:text-purple-800 transition-colors text-sm" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <% if @pending_requests.empty? && @approved_requests.empty? && @rejected_requests.empty? %>
    <div class="bg-white rounded-lg p-12 border border-gray-200 shadow-sm text-center">
      <p class="text-gray-600">Aucune demande de mise à jour pour le moment.</p>
    </div>
  <% end %>
</div>

