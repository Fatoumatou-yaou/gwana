<% content_for :title, "Demande de rejoindre le réseau - #{@gwana_network_request.full_name}" %>

<div class="max-w-9xl mx-auto px-4 py-8" data-controller="rejection-modal">
  <div class="mb-6">
    <%= link_to "← Retour à la liste", admin_gwana_network_requests_path, class: "text-purple-700 hover:text-purple-600 transition-colors" %>
  </div>

  <div class="bg-white rounded-lg p-8 border border-gray-200 shadow-sm">
    <!-- Header -->
    <div class="flex justify-between items-start mb-8">
      <div>
        <h1 class="text-4xl font-bold text-gray-900 mb-2"><%= @gwana_network_request.full_name %></h1>
        <div class="flex items-center gap-4">
          <%= @gwana_network_request.decorate.status_badge %>
          <span class="text-sm text-gray-600">
            Demandé le <%= l(@gwana_network_request.created_at, format: :long) %>
          </span>
        </div>
      </div>
    </div>

    <!-- Informations personnelles -->
    <div class="mb-8">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Informations personnelles</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <span class="text-sm font-semibold text-purple-700">Email</span>
          <p class="text-gray-700"><%= @gwana_network_request.email %></p>
        </div>
        <% if @gwana_network_request.phone.present? %>
          <div>
            <span class="text-sm font-semibold text-purple-700">Téléphone</span>
            <p class="text-gray-700"><%= @gwana_network_request.phone %></p>
          </div>
        <% end %>
        <% if @gwana_network_request.address.present? %>
          <div>
            <span class="text-sm font-semibold text-purple-700">Adresse</span>
            <p class="text-gray-700"><%= @gwana_network_request.address %></p>
          </div>
        <% end %>
        <% if @gwana_network_request.commune.present? %>
          <div>
            <span class="text-sm font-semibold text-purple-700">Localisation</span>
            <p class="text-gray-700"><%= @gwana_network_request.commune.name %></p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Informations professionnelles -->
    <div class="mb-8">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Informations professionnelles</h2>
      <div class="space-y-4">
        <% if @gwana_network_request.profession.present? %>
          <div>
            <span class="text-sm font-semibold text-purple-700">Profession</span>
            <p class="text-gray-700"><%= @gwana_network_request.profession %></p>
          </div>
        <% end %>
        <% if @gwana_network_request.experiences.present? %>
          <div>
            <span class="text-sm font-semibold text-purple-700">Expériences</span>
            <p class="text-gray-700 whitespace-pre-wrap"><%= @gwana_network_request.experiences %></p>
          </div>
        <% end %>
        <% if @gwana_network_request.formations.present? %>
          <div>
            <span class="text-sm font-semibold text-purple-700">Formations</span>
            <p class="text-gray-700 whitespace-pre-wrap"><%= @gwana_network_request.formations %></p>
          </div>
        <% end %>
        <% if @gwana_network_request.bio.present? %>
          <div>
            <span class="text-sm font-semibold text-purple-700">Bio</span>
            <p class="text-gray-700 whitespace-pre-wrap"><%= @gwana_network_request.bio %></p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Réseaux sociaux -->
    <% if @gwana_network_request.linkedin_url.present? || @gwana_network_request.twitter_url.present? || @gwana_network_request.website_url.present? %>
      <div class="mb-8">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Réseaux sociaux</h2>
        <div class="space-y-2">
          <% if @gwana_network_request.linkedin_url.present? %>
            <div>
              <span class="text-sm font-semibold text-purple-700">LinkedIn</span>
              <p class="text-gray-700"><%= link_to @gwana_network_request.linkedin_url, @gwana_network_request.linkedin_url, target: "_blank", class: "text-purple-700 hover:underline" %></p>
            </div>
          <% end %>
          <% if @gwana_network_request.twitter_url.present? %>
            <div>
              <span class="text-sm font-semibold text-purple-700">Twitter</span>
              <p class="text-gray-700"><%= link_to @gwana_network_request.twitter_url, @gwana_network_request.twitter_url, target: "_blank", class: "text-purple-700 hover:underline" %></p>
            </div>
          <% end %>
          <% if @gwana_network_request.website_url.present? %>
            <div>
              <span class="text-sm font-semibold text-purple-700">Site web</span>
              <p class="text-gray-700"><%= link_to @gwana_network_request.website_url, @gwana_network_request.website_url, target: "_blank", class: "text-purple-700 hover:underline" %></p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Documents -->
    <div class="mb-8">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Documents</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% if @gwana_network_request.identity_document.attached? %>
          <div>
            <span class="text-sm font-semibold text-purple-700">Carte d'identité / Passeport</span>
            <p class="text-gray-700">
              <%= link_to @gwana_network_request.identity_document.filename, rails_blob_path(@gwana_network_request.identity_document, disposition: "attachment"), class: "text-purple-700 hover:underline", target: "_blank" %>
            </p>
          </div>
        <% end %>
        <% if @gwana_network_request.photo.attached? %>
          <div>
            <span class="text-sm font-semibold text-purple-700">Photo</span>
            <div class="mt-2">
              <%= image_tag @gwana_network_request.photo, class: "w-32 h-32 rounded-full object-cover border-4 border-purple-700/20" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Motif de rejet si refusée -->
    <% if @gwana_network_request.rejected? && @gwana_network_request.rejection_reason.present? %>
      <div class="mb-8 p-4 bg-red-50 border border-red-200 rounded-lg">
        <h3 class="text-sm font-semibold text-red-700 mb-2">Motif du rejet</h3>
        <p class="text-red-600 whitespace-pre-wrap"><%= @gwana_network_request.rejection_reason %></p>
      </div>
    <% end %>

    <!-- Actions -->
    <% if @gwana_network_request.pending? %>
      <div class="flex gap-4 justify-end pt-6 border-t border-gray-200">
        <%= button_to "Approuver", approve_admin_gwana_network_request_path(@gwana_network_request), 
            method: :patch,
            class: "bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-semibold transition-colors" %>
        <button 
            type="button"
            data-action="click->rejection-modal#show"
            class="bg-red-600 hover:bg-red-700 text-white px-6 py-3 rounded-lg font-semibold transition-colors">
          Refuser
        </button>
      </div>
    <% elsif @gwana_network_request.approved? %>
      <div class="pt-6 border-t border-gray-200">
        <p class="text-sm text-gray-600">
          Approuvée par <strong><%= @gwana_network_request.reviewed_by&.email %></strong> 
          le <%= l(@gwana_network_request.reviewed_at, format: :long) if @gwana_network_request.reviewed_at %>
        </p>
      </div>
    <% elsif @gwana_network_request.rejected? %>
      <div class="pt-6 border-t border-gray-200">
        <p class="text-sm text-gray-600">
          Refusée par <strong><%= @gwana_network_request.reviewed_by&.email %></strong> 
          le <%= l(@gwana_network_request.reviewed_at, format: :long) if @gwana_network_request.reviewed_at %>
        </p>
      </div>
    <% end %>
  </div>

  <!-- Modal de rejet -->
  <div 
    data-rejection-modal-target="modal"
    class="hidden fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 z-50"
    aria-labelledby="modal-title"
    role="dialog"
    aria-modal="true">
    <!-- Modal panel - contenu centré avec largeur limitée -->
    <div class="bg-white rounded-lg shadow-xl max-w-lg w-full border border-gray-200">
      <%= form_with url: reject_admin_gwana_network_request_path(@gwana_network_request), method: :patch, local: true, data: { rejection_modal_target: "form" } do |f| %>
        <div class="px-6 py-5">
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-semibold text-gray-900" id="modal-title">Refuser la demande</h3>
            <button 
              type="button"
              data-action="click->rejection-modal#hide"
              class="text-gray-400 hover:text-gray-600 transition-colors">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
          <div class="mb-4">
            <%= f.label :rejection_reason, "Motif du rejet", class: "block text-sm font-semibold text-gray-700 mb-2" %>
            <%= f.text_area :rejection_reason, 
                required: true,
                rows: 5,
                placeholder: "Veuillez indiquer le motif du rejet...",
                class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-700 focus:border-transparent outline-none transition-all" %>
          </div>
        </div>
        <div class="bg-gray-50 px-6 py-4 flex flex-row-reverse gap-3 rounded-b-lg">
          <%= f.submit "Confirmer le rejet", class: "px-4 py-2 bg-red-600 text-white rounded-lg font-semibold hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors" %>
          <button 
              type="button"
              data-action="click->rejection-modal#hide"
              class="px-4 py-2 border border-gray-300 bg-white text-gray-700 rounded-lg font-semibold hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-colors">
            Annuler
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>

