<% content_for :title, @network_event.name %>

<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="bg-white rounded-lg p-8 border border-gray-200 shadow-sm">
    <!-- En-tête avec actions -->
    <div class="flex justify-between items-start mb-8">
      <div>
        <h1 class="text-4xl font-bold text-gray-900 mb-2"><%= @network_event.name %></h1>
        <p class="text-gray-600">
          Date de l'événement : <strong><%= l(@network_event.event_date, format: :long) %></strong>
        </p>
      </div>
      <div class="flex gap-2">
        <%= link_to "Modifier", edit_admin_network_event_path(@network_event), class: "bg-purple-700 hover:bg-purple-800 text-white px-4 py-2 rounded-lg transition-colors" %>
        <%= link_to "Supprimer", admin_network_event_path(@network_event), 
            data: { turbo_method: :delete, turbo_confirm: "Êtes-vous sûr de vouloir supprimer cet événement ?" },
            class: "bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg transition-colors" %>
        <%= link_to "Retour", admin_network_events_path, class: "bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-lg transition-colors" %>
      </div>
    </div>

    <!-- Description -->
    <div class="mb-8 min-w-0 overflow-hidden">
      <h2 class="text-2xl font-semibold text-gray-900 mb-4">Description</h2>
      <div class="text-gray-700 text-base leading-relaxed whitespace-pre-wrap break-words max-w-full">
        <%= simple_format(@network_event.description, {}, wrapper_tag: "div") %>
      </div>
    </div>

    <!-- Photos -->
    <% if @network_event.photos.attached? %>
      <div class="mb-8">
        <h2 class="text-2xl font-semibold text-gray-900 mb-4">Galerie de photos (<%= @network_event.photos.count %>/<%= 30 %>)</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          <% @network_event.photos.each do |photo| %>
            <div class="relative group">
              <%= image_tag photo, class: "w-full h-48 object-cover rounded-lg border border-gray-300 hover:shadow-lg transition-shadow" %>
              <div class="absolute bottom-0 left-0 right-0 bg-black/60 text-white text-xs p-2 rounded-b-lg opacity-0 group-hover:opacity-100 transition-opacity">
                <%= photo.filename %> • <%= number_to_human_size(photo.byte_size) %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="mb-8 p-8 bg-gray-50 rounded-lg border border-gray-200 text-center">
        <p class="text-gray-600">Aucune photo ajoutée pour cet événement.</p>
      </div>
    <% end %>

    <!-- Informations techniques -->
    <div class="mt-8 pt-8 border-t border-gray-200">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Informations</h3>
      <div class="grid grid-cols-2 gap-4 text-sm">
        <div>
          <span class="text-gray-600">Créé le :</span>
          <span class="text-gray-900 ml-2"><%= l(@network_event.created_at, format: :long) %></span>
        </div>
        <div>
          <span class="text-gray-600">Modifié le :</span>
          <span class="text-gray-900 ml-2"><%= l(@network_event.updated_at, format: :long) %></span>
        </div>
        <div>
          <span class="text-gray-600">Nombre de photos :</span>
          <span class="text-gray-900 ml-2"><%= @network_event.photos_count %>/<%= 30 %></span>
        </div>
      </div>
    </div>
  </div>
</div>

