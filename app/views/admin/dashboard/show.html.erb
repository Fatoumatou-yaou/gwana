<% content_for :title, "Tableau de bord Administrateur" %>

<div class="space-y-8">
  <!-- Stats Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <!-- Membres -->
    <div class="group bg-white rounded-2xl shadow-lg p-6 border border-gray-100 hover:shadow-2xl hover:border-purple-700/30 transition-all duration-300 transform hover:-translate-y-1 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-purple-700/5 to-transparent rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      <div class="relative z-10">
      <div class="flex items-center justify-between mb-4">
          <div class="p-3 bg-gradient-to-br from-purple-700/10 to-purple-800/10 rounded-xl group-hover:from-purple-700/20 group-hover:to-purple-800/20 transition-all duration-300">
          <svg class="w-6 h-6 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
        </div>
          <span class="text-xs font-semibold text-green-600 bg-green-50 px-3 py-1.5 rounded-full border border-green-200">Total</span>
        </div>
        <div class="text-4xl font-bold text-gray-900 mb-1"><%= @gwanas_count %></div>
        <div class="text-sm text-gray-600 font-medium">Membres inscrits</div>
      </div>
    </div>

    <!-- GWANA -->
    <div class="group bg-white rounded-2xl shadow-lg p-6 border border-gray-100 hover:shadow-2xl hover:border-amber-500/30 transition-all duration-300 transform hover:-translate-y-1 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-amber-500/5 to-transparent rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      <div class="relative z-10">
      <div class="flex items-center justify-between mb-4">
          <div class="p-3 bg-gradient-to-br from-amber-500/10 to-amber-600/10 rounded-xl group-hover:from-amber-500/20 group-hover:to-amber-600/20 transition-all duration-300">
          <svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
        </div>
          <span class="text-xs font-semibold text-purple-600 bg-purple-50 px-3 py-1.5 rounded-full border border-purple-200">GWANA</span>
        </div>
        <div class="text-4xl font-bold text-gray-900 mb-1"><%= @gwanas_count %></div>
        <div class="text-sm text-gray-600 font-medium">Femmes du réseau</div>
      </div>
    </div>

    <!-- Utilisateurs -->
    <div class="group bg-white rounded-2xl shadow-lg p-6 border border-gray-100 hover:shadow-2xl hover:border-blue-500/30 transition-all duration-300 transform hover:-translate-y-1 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-blue-500/5 to-transparent rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      <div class="relative z-10">
      <div class="flex items-center justify-between mb-4">
          <div class="p-3 bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl group-hover:from-blue-100 group-hover:to-blue-200 transition-all duration-300">
          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
        </div>
          <span class="text-xs font-semibold text-blue-600 bg-blue-50 px-3 py-1.5 rounded-full border border-blue-200">Users</span>
        </div>
        <div class="text-4xl font-bold text-gray-900 mb-1"><%= @users_count %></div>
        <div class="text-sm text-gray-600 font-medium">Utilisateurs actifs</div>
      </div>
    </div>

    <!-- Demandes de mentorat -->
    <div class="group bg-white rounded-2xl shadow-lg p-6 border border-gray-100 hover:shadow-2xl hover:border-orange-500/30 transition-all duration-300 transform hover:-translate-y-1 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-orange-500/5 to-transparent rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      <div class="relative z-10">
      <div class="flex items-center justify-between mb-4">
          <div class="p-3 bg-gradient-to-br from-orange-50 to-orange-100 rounded-xl group-hover:from-orange-100 group-hover:to-orange-200 transition-all duration-300">
          <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
          <span class="text-xs font-semibold text-orange-600 bg-orange-50 px-3 py-1.5 rounded-full border border-orange-200">Total</span>
        </div>
        <div class="text-4xl font-bold text-gray-900 mb-1"><%= @requests_count %></div>
        <div class="text-sm text-gray-600 font-medium">Demandes de mentorat</div>
      </div>
    </div>
  </div>

  <!-- Secondary Stats -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <!-- Demandes en attente -->
    <div class="bg-gradient-to-br from-yellow-50 to-yellow-100 rounded-xl p-6 border border-yellow-200">
      <div class="text-2xl font-bold text-yellow-800 mb-1"><%= @pending_requests %></div>
      <div class="text-sm text-yellow-700 font-medium">En attente</div>
      <div class="text-xs text-yellow-600 mt-1">Demandes de mentorat</div>
    </div>

    <!-- Demandes acceptées -->
    <div class="bg-gradient-to-br from-green-50 to-green-100 rounded-xl p-6 border border-green-200">
      <div class="text-2xl font-bold text-green-800 mb-1"><%= @accepted_requests %></div>
      <div class="text-sm text-green-700 font-medium">Acceptées</div>
      <div class="text-xs text-green-600 mt-1">Mentorats actifs</div>
    </div>

    <!-- Articles publiés -->
    <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl p-6 border border-blue-200">
      <div class="text-2xl font-bold text-blue-800 mb-1"><%= @published_articles %></div>
      <div class="text-sm text-blue-700 font-medium">Articles publiés</div>
      <div class="text-xs text-blue-600 mt-1">Sur <%= @articles_count %> total</div>
    </div>

    <!-- Demandes de mise à jour -->
    <div class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-xl p-6 border border-purple-200">
      <div class="text-2xl font-bold text-purple-800 mb-1"><%= @pending_update_requests_count %></div>
      <div class="text-sm text-purple-700 font-medium">En attente</div>
      <div class="text-xs text-purple-600 mt-1">Mises à jour profil</div>
    </div>
  </div>

  <!-- Charts Section -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Graphique : Demandes de mentorat par région -->
    <div class="bg-white rounded-2xl shadow-lg p-6 md:p-8 border border-gray-100 hover:shadow-xl transition-shadow duration-300">
      <div class="flex items-center gap-3 mb-6">
        <div class="p-2 bg-gradient-to-br from-purple-700/10 to-purple-800/10 rounded-lg">
          <svg class="w-5 h-5 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
        </div>
        <h2 class="text-xl font-bold text-gray-900">Demandes de mentorat par région</h2>
      </div>
      <% if @requests_by_region.any? %>
        <%= pie_chart @requests_by_region,
            donut: true,
            colors: ["rgb(126,34,206)", "rgb(107,33,182)", "rgb(124,58,237)", "rgb(139,92,246)", "rgb(167,139,250)", "rgb(196,181,253)", "rgb(245,158,11)", "rgb(217,119,6)"],
            library: {
              plugins: {
              legend: {
                position: 'left'
                }
              }
            } %>
      <% else %>
        <p class="text-sm text-gray-500 text-center py-8">Aucune donnée disponible</p>
      <% end %>
    </div>

    <!-- Graphique temporel : Évolution des utilisateurs -->
    <div class="bg-white rounded-2xl shadow-lg p-6 md:p-8 border border-gray-100 hover:shadow-xl transition-shadow duration-300">
      <div class="flex items-center gap-3 mb-6">
        <div class="p-2 bg-gradient-to-br from-blue-500/10 to-blue-600/10 rounded-lg">
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
          </svg>
        </div>
        <h2 class="text-xl font-bold text-gray-900">Évolution des utilisateurs</h2>
      </div>
      <% if @users_by_month.any? %>
        <%= line_chart @users_by_month,
            id: "users-evolution-chart",
            colors: ["rgb(107,33,182)"],
            library: {
              plugins: {
                legend: {
                  display: false
                }
              },
              scales: {
                y: {
                  beginAtZero: true,
                  title: {
                    display: true,
                    text: 'Nombre'
                  }
                },
                x: {
                  type: 'time',
                  time: {
                    unit: 'month',
                    displayFormats: {
                      month: 'MMM yyyy'
                    }
                  },
                  title: {
                    display: true,
                    text: 'Date'
                  }
                }
              },
              elements: {
                line: {
                  tension: 0.4
                }
              }
            } %>
      <% else %>
        <p class="text-sm text-gray-500 text-center py-8">Aucune donnée disponible</p>
      <% end %>
    </div>
  </div>

  <!-- Recent Activity -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Demandes récentes -->
    <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100 hover:shadow-xl transition-shadow duration-300">
      <div class="flex items-center justify-between mb-6 pb-4 border-b border-gray-100">
        <h2 class="text-xl font-bold text-gray-900">Demandes récentes</h2>
        <%= link_to admin_mentorship_requests_path, class: "text-sm text-purple-700 hover:text-purple-800 font-semibold flex items-center gap-1 transition-colors" do %>
          Voir tout
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        <% end %>
      </div>
      <div class="space-y-4">
        <% if @recent_requests.any? %>
          <% @recent_requests.each do |request| %>
            <div class="flex items-start justify-between p-4 rounded-xl hover:bg-gray-50 transition-all duration-200 border border-transparent hover:border-gray-200">
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-gray-900 truncate">
                  <%= request.requester.decorate.gwana_profile&.full_name || request.requester.decorate.full_name %>
                </p>
                <p class="text-xs text-gray-500 mt-1.5 flex items-center gap-1">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                  <%= request.mentor.decorate.gwana_profile&.full_name || request.mentor.decorate.full_name %>
                </p>
                <p class="text-xs text-gray-400 mt-1.5 flex items-center gap-1">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <%= l(request.created_at, format: :short) %>
                </p>
              </div>
              <span class="px-3 py-1.5 rounded-full text-xs font-semibold ml-3 flex-shrink-0 <%= 
                case request.status
                when 'pending' then 'bg-yellow-100 text-yellow-800 border border-yellow-200'
                when 'accepted' then 'bg-green-100 text-green-800 border border-green-200'
                when 'rejected' then 'bg-red-100 text-red-800 border border-red-200'
                when 'completed' then 'bg-blue-100 text-blue-800 border border-blue-200'
                else 'bg-gray-100 text-gray-800 border border-gray-200'
                end
              %>">
                <%= request.status.humanize %>
              </span>
            </div>
          <% end %>
        <% else %>
          <p class="text-sm text-gray-500 text-center py-4">Aucune demande récente</p>
        <% end %>
      </div>
    </div>

    <!-- Gwanas récents -->
    <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100 hover:shadow-xl transition-shadow duration-300">
      <div class="flex items-center justify-between mb-6 pb-4 border-b border-gray-100">
        <h2 class="text-xl font-bold text-gray-900">Gwanas récents</h2>
        <%= link_to admin_gwanas_path, class: "text-sm text-purple-700 hover:text-purple-800 font-semibold flex items-center gap-1 transition-colors" do %>
          Voir tout
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        <% end %>
      </div>
      <div class="space-y-4">
        <% if @recent_gwanas.any? %>
          <% @recent_gwanas.each do |gwana| %>
            <div class="flex items-center justify-between p-4 rounded-xl hover:bg-gray-50 transition-all duration-200 border border-transparent hover:border-gray-200">
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-gray-900 truncate"><%= gwana.full_name %></p>
                <p class="text-xs text-gray-500 mt-1.5 truncate"><%= gwana.profession %></p>
                <p class="text-xs text-gray-400 mt-1.5 flex items-center gap-1">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <%= l(gwana.created_at, format: :short) %>
                </p>
              </div>
              <%= link_to admin_gwana_path(gwana.id), class: "text-purple-700 hover:text-purple-800 transition-colors ml-3 flex-shrink-0" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <p class="text-sm text-gray-500 text-center py-4">Aucun membre récent</p>
        <% end %>
      </div>
    </div>

    <!-- Utilisateurs récents -->
    <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100 hover:shadow-xl transition-shadow duration-300">
      <div class="flex items-center justify-between mb-6 pb-4 border-b border-gray-100">
        <h2 class="text-xl font-bold text-gray-900">Utilisateurs récents</h2>
        <%= link_to admin_users_path, class: "text-sm text-purple-700 hover:text-purple-800 font-semibold flex items-center gap-1 transition-colors" do %>
          Voir tout
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        <% end %>
      </div>
      <div class="space-y-4">
        <% if @recent_users.any? %>
          <% @recent_users.each do |user| %>
            <div class="flex items-center justify-between p-4 rounded-xl hover:bg-gray-50 transition-all duration-200 border border-transparent hover:border-gray-200">
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-gray-900 truncate"><%= user.full_name %></p>
                <p class="text-xs text-gray-500 mt-1.5 truncate"><%= user.email %></p>
                <p class="text-xs text-gray-400 mt-1.5 flex items-center gap-1 capitalize">
                  <span class="px-2 py-0.5 bg-gray-100 rounded text-gray-600 text-[10px] font-medium"><%= user.profile %></span>
                  <span>•</span>
                  <span class="flex items-center gap-1">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <%= l(user.created_at, format: :short) %>
                  </span>
                </p>
              </div>
              <%= link_to admin_user_path(user), class: "text-purple-700 hover:text-purple-800 transition-colors ml-3 flex-shrink-0" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <p class="text-sm text-gray-500 text-center py-4">Aucun utilisateur récent</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
