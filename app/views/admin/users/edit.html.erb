<% content_for :title, "Modifier l'utilisateur - #{@user.full_name}" %>

<div class="min-h-screen bg-gradient-to-b from-white to-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto">
    <!-- En-tête -->
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-purple-700 mb-2">Modifier l'utilisateur</h1>
      <p class="text-gray-600">Modification du profil de <strong><%= @user.full_name %></strong></p>
    </div>

    <%= form_with model: [:admin, @user], local: true do |f| %>
      <%= render "shared/error_messages", resource: @user %>

      <div class="bg-white rounded-2xl shadow-xl p-8 md:p-12 relative overflow-hidden border border-gray-100">
        <!-- Eléments décoratifs -->
        <div class="absolute top-0 right-0 w-32 h-32 bg-purple-700/10 rounded-full -mr-16 -mt-16 pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 w-40 h-40 bg-purple-700/5 rounded-full -ml-20 -mb-20 pointer-events-none"></div>

        <div class="relative z-10 space-y-8">
          <!-- Section 1 : Informations personnelles -->
          <div>
            <h2 class="text-xl font-bold text-gray-900 mb-4 pb-2 border-b border-gray-200 flex items-center gap-2">
              <svg class="w-5 h-5 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              Informations personnelles
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <%= f.label :first_name, "Prénom", class: "block text-sm font-semibold text-purple-700 mb-2" %>
                <%= f.text_field :first_name, 
                    required: true,
                    placeholder: "Prénom", 
                    class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-700 focus:border-transparent outline-none transition-all bg-white" %>
              </div>

              <div>
                <%= f.label :last_name, "Nom", class: "block text-sm font-semibold text-purple-700 mb-2" %>
                <%= f.text_field :last_name, 
                    required: true,
                    placeholder: "Nom", 
                    class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-700 focus:border-transparent outline-none transition-all bg-white" %>
              </div>

              <div>
                <%= f.label :email, "Adresse Email", class: "block text-sm font-semibold text-purple-700 mb-2" %>
                <%= f.email_field :email, 
                    required: true,
                    placeholder: "email@exemple.com", 
                    class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-700 focus:border-transparent outline-none transition-all bg-white" %>
              </div>

              <div>
                <%= f.label :gender, "Genre", class: "block text-sm font-semibold text-purple-700 mb-2" %>
                <%= f.select :gender, 
                    options_for_select([
                      ["Femme", "female"],
                      ["Homme", "male"],
                      ["Autre", "other"]
                    ], @user.gender),
                    {},
                    { class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-700 focus:border-transparent outline-none transition-all bg-white" } %>
              </div>
            </div>
          </div>

          <!-- Section 2 : Téléphone et Localisation -->
          <div>
            <h2 class="text-xl font-bold text-gray-900 mb-4 pb-2 border-b border-gray-200 flex items-center gap-2">
              <svg class="w-5 h-5 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              Coordonnées de contact
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <%= f.label :country_code, "Indicatif pays", class: "block text-sm font-semibold text-purple-700 mb-2" %>
                <%= f.text_field :country_code, 
                    placeholder: "+223", 
                    class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-700 focus:border-transparent outline-none transition-all bg-white" %>
              </div>

              <div>
                <%= f.label :phone, "Numéro de téléphone", class: "block text-sm font-semibold text-purple-700 mb-2" %>
                <%= f.telephone_field :phone, 
                    placeholder: "12345678", 
                    class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-700 focus:border-transparent outline-none transition-all bg-white" %>
              </div>
            </div>
          </div>

          <!-- Section 3 : Rôle et Statut du compte -->
          <div>
            <h2 class="text-xl font-bold text-gray-900 mb-4 pb-2 border-b border-gray-200 flex items-center gap-2">
              <svg class="w-5 h-5 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              Rôle et Statut
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <%= f.label :profile, "Rôle sur la plateforme", class: "block text-sm font-semibold text-purple-700 mb-2" %>
                <%= f.select :profile, 
                    options_for_select([
                      ["Utilisateur", "user"],
                      ["Gwana", "gwana"],
                      ["Administrateur", "admin"]
                    ], @user.profile),
                    {},
                    { class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-700 focus:border-transparent outline-none transition-all bg-white" } %>
              </div>

              <div>
                <%= f.label :is_verified, "Statut de vérification", class: "block text-sm font-semibold text-purple-700 mb-2" %>
                <%= f.select :is_verified, 
                    options_for_select([
                      ["Non vérifié", false],
                      ["Vérifié", true]
                    ], @user.is_verified?),
                    {},
                    { class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-700 focus:border-transparent outline-none transition-all bg-white" } %>
              </div>
            </div>
          </div>

          <!-- Section 4 : Modification du mot de passe (Optionnel) -->
          <div>
            <h2 class="text-xl font-bold text-gray-900 mb-2 pb-2 border-b border-gray-200 flex items-center gap-2">
              <svg class="w-5 h-5 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
              Sécurité du compte (Optionnel)
            </h2>
            <p class="text-xs text-gray-500 mb-4">Laissez ces champs vides si vous ne souhaitez pas modifier le mot de passe de l'utilisateur.</p>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <%= f.label :password, "Nouveau mot de passe", class: "block text-sm font-semibold text-purple-700 mb-2" %>
                <%= f.password_field :password, 
                    autocomplete: "new-password",
                    placeholder: "••••••••••••", 
                    class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-700 focus:border-transparent outline-none transition-all bg-white" %>
              </div>

              <div>
                <%= f.label :password_confirmation, "Confirmation du mot de passe", class: "block text-sm font-semibold text-purple-700 mb-2" %>
                <%= f.password_field :password_confirmation, 
                    autocomplete: "new-password",
                    placeholder: "••••••••••••", 
                    class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-700 focus:border-transparent outline-none transition-all bg-white" %>
              </div>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex flex-col sm:flex-row justify-center gap-4 mt-8 pt-4">
            <%= f.submit "Enregistrer les modifications", 
                class: "bg-gradient-to-r from-purple-700 to-purple-800 hover:from-purple-800 hover:to-purple-700 text-white font-bold py-4 px-8 rounded-lg transition-all shadow-lg transform hover:scale-105 flex items-center justify-center gap-2 cursor-pointer" %>
            <%= link_to "Annuler", admin_user_path(@user), class: "bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold py-4 px-8 rounded-lg transition-all text-center flex items-center justify-center" %>
          </div>
        </div>
      </div>
    <% end %>

    <div class="text-center mt-6">
      <%= link_to "← Retour à la liste", admin_users_path, class: "text-purple-700 hover:text-purple-600 transition-colors font-medium" %>
    </div>
  </div>
</div>
