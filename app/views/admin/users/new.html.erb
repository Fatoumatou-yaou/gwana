<% content_for :title, "Créer un compte #{@profile.capitalize}" %>

<div class="min-h-screen bg-gradient-to-b from-white to-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-purple-700 mb-2">Créer un compte <%= @profile.capitalize %></h1>
      <p class="text-gray-600">Ajouter un nouveau compte <%= @profile == "gwana" ? "gwana" : "administrateur" %> à la plateforme</p>
    </div>

    <%= form_with model: [:admin, @user], local: true do |f| %>
      <%= render "shared/error_messages", resource: @user %>

      <div class="bg-white rounded-2xl shadow-xl p-8 md:p-12 relative overflow-hidden">
        <!-- Decorative shapes -->
        <div class="absolute top-0 right-0 w-32 h-32 bg-purple-700/10 rounded-full -mr-16 -mt-16"></div>
        <div class="absolute bottom-0 left-0 w-40 h-40 bg-purple-700/5 rounded-full -ml-20 -mb-20"></div>

        <div class="relative z-10">
          <!-- Profile selection (only if not already set) -->
          <% unless @profile.present? %>
            <div class="mb-6">
              <%= f.label :profile, "Type de compte", class: "block text-sm font-semibold text-purple-700 mb-2" %>
              <%= f.select :profile, 
                  options_for_select([["Gwana", "gwana"], ["Administrateur", "admin"]], @user.profile),
                  {},
                  { class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-700 focus:border-transparent outline-none transition-all" } %>
            </div>
          <% else %>
            <%= f.hidden_field :profile, value: @profile %>
          <% end %>

          <!-- Informations personnelles -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <div>
              <%= f.label :first_name, "Prénom", class: "block text-sm font-semibold text-purple-700 mb-2" %>
              <%= f.text_field :first_name, 
                  required: true,
                  placeholder: "Prénom", 
                  class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-700 focus:border-transparent outline-none transition-all" %>
            </div>

            <div>
              <%= f.label :last_name, "Nom", class: "block text-sm font-semibold text-purple-700 mb-2" %>
              <%= f.text_field :last_name, 
                  required: true,
                  placeholder: "Nom", 
                  class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-700 focus:border-transparent outline-none transition-all" %>
            </div>
          </div>

          <!-- Email -->
          <div class="mb-6">
            <%= f.label :email, "Email", class: "block text-sm font-semibold text-purple-700 mb-2" %>
            <%= f.email_field :email, 
                required: true,
                placeholder: "email@exemple.com", 
                class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-700 focus:border-transparent outline-none transition-all" %>
          </div>

          <!-- Téléphone (optionnel) -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <div>
              <%= f.label :country_code, "Code pays", class: "block text-sm font-semibold text-purple-700 mb-2" %>
              <%= f.text_field :country_code, 
                  placeholder: "+223", 
                  class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-700 focus:border-transparent outline-none transition-all" %>
            </div>

            <div>
              <%= f.label :phone, "Téléphone", class: "block text-sm font-semibold text-purple-700 mb-2" %>
              <%= f.telephone_field :phone, 
                  placeholder: "12345678", 
                  class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-700 focus:border-transparent outline-none transition-all" %>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex justify-center gap-4 mt-8">
            <%= f.submit "Créer le compte", 
                class: "bg-gradient-to-r from-purple-700 to-purple-800 hover:from-purple-800 hover:to-purple-700 text-white font-bold py-4 px-12 rounded-lg transition-all shadow-lg transform hover:scale-105 flex items-center gap-2" %>
            <%= link_to "Annuler", admin_users_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold py-4 px-12 rounded-lg transition-all" %>
          </div>
        </div>
      </div>
    <% end %>

    <div class="text-center mt-6">
      <%= link_to "← Retour à la liste", admin_users_path, class: "text-purple-700 hover:text-purple-600 transition-colors" %>
    </div>
  </div>
</div>

