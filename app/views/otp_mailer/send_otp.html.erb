  <body>
    <h1>Code de vérification Gwana</h1>
    <p>Bonjour <%= @user.full_name %>,</p>
    <p>Votre code de vérification est : <strong style="font-size: 24px; color: rgb(107, 13, 173);"><%= @otp %></strong></p>
