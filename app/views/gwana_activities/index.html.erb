<% content_for :title, "Activités des Gwanas" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
  <!-- Header -->
  <div class="text-center mb-12">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4 text-purple-600">
      Activités des Gwanas
    </h1>
    <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
      Découvrez toutes les activités réalisées par les membres du réseau GWANA
    </p>
  </div>

  <!-- Activities Grid -->
  <% if @activities.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      <% @activities.each do |activity| %>
        <%= link_to gwana_activity_path(activity), class: "group relative overflow-hidden rounded-xl bg-gradient-to-br from-white to-gray-50 border border-purple-700/20 hover:border-purple-700/50 transition-all duration-500 transform hover:scale-[1.02] hover:shadow-xl hover:shadow-purple-700/10 block" do %>
          <article class="w-full">
          <!-- Media Container -->
          <div class="relative h-48 overflow-hidden bg-gray-200 rounded-t-xl">
            <% if activity.has_video? %>
              <img src="<%= activity.youtube_thumbnail_url %>" 
                   alt="<%= activity.description.truncate(50) %>" 
                   class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              <button 
                type="button"
                class="absolute inset-0 bg-black/30 flex items-center justify-center hover:bg-black/40 transition-colors"
                data-action="click->youtube-modal#open"
                data-youtube-modal-url-param="<%= activity.youtube_embed_url %>"
              >
                <div class="w-16 h-16 bg-red-600 rounded-full flex items-center justify-center hover:bg-red-700 transition-colors">
                  <svg class="w-8 h-8 text-white ml-1" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/>
                  </svg>
                </div>
              </button>
            <% elsif activity.has_photos? %>
              <%= image_tag activity.photos.first, 
                  alt: activity.description.truncate(50), 
                  class: "w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" %>
              <% if activity.photos.count > 1 %>
                <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-semibold text-purple-700">
                  +<%= activity.photos.count - 1 %>
                </div>
              <% end %>
            <% else %>
              <div class="w-full h-full bg-gradient-to-br from-purple-700/30 to-blue-500/30 flex items-center justify-center">
                <svg class="w-16 h-16 text-purple-700/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
              </div>
            <% end %>

            <!-- Activity Type Badge -->
            <div class="absolute top-4 left-4">
              <span class="px-3 py-1 bg-purple-700/80 backdrop-blur-md text-white text-xs font-semibold rounded-full border border-white/20 shadow-lg">
                <%= activity.activity_type.humanize %>
              </span>
            </div>
          </div>

          <!-- Content -->
          <div class="p-5 overflow-hidden">
            <div class="flex items-center gap-2 mb-3 text-xs text-gray-500 flex-wrap">
              <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              <span class="truncate"><%= activity.gwana.full_name %></span>
              <span class="text-gray-400 flex-shrink-0">•</span>
              <time datetime="<%= activity.created_at.iso8601 %>" class="whitespace-nowrap">
                <%= l(activity.created_at, format: :short) %>
              </time>
            </div>

            <p class="text-gray-700 text-sm mb-4 line-clamp-3 leading-relaxed break-words overflow-hidden">
              <%= activity.description %>
            </p>

            <!-- View Details Link -->
            <%= link_to gwana_activity_path(activity), 
                class: "text-purple-700 text-sm font-semibold hover:text-purple-800 transition-colors inline-flex items-center gap-2" do %>
              <span>Voir les détails</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            <% end %>
          </div>

          <!-- Shine effect on hover -->
          <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-1000 pointer-events-none"></div>
          </article>
        <% end %>
      <% end %>
    </div>

    <!-- Pagination -->
    <% if @pagy.pages > 1 %>
      <div class="mt-12 flex justify-center">
        <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-12">
      <svg class="w-24 h-24 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      <p class="text-gray-500 text-lg">Aucune activité disponible pour le moment.</p>
    </div>
  <% end %>
</div>

<%= render "shared/youtube_modal" %>

