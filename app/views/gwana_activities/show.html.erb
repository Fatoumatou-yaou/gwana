<% content_for :title, "Activité - #{@activity.activity_type.humanize}" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
  <!-- Breadcrumb -->
  <nav class="mb-8" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-gray-600">
      <li>
        <%= link_to "Accueil", root_path, class: "hover:text-purple-700 transition-colors" %>
      </li>
      <li>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </li>
      <li>
        <%= link_to "Activités des Gwanas", gwana_activities_path, class: "hover:text-purple-700 transition-colors" %>
      </li>
      <li>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </li>
      <li class="text-gray-900 font-medium truncate max-w-xs"><%= @activity.activity_type.humanize %></li>
    </ol>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Content -->
    <div class="lg:col-span-2">
      <article class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
        <!-- Header -->
        <div class="px-6 md:px-10 pt-8 md:pt-12 pb-6 border-b border-gray-100">
          <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
            <span class="text-sm font-semibold text-purple-700 bg-purple-700/10 px-4 py-2 rounded-full border border-purple-700/20">
              <%= @activity.activity_type.humanize %>
            </span>
            <time datetime="<%= @activity.created_at.iso8601 %>" class="text-sm text-gray-500 flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <%= l(@activity.created_at, format: :long) %>
            </time>
          </div>
        </div>

        <!-- Media Section -->
        <% if @activity.has_video? %>
          <div class="w-full bg-black rounded-lg overflow-hidden">
            <div class="relative aspect-video">
              <iframe 
                src="<%= @activity.youtube_embed_url %>" 
                frameborder="0"
                allow="autoplay; encrypted-media; picture-in-picture"
                allowfullscreen
                class="w-full h-full"
              ></iframe>
            </div>
          </div>
        <% elsif @activity.has_photos? %>
          <div class="px-6 md:px-10 py-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <% @activity.photos.each do |photo| %>
                <%= image_tag photo, class: "w-full h-auto rounded-lg border border-gray-200 shadow-md" %>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Description -->
        <div class="px-6 md:px-10 pb-8 md:pb-12">
          <div class="text-gray-700 text-lg leading-relaxed whitespace-pre-wrap">
            <%= simple_format(@activity.description, {}, wrapper_tag: "div") %>
          </div>
        </div>
      </article>
    </div>

    <!-- Sidebar - Gwana Info -->
    <div class="lg:col-span-1">
      <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100 sticky top-6">
        <!-- Gwana Header -->
        <div class="bg-gradient-to-br from-purple-700 to-purple-800 p-6 text-center">
          <% if @activity.gwana.photo.attached? %>
            <%= image_tag @activity.gwana.photo, alt: @activity.gwana.full_name, class: "w-24 h-24 rounded-full mx-auto mb-4 object-cover border-4 border-white/50 shadow-lg" %>
          <% else %>
            <div class="w-24 h-24 rounded-full mx-auto mb-4 bg-white/20 flex items-center justify-center border-4 border-white/50 shadow-lg">
              <div class="text-3xl font-bold text-white">
                <%= @activity.gwana.first_name[0].upcase %><%= @activity.gwana.last_name[0].upcase %>
              </div>
            </div>
          <% end %>
          <h3 class="text-xl font-bold text-white mb-2"><%= @activity.gwana.full_name %></h3>
          <% if @activity.gwana.profession.present? %>
            <p class="text-purple-200 text-sm"><%= @activity.gwana.profession %></p>
          <% end %>
        </div>

        <!-- Gwana Details -->
        <div class="p-6 space-y-6">
          <!-- Formations -->
          <% if @activity.gwana.formations.present? %>
            <div>
              <h4 class="text-sm font-semibold text-purple-700 mb-3 flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
                Formations
              </h4>
              <div class="text-gray-700 text-sm leading-relaxed">
                <%= simple_format(@activity.gwana.formations, {}, wrapper_tag: "div") %>
              </div>
            </div>
          <% end %>

          <!-- Bio -->
          <% if @activity.gwana.bio.present? %>
            <div>
              <h4 class="text-sm font-semibold text-purple-700 mb-3 flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                À propos
              </h4>
              <div class="text-gray-700 text-sm leading-relaxed line-clamp-4">
                <%= truncate(@activity.gwana.bio, length: 200) %>
              </div>
            </div>
          <% end %>

          <!-- View Profile Link -->
          <div class="pt-4 border-t border-gray-200">
            <%= link_to gwana_path(@activity.gwana.object), class: "block w-full text-center bg-purple-700 hover:bg-purple-800 text-white px-6 py-3 rounded-lg transition-colors font-semibold" do %>
              Voir le profil complet
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

