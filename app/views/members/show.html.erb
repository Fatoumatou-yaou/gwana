<% content_for :title, @member.full_name %>

<div class="max-w-4xl mx-auto">
  <div class="bg-[#0B0B0B] rounded-lg p-8 border border-[#6A0DAD]/20">
    <div class="text-center mb-8">
      <% if @member.photo.attached? %>
        <%= image_tag @member.photo, alt: @member.full_name, class: "w-32 h-32 rounded-full mx-auto mb-4 object-cover" %>
      <% else %>
        <div class="w-32 h-32 rounded-full mx-auto mb-4 bg-[#6A0DAD] flex items-center justify-center text-4xl font-bold text-white">
          <%= @member.first_name[0].upcase %><%= @member.last_name[0].upcase %>
        </div>
      <% end %>
      <h1 class="text-4xl font-bold text-[#D4AF37] mb-2"><%= @member.full_name %></h1>
      <p class="text-xl text-gray-300 mb-2"><%= @member.profession %></p>
      <p class="text-gray-400"><%= @member.region %></p>
      <% if @member.available_for_mentorship? %>
        <span class="inline-block bg-[#6A0DAD]/20 text-[#D4AF37] text-sm px-4 py-2 rounded-full mt-4"><%= t("members.available") %></span>
      <% end %>
    </div>

    <% if @member.bio.present? %>
      <div class="mb-8">
        <h2 class="text-2xl font-semibold mb-4"><%= t("members.bio") %></h2>
        <p class="text-gray-300 leading-relaxed"><%= simple_format(@member.bio) %></p>
      </div>
    <% end %>

    <% if @member.skills.present? %>
      <div class="mb-8">
        <h2 class="text-2xl font-semibold mb-4"><%= t("members.skills") %></h2>
        <div class="flex flex-wrap gap-2">
          <% @member.skills_array.each do |skill| %>
            <span class="bg-[#6A0DAD]/20 text-[#D4AF37] px-3 py-1 rounded-full text-sm"><%= skill %></span>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="flex justify-center space-x-4">
      <% if @member.linkedin_url.present? %>
        <%= link_to @member.linkedin_url, target: "_blank", rel: "noopener", class: "text-[#D4AF37] hover:text-[#B8860B] transition-colors" do %>
          <span class="sr-only">LinkedIn</span>
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
        <% end %>
      <% end %>
      <% if @member.twitter_url.present? %>
        <%= link_to @member.twitter_url, target: "_blank", rel: "noopener", class: "text-[#D4AF37] hover:text-[#B8860B] transition-colors" do %>
          <span class="sr-only">Twitter</span>
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/></svg>
        <% end %>
      <% end %>
      <% if @member.website_url.present? %>
        <%= link_to @member.website_url, target: "_blank", rel: "noopener", class: "text-[#D4AF37] hover:text-[#B8860B] transition-colors" do %>
          <span class="sr-only">Website</span>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
        <% end %>
      <% end %>
    </div>

    <% if user_signed_in? && current_user.member? && @member.available_for_mentorship? && @member.user != current_user %>
      <div class="mt-8 text-center">
        <%= link_to t("members.request_mentorship"), new_mentorship_request_path(mentor_id: @member.user_id), class: "bg-[#6A0DAD] hover:bg-[#5B21B6] text-white px-6 py-3 rounded-lg transition-colors" %>
      </div>
    <% end %>
  </div>
</div>
