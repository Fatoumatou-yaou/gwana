<% content_for :title, t("navigation.members") %>

<div class="max-w-7xl mx-auto">
  <h1 class="text-4xl font-bold mb-8 text-[#D4AF37]"><%= t("navigation.members") %></h1>

  <!-- Search and Filters -->
  <div class="bg-[#0B0B0B] rounded-lg p-6 mb-8 border border-[#6A0DAD]/20">
    <%= form_with url: members_path, method: :get, local: true, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="md:col-span-2">
          <%= f.text_field :search, placeholder: t("members.search_placeholder"), value: params[:search], class: "w-full px-4 py-2 bg-[#111111] border border-[#6A0DAD]/20 rounded-lg text-white focus:outline-none focus:border-[#6A0DAD]" %>
        </div>
        <div>
          <%= f.select :region, options_for_select([["Toutes les régions", ""]] + Member.distinct.pluck(:region).compact.map { |r| [r, r] }, params[:region]), {}, { class: "w-full px-4 py-2 bg-[#111111] border border-[#6A0DAD]/20 rounded-lg text-white focus:outline-none focus:border-[#6A0DAD]" } %>
        </div>
        <div>
          <%= f.submit t("members.search"), class: "w-full bg-[#6A0DAD] hover:bg-[#5B21B6] text-white px-4 py-2 rounded-lg transition-colors" %>
        </div>
      </div>
      <div class="flex items-center">
        <%= f.check_box :available, { checked: params[:available] == "true" }, "true", "" %>
        <%= f.label :available, t("members.available_only"), class: "ml-2 text-gray-300" %>
      </div>
    <% end %>
  </div>

  <!-- Members Grid -->
  <% if @members.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @members.each do |member| %>
        <div class="bg-[#0B0B0B] rounded-lg p-6 border border-[#6A0DAD]/20 hover:border-[#6A0DAD]/40 transition-all">
          <% if member.photo.attached? %>
            <%= image_tag member.photo, alt: member.full_name, class: "w-24 h-24 rounded-full mx-auto mb-4 object-cover" %>
          <% else %>
            <div class="w-24 h-24 rounded-full mx-auto mb-4 bg-[#6A0DAD] flex items-center justify-center text-2xl font-bold text-white">
              <%= member.first_name[0].upcase %><%= member.last_name[0].upcase %>
            </div>
          <% end %>
          <h3 class="text-xl font-semibold text-center mb-2">
            <%= link_to member.full_name, member_path(member), class: "hover:text-[#D4AF37] transition-colors" %>
          </h3>
          <p class="text-gray-400 text-center text-sm mb-2"><%= member.profession %></p>
          <p class="text-gray-500 text-center text-xs mb-4"><%= member.region %></p>
          <% if member.available_for_mentorship? %>
            <span class="inline-block bg-[#6A0DAD]/20 text-[#D4AF37] text-xs px-2 py-1 rounded-full"><%= t("members.available") %></span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12 text-gray-400">
      <p><%= t("members.no_results") %></p>
    </div>
  <% end %>
</div>
