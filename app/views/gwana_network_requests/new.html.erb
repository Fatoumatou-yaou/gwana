<% content_for :title, "Rejoindre le réseau GWANA" %>

<div class="max-w-5xl mx-auto px-4 py-2">
  <h1 class="text-3xl font-bold mb-4 text-purple-700 text-center">Rejoindre le réseau</h1>
  
  <div class="mb-6 p-4 bg-blue-50 border-l-4 border-blue-500 rounded-r-lg">
    <p class="text-sm text-blue-800">
      <strong>Information importante :</strong> Veuillez remplir tous les champs obligatoires (marqués d'une étoile <span class="text-red-500">*</span>) et soumettre votre demande. Vous recevrez une réponse par email dans un délai d'un mois.
    </p>
  </div>

  <%= form_with model: @gwana_network_request, url: gwana_network_requests_path, multipart: true, class: "space-y-6" do |f| %>
    <%= render MultiStepFormComponent.new(
      form_builder: f,
      model: @gwana_network_request,
      regions: @regions,
      departments: @departments,
      communes: @communes,
      show_identity_document: true,
      submit_label: "Envoyer la demande",
      cancel_path: root_path,
      cancel_label: "Annuler"
    ) %>
  <% end %>
</div>

