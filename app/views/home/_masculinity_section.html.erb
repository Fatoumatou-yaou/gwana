<!-- Masculinity Section -->
<section class="mb-20" aria-labelledby="masculinity-title">
  <!-- Title and Description - En dehors du fond coloré -->
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 id="masculinity-title" class="text-5xl md:text-6xl lg:text-7xl font-bold mb-6 bg-gradient-to-r from-gray-900 via-purple-700 to-gray-900 bg-clip-text text-transparent">
        Masculinité Positive
      </h2>
      <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
        L'égalité des genres est l'affaire de tous. Nous croyons en une masculinité positive qui soutient, respecte et promeut l'autonomisation des femmes. Ensemble, hommes et femmes, nous construisons un Niger plus équitable.
      </p>
    </div>
  </div>

  <!-- Contenu principal avec fond coloré -->
  <div class="relative py-20 bg-gradient-to-br from-slate-800 via-slate-700 to-slate-800 overflow-hidden">
    <!-- Background geometric shapes -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <!-- Large blurred shape in top left -->
      <div class="absolute -top-40 -left-40 w-[600px] h-[600px] rounded-full bg-blue-500 opacity-12 blur-3xl"></div>
      
      <!-- Medium blurred shape in bottom right -->
      <div class="absolute -bottom-40 -right-40 w-[500px] h-[500px] rounded-full bg-purple-700 opacity-18 blur-3xl"></div>
      
      <!-- Additional subtle blurred shape for depth -->
      <div class="absolute top-1/2 -right-20 w-[400px] h-[400px] rounded-full bg-blue-500 opacity-10 blur-3xl"></div>
      
      <!-- Decorative geometric elements -->
      <svg 
        class="absolute top-10 right-10 w-[200px] h-[200px] opacity-8"
        viewBox="0 0 200 200"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <linearGradient id="ringGradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:rgb(255, 255, 255);stop-opacity:0.3" />
            <stop offset="100%" style="stop-color:rgb(255, 255, 255);stop-opacity:0.1" />
          </linearGradient>
        </defs>
        <!-- Outer ring with gradient -->
        <circle
          cx="100"
          cy="100"
          r="90"
          fill="none"
          stroke="url(#ringGradient)"
          stroke-width="2"
        />
        <!-- Inner ring -->
        <circle
          cx="100"
          cy="100"
          r="60"
          fill="none"
          stroke="rgb(255, 255, 255)"
          stroke-width="1.5"
          opacity="0.15"
        />
      </svg>
      
      <!-- Bottom left decorative element -->
      <svg 
        class="absolute bottom-10 -left-10 w-[150px] h-[150px] opacity-6"
        viewBox="0 0 150 150"
        xmlns="http://www.w3.org/2000/svg"
      >
        <circle
          cx="75"
          cy="75"
          r="70"
          fill="none"
          stroke="rgb(255, 255, 255)"
          stroke-width="1.5"
          opacity="0.2"
        />
      </svg>
      
      <!-- Subtle grid pattern overlay -->
      <div class="absolute inset-0 opacity-[0.02]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 50px 50px;"></div>
    </div>

    <!-- Content -->
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Cards Grid - 3 cards principales pour meilleure lisibilité -->
      <div class="relative max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
          <!-- Card 1: Solidarité -->
          <div class="relative rounded-xl overflow-hidden transform hover:scale-105 transition-all duration-300 shadow-xl hover:shadow-2xl group h-[450px]">
            <!-- Background Image -->
            <div class="absolute inset-0">
              <%= image_tag "masculinity1.jpeg", alt: "Modèle de masculinité positive - Solidarité", class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" %>
            </div>
            <!-- Gradient Overlay - Bleu -->
            <div class="absolute inset-0 bg-gradient-to-t from-blue-500/95 via-blue-500/80 to-blue-500/60"></div>
            <!-- Content -->
            <div class="relative z-10 h-full flex flex-col justify-end p-6 md:p-8 text-white">
              <h3 class="text-2xl md:text-3xl font-bold mb-4">
                Solidarité
              </h3>
              <p class="text-white/95 leading-relaxed text-sm md:text-base">
                S'engager aux côtés des femmes pour créer un environnement professionnel inclusif et respectueux où chacun peut s'épanouir.
              </p>
            </div>
          </div>

          <!-- Card 2: Respect -->
          <div class="relative rounded-xl overflow-hidden transform hover:scale-105 transition-all duration-300 shadow-xl hover:shadow-2xl group h-[450px]">
            <!-- Background Image -->
            <div class="absolute inset-0">
              <%= image_tag "masculinity2.png", alt: "Modèle de masculinité positive - Respect", class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" %>
            </div>
            <!-- Gradient Overlay - Violet -->
            <div class="absolute inset-0 bg-gradient-to-t from-purple-700/95 via-purple-700/80 to-purple-700/60"></div>
            <!-- Content -->
            <div class="relative z-10 h-full flex flex-col justify-end p-6 md:p-8 text-white">
              <h3 class="text-2xl md:text-3xl font-bold mb-4">
                Respect
              </h3>
              <p class="text-white/95 leading-relaxed text-sm md:text-base">
                Reconnaître et valoriser les compétences, l'expertise et les contributions des femmes dans tous les domaines professionnels.
              </p>
            </div>
          </div>

          <!-- Card 3: Soutien Actif -->
          <div class="relative rounded-xl overflow-hidden transform hover:scale-105 transition-all duration-300 shadow-xl hover:shadow-2xl group h-[450px]">
            <!-- Background Image -->
            <div class="absolute inset-0">
              <%= image_tag "masculinity3.png", alt: "Modèle de masculinité positive - Soutien Actif", class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" %>
            </div>
            <!-- Gradient Overlay - Or -->
            <div class="absolute inset-0 bg-gradient-to-t from-amber-500/95 via-amber-500/80 to-amber-500/60"></div>
            <!-- Content -->
            <div class="relative z-10 h-full flex flex-col justify-end p-6 md:p-8 text-white">
              <h3 class="text-2xl md:text-3xl font-bold mb-4">
                Soutien Actif
              </h3>
              <p class="text-white/95 leading-relaxed text-sm md:text-base">
                Agir concrètement pour soutenir les initiatives d'autonomisation et créer des opportunités équitables pour toutes et tous.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Carrousel pour les 3 autres cards -->
      <div class="mt-20 max-w-5xl mx-auto">
        <h3 class="text-3xl md:text-4xl font-bold text-white text-center mb-12">
          Découvrez d'autres valeurs
        </h3>
      </div>
      
      <div class="mt-8 max-w-5xl mx-auto relative" 
           data-controller="masculinity-carousel"
           data-action="mouseenter->masculinity-carousel#pauseAutoPlay mouseleave->masculinity-carousel#resumeAutoPlay">
        <!-- Navigation Arrows -->
        <button data-action="click->masculinity-carousel#previous" 
                class="absolute left-0 top-1/2 -translate-y-1/2 z-20 w-14 h-14 rounded-full bg-white/20 backdrop-blur-md border border-white/30 shadow-lg flex items-center justify-center text-white hover:bg-white/30 hover:border-white/50 hover:scale-110 transition-all duration-300">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        
        <button data-action="click->masculinity-carousel#next" 
                class="absolute right-0 top-1/2 -translate-y-1/2 z-20 w-14 h-14 rounded-full bg-white/20 backdrop-blur-md border border-white/30 shadow-lg flex items-center justify-center text-white hover:bg-white/30 hover:border-white/50 hover:scale-110 transition-all duration-300">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        <!-- Carousel Track -->
        <div class="overflow-hidden py-12 px-12 md:px-20">
          <div class="masculinity-carousel-track flex transition-transform duration-700 ease-out gap-8" 
               data-masculinity-carousel-target="track">
            <!-- Card 4: Égalité -->
            <div class="flex-shrink-0" data-masculinity-carousel-target="card" data-index="0">
              <div class="relative rounded-xl overflow-hidden transform hover:scale-105 transition-all duration-300 shadow-xl hover:shadow-2xl group h-[450px]">
                <!-- Background Image -->
                <div class="absolute inset-0">
                  <%= image_tag "masculinity4.png", alt: "Modèle de masculinité positive - Égalité", class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" %>
                </div>
                <!-- Gradient Overlay - Violet foncé -->
                <div class="absolute inset-0 bg-gradient-to-t from-purple-800/95 via-purple-800/80 to-purple-800/60"></div>
                <!-- Content -->
                <div class="relative z-10 h-full flex flex-col justify-end p-6 md:p-8 text-white">
                  <h3 class="text-2xl md:text-3xl font-bold mb-4">
                    Égalité
                  </h3>
                  <p class="text-white/95 leading-relaxed text-sm md:text-base">
                    Promouvoir l'égalité des chances et lutter contre les stéréotypes de genre qui limitent le potentiel des femmes.
                  </p>
                </div>
              </div>
            </div>

            <!-- Card 5: Mentorat -->
            <div class="flex-shrink-0" data-masculinity-carousel-target="card" data-index="1">
              <div class="relative rounded-xl overflow-hidden transform hover:scale-105 transition-all duration-300 shadow-xl hover:shadow-2xl group h-[450px]">
                <!-- Background Image -->
                <div class="absolute inset-0">
                  <%= image_tag "masculinity5.png", alt: "Modèle de masculinité positive - Mentorat", class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" %>
                </div>
                <!-- Gradient Overlay - Or -->
                <div class="absolute inset-0 bg-gradient-to-t from-amber-500/95 via-amber-500/80 to-amber-500/60"></div>
                <!-- Content -->
                <div class="relative z-10 h-full flex flex-col justify-end p-6 md:p-8 text-white">
                  <h3 class="text-2xl md:text-3xl font-bold mb-4">
                    Mentorat
                  </h3>
                  <p class="text-white/95 leading-relaxed text-sm md:text-base">
                    Encourager et faciliter le mentorat croisé, où hommes et femmes partagent leurs connaissances et expériences.
                  </p>
                </div>
              </div>
            </div>

            <!-- Card 6: Changement -->
            <div class="flex-shrink-0" data-masculinity-carousel-target="card" data-index="2">
              <div class="relative rounded-xl overflow-hidden transform hover:scale-105 transition-all duration-300 shadow-xl hover:shadow-2xl group h-[450px]">
                <!-- Background Image -->
                <div class="absolute inset-0">
                  <%= image_tag "masculinity6.png", alt: "Modèle de masculinité positive - Changement", class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" %>
                </div>
                <!-- Gradient Overlay - Bleu -->
                <div class="absolute inset-0 bg-gradient-to-t from-blue-500/95 via-blue-500/80 to-blue-500/60"></div>
                <!-- Content -->
                <div class="relative z-10 h-full flex flex-col justify-end p-6 md:p-8 text-white">
                  <h3 class="text-2xl md:text-3xl font-bold mb-4">
                    Changement
                  </h3>
                  <p class="text-white/95 leading-relaxed text-sm md:text-base">
                    Être acteur du changement en remettant en question les normes sociales et en créant des espaces plus inclusifs.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Progress Dots -->
        <div class="flex justify-center gap-3 mt-8">
          <button data-action="click->masculinity-carousel#goToSlide" 
                  data-index="0"
                  data-masculinity-carousel-target="dot"
                  class="carousel-dot w-3 h-3 rounded-full bg-white/30 transition-all duration-300 hover:bg-white/50 active">
          </button>
          <button data-action="click->masculinity-carousel#goToSlide" 
                  data-index="1"
                  data-masculinity-carousel-target="dot"
                  class="carousel-dot w-3 h-3 rounded-full bg-white/30 transition-all duration-300 hover:bg-white/50">
          </button>
          <button data-action="click->masculinity-carousel#goToSlide" 
                  data-index="2"
                  data-masculinity-carousel-target="dot"
                  class="carousel-dot w-3 h-3 rounded-full bg-white/30 transition-all duration-300 hover:bg-white/50">
          </button>
        </div>
      </div>

      <!-- Call to Action -->
      <div class="text-center mt-16">
        <p class="text-white/80 text-lg mb-6">
          Rejoignez-nous dans cette démarche de masculinité positive
        </p>
        <%= link_to "#", class: "group inline-flex items-center gap-2 px-8 py-4 bg-white text-slate-800 rounded-xl font-semibold hover:bg-white/90 transition-all duration-300 shadow-lg hover:shadow-xl hover:scale-105" do %>
          <span>En savoir plus</span>
          <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        <% end %>
      </div>
    </div>
  </div>
</section>
