<!-- Masculinity Section -->
<section class="mb-20 py-20 bg-white" aria-labelledby="masculinity-title">
  <!-- Title -->
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 mb-16">
    <div class="text-center">
      <h2 id="masculinity-title" class="text-4xl md:text-5xl lg:text-6xl font-bold text-purple-800  uppercase tracking-tight">
        Nous sommes des défenseurs
      </h2>
    </div>
  </div>

  <!-- Cards Grid - 4 cards verticales en grille 2x2 avec décalage -->
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 lg:gap-x-8 gap-y-2 lg:gap-y-4 max-w-6xl mx-auto">
      
      <!-- Card 1: Pour les jeunes filles - Ligne 1, Colonne 1 (pas de décalage) -->
      <div class="relative h-[600px] md:h-[650px] lg:h-[700px] rounded-lg overflow-hidden shadow-2xl transform hover:scale-[1.02] transition-transform duration-300">
        <!-- Background Image -->
        <div class="absolute inset-0">
          <%= image_tag "masculinity1.jpeg", alt: "Pour les jeunes filles", class: "w-full h-full object-cover" %>
        </div>
        <!-- Overlay - Teal Blue -->
        <div class="absolute inset-0 bg-gradient-to-t from-teal-600/95 via-teal-600/85 to-teal-600/70"></div>
        <!-- Content -->
        <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-8 text-white z-10">
          <div class="space-y-3">
            <p class="text-sm md:text-base italic font-light opacity-90">POUR</p>
            <h3 class="text-3xl md:text-4xl lg:text-5xl font-bold uppercase leading-tight">
              Les jeunes filles
            </h3>
            <p class="text-sm md:text-base leading-relaxed mt-4 text-white/95">
              Abdoul Aziz s'engage pour un meilleur avenir des jeunes filles au Niger, en créant des opportunités d'éducation et d'autonomisation.
            </p>
          </div>
        </div>
      </div>

      <!-- Card 2: Pour l'égalité des genres - Ligne 1, Colonne 2 (décalée vers le bas) -->
      <div class="relative h-[600px] md:h-[650px] lg:h-[700px] rounded-lg overflow-hidden shadow-2xl transform hover:scale-[1.02] transition-transform duration-300 md:mt-24 lg:mt-32">
        <!-- Background Image -->
        <div class="absolute inset-0">
          <%= image_tag "masculinity2.png", alt: "Pour l'égalité des genres", class: "w-full h-full object-cover" %>
        </div>
        <!-- Overlay - Red -->
        <div class="absolute inset-0 bg-gradient-to-t from-red-600/95 via-red-600/85 to-red-600/70"></div>
        <!-- Content -->
        <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-8 text-white z-10">
          <div class="space-y-3">
            <p class="text-sm md:text-base italic font-light opacity-90">POUR</p>
            <h3 class="text-3xl md:text-4xl lg:text-5xl font-bold uppercase leading-tight">
              L'égalité des genres
            </h3>
            <p class="text-sm md:text-base leading-relaxed mt-4 text-white/95">
              Moussa Harouna défend l'égalité des genres dans tous les secteurs professionnels, en promouvant une culture d'inclusion et de respect mutuel.
            </p>
          </div>
        </div>
      </div>

      <!-- Card 3: Pour les familles unies - Ligne 2, Colonne 1 (pas de décalage) -->
      <div class="relative h-[600px] md:h-[650px] lg:h-[700px] rounded-lg overflow-hidden shadow-2xl transform hover:scale-[1.02] transition-transform duration-300">
        <!-- Background Image -->
        <div class="absolute inset-0">
          <%= image_tag "masculinity3.png", alt: "Pour les familles unies", class: "w-full h-full object-cover" %>
        </div>
        <!-- Overlay - Dark Gray -->
        <div class="absolute inset-0 bg-gradient-to-t from-gray-800/95 via-gray-800/85 to-gray-800/70"></div>
        <!-- Content -->
        <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-8 text-white z-10">
          <div class="space-y-3">
            <p class="text-sm md:text-base italic font-light opacity-90">POUR</p>
            <h3 class="text-3xl md:text-4xl lg:text-5xl font-bold uppercase leading-tight">
              Les familles unies
            </h3>
            <p class="text-sm md:text-base leading-relaxed mt-4 text-white/95">
              Ibrahim Amadou œuvre pour renforcer les liens familiaux et soutenir les femmes dans leur rôle essentiel au sein de la famille nigérienne.
            </p>
          </div>
        </div>
      </div>

      <!-- Card 4: Pour l'autonomisation - Ligne 2, Colonne 2 (décalée vers le bas) -->
      <div class="relative h-[600px] md:h-[650px] lg:h-[700px] rounded-lg overflow-hidden shadow-2xl transform hover:scale-[1.02] transition-transform duration-300 md:mt-16 lg:mt-20">
        <!-- Background Image -->
        <div class="absolute inset-0">
          <%= image_tag "masculinity4.png", alt: "Pour l'autonomisation", class: "w-full h-full object-cover" %>
        </div>
        <!-- Overlay - Teal Blue -->
        <div class="absolute inset-0 bg-gradient-to-t from-teal-600/95 via-teal-600/85 to-teal-600/70"></div>
        <!-- Content -->
        <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-8 text-white z-10">
          <div class="space-y-3">
            <p class="text-sm md:text-base italic font-light opacity-90">POUR</p>
            <h3 class="text-3xl md:text-4xl lg:text-5xl font-bold uppercase leading-tight">
              L'autonomisation
            </h3>
            <p class="text-sm md:text-base leading-relaxed mt-4 text-white/95">
              Ousmane Diallo s'engage pour l'autonomisation économique des femmes, en créant des opportunités de formation et d'entrepreneuriat.
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
