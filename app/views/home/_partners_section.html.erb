<section
  class="section-reveal relative py-24 md:py-32 bg-gradient-to-b from-gray-100 via-white to-gray-50 overflow-hidden"
  aria-labelledby="partners-title"
  data-controller="section-reveal"
  data-section-reveal-animation-value="fadeIn">
  <!-- Animated background elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <!-- Large blurred gradient orbs -->
    <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-gradient-to-br from-purple-700/8 to-purple-800/4 blur-3xl animate-pulse"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 rounded-full bg-gradient-to-br from-blue-500/6 to-purple-700/4 blur-3xl animate-pulse" style="animation-delay: 2s;"></div>
    
    <!-- Subtle grid pattern -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle, rgb(126,34,206) 1px, transparent 1px); background-size: 40px 40px;"></div>
    
    <!-- Decorative lines -->
    <svg class="absolute top-0 left-0 w-full h-full opacity-5" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="lineGradient" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" style="stop-color:rgb(126,34,206);stop-opacity:0.3" />
          <stop offset="100%" style="stop-color:rgb(126,34,206);stop-opacity:0" />
        </linearGradient>
      </defs>
      <path d="M 0 200 Q 400 100 800 200 T 1600 200" stroke="url(#lineGradient)" stroke-width="2" fill="none"/>
      <path d="M 0 400 Q 400 300 800 400 T 1600 400" stroke="url(#lineGradient)" stroke-width="2" fill="none"/>
    </svg>
  </div>

  <!-- Content -->
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Title and Description -->
    <div class="text-center mb-16">
      <h2 id="partners-title" class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-purple-600 text-center mb-6">
        Nos Partenaires
      </h2>
      <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
        Des organisations engagées qui partagent notre vision d'un Niger plus équitable et inclusif
      </p>
    </div>

    <!-- Partners Logos - Modern Card Design -->
    <div class="relative max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 lg:gap-16">
        
        <!-- Swisscontact Card -->
        <div class="group relative">
          <!-- Glassmorphism card -->
          <div class="relative h-48 md:h-56 rounded-2xl overflow-hidden backdrop-blur-xl bg-white/80 border border-gray-200/50 shadow-lg hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2 hover:scale-[1.02]">
            <!-- Animated gradient overlay -->
            <div class="absolute inset-0 bg-gradient-to-br from-purple-50/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            
            <!-- Shine effect on hover -->
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700">
              <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000" style="animation: shine 2s infinite;"></div>
            </div>
            
            <!-- Logo container -->
            <div class="relative h-full flex items-center justify-center p-8">
              <%= image_tag "SC_Logo.jpg", 
                  alt: "Swisscontact", 
                  class: "max-h-24 md:max-h-32 w-auto object-contain transition-all duration-500 group-hover:scale-110 group-hover:brightness-110 filter grayscale-[30%] group-hover:grayscale-0" %>
            </div>
            
            <!-- Decorative corner accent -->
            <div class="absolute top-0 right-0 w-20 h-20 bg-gradient-to-br from-purple-700/10 to-transparent rounded-bl-full opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="absolute bottom-0 left-0 w-20 h-20 bg-gradient-to-tr from-purple-700/10 to-transparent rounded-tr-full opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          </div>
          
          <!-- Partner name on hover -->
          <div class="mt-4 text-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <p class="text-sm font-semibold text-gray-700">Swisscontact</p>
          </div>
        </div>

        <!-- DDC Card -->
        <div class="group relative">
          <!-- Glassmorphism card -->
          <div class="relative h-48 md:h-56 rounded-2xl overflow-hidden backdrop-blur-xl bg-white/80 border border-gray-200/50 shadow-lg hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2 hover:scale-[1.02]">
            <!-- Animated gradient overlay -->
            <div class="absolute inset-0 bg-gradient-to-br from-purple-50/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            
            <!-- Shine effect on hover -->
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700">
              <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000" style="animation: shine 2s infinite;"></div>
            </div>
            
            <!-- Logo container -->
            <div class="relative h-full flex items-center justify-center p-8">
              <%= image_tag "DDC_RGB.png", 
                  alt: "Direction du développement et de la coopération DDC", 
                  class: "max-h-24 md:max-h-32 w-auto object-contain transition-all duration-500 group-hover:scale-110 group-hover:brightness-110 filter grayscale-[30%] group-hover:grayscale-0" %>
            </div>
            
            <!-- Decorative corner accent -->
            <div class="absolute top-0 right-0 w-20 h-20 bg-gradient-to-br from-purple-700/10 to-transparent rounded-bl-full opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="absolute bottom-0 left-0 w-20 h-20 bg-gradient-to-tr from-purple-700/10 to-transparent rounded-tr-full opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          </div>
          
          <!-- Partner name on hover -->
          <div class="mt-4 text-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <p class="text-sm font-semibold text-gray-700">DDC - Direction du développement et de la coopération</p>
          </div>
        </div>

      </div>
    </div>
   <!-- CSS Animation for shine effect -->
  <style>
    @keyframes shine {
      0% {
        transform: translateX(-100%) skewX(-15deg);
      }
      100% {
        transform: translateX(200%) skewX(-15deg);
      }
    }
  </style>
</section>
