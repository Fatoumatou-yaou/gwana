<!-- Activités des Gwanas Section -->
<% if @recent_activities.any? %>
  <section 
    class="relative py-12 md:py-16 bg-gradient-to-br from-gray-50 via-purple-50/30 to-gray-100 overflow-hidden"
    aria-labelledby="activites-gwanas-title">
    
    <!-- Background decorative elements -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <!-- Large blurred gradient orbs -->
      <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-gradient-to-br from-purple-700/8 to-purple-800/4 blur-3xl animate-pulse"></div>
      <div class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full bg-gradient-to-br from-blue-500/6 to-purple-700/4 blur-3xl animate-pulse" style="animation-delay: 2s;"></div>
      
      <!-- Subtle grid pattern -->
      <div class="absolute inset-0 opacity-[0.02]" style="background-image: radial-gradient(circle, rgb(126,34,206) 1px, transparent 1px); background-size: 40px 40px;"></div>
    </div>
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Header -->
      <div class="max-w-3xl mx-auto text-center mb-10 md:mb-12">
        <h2 id="activites-gwanas-title" 
          class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-purple-600 text-center mb-4">
          Activités des Gwanas
        </h2>
        <p class="block md:hidden text-base md:text-lg text-gray-600 leading-relaxed">
          Découvrez l'impact, les actions et réalisations des gwana à travers des activités variées qui témoignent de leur engagement et de leur détermination.
        </p>
      </div>

      <!-- Flex Layout: Cards à gauche, Texte à droite -->
      <div class="flex flex-col lg:flex-row gap-8 lg:gap-10 items-start lg:items-center">
        
        <!-- Left Side: Activities Cards -->
        <div class="w-full lg:w-1/2">
          <div class="grid grid-cols-1 md:grid-cols-2 md:grid-rows-2 gap-x-4 lg:gap-x-5 gap-y-0">
            <!-- Grande card à gauche (colonne 1, row-span-2) -->
            <% first_activity = @recent_activities.first %>
            <% if first_activity %>
              <%= link_to gwana_activity_path(first_activity), class: "group block md:row-span-2 h-full" do %>
                <article class="relative h-full min-h-[260px] md:min-h-[320px] flex flex-col bg-white border border-gray-200 rounded-xl overflow-hidden hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 hover:border-purple-300 isolate">
                  <!-- Background decorative shapes pour la grande card -->
                  <div class="absolute inset-0 pointer-events-none overflow-hidden rounded-xl">
                    <!-- Gradient overlay -->
                    <div class="absolute inset-0 bg-gradient-to-br from-purple-50/30 via-transparent to-blue-50/20 group-hover:from-purple-50/50 group-hover:to-blue-50/30 transition-all duration-500"></div>
                    
                    <!-- Animated circles -->
                    <div class="absolute -top-8 -right-8 w-32 h-32 bg-gradient-radial from-purple-400/15 via-purple-300/8 to-transparent rounded-full blur-2xl opacity-60 group-hover:scale-150 group-hover:opacity-100 group-hover:from-purple-400/25 transition-all duration-700 ease-out"></div>
                    <div class="absolute -bottom-6 -left-6 w-24 h-24 bg-gradient-radial from-blue-400/15 via-blue-300/8 to-transparent rounded-full blur-xl opacity-50 group-hover:scale-125 group-hover:opacity-100 group-hover:from-blue-400/25 transition-all duration-700 ease-out" style="transition-delay: 100ms;"></div>
                    
                    <!-- Geometric shapes -->
                    <div class="absolute top-0 right-0 w-20 h-20 transform rotate-45 translate-x-6 -translate-y-6 group-hover:translate-x-0 group-hover:translate-y-0 transition-all duration-500">
                      <div class="w-full h-full bg-gradient-to-br from-purple-200/20 to-transparent rounded-lg blur-sm opacity-70 group-hover:opacity-100 group-hover:from-purple-200/40 transition-all duration-500"></div>
                    </div>
                    
                    <!-- Shimmer effect -->
                    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/40 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out"></div>
                    
                    <!-- Subtle pattern overlay -->
                    <div class="absolute inset-0 opacity-[0.03] group-hover:opacity-[0.06] transition-opacity duration-500" style="background-image: radial-gradient(circle at 2px 2px, purple 1px, transparent 0); background-size: 24px 24px;"></div>
                  </div>
                  <!-- Image Container -->
                  <div class="relative z-10 w-full h-64 md:h-80 lg:h-96 overflow-hidden bg-gray-100 flex-shrink-0">
                    <% if first_activity.has_video? %>
                      <div 
                        data-controller="lazy-video"
                        class="relative w-full h-full"
                      >
                        <img 
                          src="<%= first_activity.youtube_thumbnail_url %>" 
                          alt="<%= first_activity.description.truncate(50) %>" 
                          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                          data-lazy-video-target="thumbnail"
                        />
                        <div class="absolute inset-0 bg-black/30 flex items-center justify-center group-hover:bg-black/40 transition-colors duration-300">
                          <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
                            <svg class="w-4 h-4 text-gray-900 ml-0.5" fill="currentColor" viewBox="0 0 20 20">
                              <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/>
                            </svg>
                          </div>
                        </div>
                        <iframe 
                          data-lazy-video-target="iframe"
                          data-src="<%= first_activity.youtube_embed_url %>?autoplay=1&mute=1"
                          frameborder="0"
                          allow="autoplay; encrypted-media; picture-in-picture"
                          allowfullscreen
                          class="hidden absolute inset-0 w-full h-full"
                        ></iframe>
                      </div>
                    <% elsif first_activity.has_photos? %>
                      <%= image_tag first_activity.photos.first, 
                          alt: first_activity.description.truncate(50), 
                          class: "w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" %>
                      <% if first_activity.photos.count > 1 %>
                        <div class="absolute top-4 right-4 bg-white/95 px-3 py-1.5 rounded-md text-xs font-semibold text-gray-900 shadow-sm">
                          +<%= first_activity.photos.count - 1 %>
                        </div>
                      <% end %>
                    <% else %>
                      <div class="w-full h-full bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
                        <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                        </svg>
                      </div>
                    <% end %>
                    
                    <!-- Activity Type Badge -->
                    <div class="absolute top-2 left-2">
                      <span class="inline-block px-2 py-1 bg-white/95 backdrop-blur-sm text-gray-900 text-xs font-semibold rounded shadow-sm">
                        <%= first_activity.activity_type.humanize %>
                      </span>
                    </div>
                  </div>

                  <!-- Content -->
                  <div class="relative z-10 flex-1 flex flex-col justify-between p-4 md:p-6">
                    <!-- Description -->
                    <p class="text-gray-900 text-sm md:text-base leading-relaxed mb-4 line-clamp-3 flex-1">
                      <%= truncate(first_activity.description, length: 120) %>
                    </p>
                    
                    <!-- CTA - Visible seulement au survol sur desktop -->
                    <div class="opacity-0 md:group-hover:opacity-100 transition-opacity duration-300">
                      <span class="inline-flex items-center gap-2 text-purple-700 font-semibold text-xs md:text-sm group-hover:gap-3 transition-all duration-300">
                        <span>En savoir plus</span>
                        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                        </svg>
                      </span>
                    </div>
                  </div>
                </article>
              <% end %>
            <% end %>
            
            <!-- Deux petites cards à droite (colonne 2, empilées) -->
            <% @recent_activities[1..2].each do |activity| %>
              <%= link_to gwana_activity_path(activity), class: "group block h-full" do %>
                <article class="relative h-full min-h-[220px] md:min-h-[280px] flex flex-col bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-xl transition-all duration-500 hover:-translate-y-1 hover:border-purple-300 isolate">
                  <!-- Background decorative shapes pour les petites cards -->
                  <div class="absolute inset-0 pointer-events-none overflow-hidden rounded-lg">
                    <!-- Gradient overlay -->
                    <div class="absolute inset-0 bg-gradient-to-br from-purple-50/20 via-transparent to-blue-50/15 group-hover:from-purple-50/40 group-hover:to-blue-50/25 transition-all duration-500"></div>
                    
                    <!-- Animated circles plus petits -->
                    <div class="absolute -top-6 -right-6 w-20 h-20 bg-gradient-radial from-purple-400/12 via-purple-300/6 to-transparent rounded-full blur-xl opacity-50 group-hover:scale-125 group-hover:opacity-100 group-hover:from-purple-400/20 transition-all duration-700 ease-out"></div>
                    <div class="absolute -bottom-4 -left-4 w-16 h-16 bg-gradient-radial from-blue-400/12 via-blue-300/6 to-transparent rounded-full blur-lg opacity-40 group-hover:scale-110 group-hover:opacity-100 group-hover:from-blue-400/20 transition-all duration-700 ease-out" style="transition-delay: 100ms;"></div>
                    
                    <!-- Shimmer effect -->
                    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/30 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out"></div>
                    
                    <!-- Subtle pattern overlay -->
                    <div class="absolute inset-0 opacity-[0.02] group-hover:opacity-[0.04] transition-opacity duration-500" style="background-image: radial-gradient(circle at 2px 2px, purple 1px, transparent 0); background-size: 20px 20px;"></div>
                  </div>
                  <!-- Image Container -->
                  <div class="relative z-10 w-full h-40 md:h-44 overflow-hidden bg-gray-100 flex-shrink-0">
                    <% if activity.has_video? %>
                      <div 
                        data-controller="lazy-video"
                        class="relative w-full h-full"
                      >
                        <img 
                          src="<%= activity.youtube_thumbnail_url %>" 
                          alt="<%= activity.description.truncate(50) %>" 
                          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                          data-lazy-video-target="thumbnail"
                        />
                        <div class="absolute inset-0 bg-black/30 flex items-center justify-center group-hover:bg-black/40 transition-colors duration-300">
                          <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
                            <svg class="w-4 h-4 text-gray-900 ml-0.5" fill="currentColor" viewBox="0 0 20 20">
                              <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/>
                            </svg>
                          </div>
                        </div>
                        <iframe 
                          data-lazy-video-target="iframe"
                          data-src="<%= activity.youtube_embed_url %>?autoplay=1&mute=1"
                          frameborder="0"
                          allow="autoplay; encrypted-media; picture-in-picture"
                          allowfullscreen
                          class="hidden absolute inset-0 w-full h-full"
                        ></iframe>
                      </div>
                    <% elsif activity.has_photos? %>
                      <%= image_tag activity.photos.first, 
                          alt: activity.description.truncate(50), 
                          class: "w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" %>
                      <% if activity.photos.count > 1 %>
                        <div class="absolute top-4 right-4 bg-white/95 px-3 py-1.5 rounded-md text-xs font-semibold text-gray-900 shadow-sm">
                          +<%= activity.photos.count - 1 %>
                        </div>
                      <% end %>
                    <% else %>
                      <div class="w-full h-full bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
                        <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                        </svg>
                      </div>
                    <% end %>
                    
                    <!-- Activity Type Badge -->
                    <div class="absolute top-2 left-2">
                      <span class="inline-block px-2 py-1 bg-white/95 backdrop-blur-sm text-gray-900 text-xs font-semibold rounded shadow-sm">
                        <%= activity.activity_type.humanize %>
                      </span>
                    </div>
                  </div>

                  <!-- Content -->
                  <div class="relative z-10 flex-1 p-4 flex flex-col justify-between">
                    <!-- Description -->
                    <p class="text-gray-900 text-sm leading-relaxed mb-3 line-clamp-2 flex-1">
                      <%= truncate(activity.description, length: 80) %>
                    </p>
                    
                    <!-- CTA - Visible seulement au survol sur desktop -->
                    <div class="opacity-0 md:group-hover:opacity-100 transition-opacity duration-300">
                      <div class="flex items-center gap-2 text-purple-700 font-semibold text-xs group-hover:gap-3 transition-all duration-300">
                        <span>En savoir plus</span>
                        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                        </svg>
                      </div>
                    </div>
                  </div>
                </article>
              <% end %>
            <% end %>
          </div>
        </div>
        
        <!-- Right Side: Text Content -->
        <div class="w-full lg:w-2/5 lg:sticky lg:top-24 flex-col justify-center">
          <div class=" hidden md:flex space-y-5 mb-8">
            <p class="text-lg md:text-xl text-gray-800 leading-relaxed font-medium">
              Les Gwanas sont des figures inspirantes qui entreprennent des initiatives remarquables et réalisent des projets concrets pour transformer leur communauté.
            </p>
            <p class="text-base md:text-lg text-gray-600 leading-relaxed">
              Découvrez leurs actions, leurs réalisations et leur impact à travers des activités variées qui témoignent de leur engagement et de leur détermination.
            </p>
          </div>
          
          <!-- CTA Button avec effets modernes -->
          <%= link_to gwana_activities_path, 
              class: "group relative inline-flex items-center px-2 w-2/5 md:w-full py-3 bg-purple-600 text-white rounded-lg font-semibold text-sm hover:purple-700 transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5 overflow-hidden" do %>
            <!-- Shimmer effect sur le bouton -->
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out"></div>
            <span class="relative z-10">Toutes les activités</span>
            <svg class="relative z-10 w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          <% end %>
        </div>
      </div>
    </div>
  </section>
  <%= render "shared/youtube_modal" %>
<% end %>

