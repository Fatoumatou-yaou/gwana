<!-- Activités des Gwanas Section -->
<% if @recent_activities.any? %>
  <section 
    class="relative py-20 md:py-28 bg-white"
    aria-labelledby="activites-gwanas-title">
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="max-w-3xl mx-auto text-center mb-16 md:mb-20">
        <h2 id="activites-gwanas-title" 
          class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-purple-600 text-center mb-">
          Activités des Gwanas
        </h2>
        <p class="text-lg md:text-xl text-gray-600 leading-relaxed">
          Découvrez les activités réalisées par les membres du réseau GWANA
        </p>
      </div>

      <!-- Activities Grid -->
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
          <% @recent_activities.each do |activity| %>
            <%= link_to gwana_activity_path(activity), class: "group block" do %>
              <article class="h-full flex flex-col bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                <!-- Image Container -->
                <div class="relative aspect-[4/3] overflow-hidden bg-gray-100">
                  <% if activity.has_video? %>
                    <div 
                      data-controller="lazy-video"
                      class="relative w-full h-full"
                    >
                      <img 
                        src="<%= activity.youtube_thumbnail_url %>" 
                        alt="<%= activity.description.truncate(50) %>" 
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        data-lazy-video-target="thumbnail"
                      />
                      <div class="absolute inset-0 bg-black/30 flex items-center justify-center">
                        <div class="w-14 h-14 bg-white rounded-full flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
                          <svg class="w-6 h-6 text-gray-900 ml-0.5" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/>
                          </svg>
                        </div>
                      </div>
                      <iframe 
                        data-lazy-video-target="iframe"
                        data-src="<%= activity.youtube_embed_url %>?autoplay=1&mute=1"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                        class="hidden absolute inset-0 w-full h-full"
                      ></iframe>
                    </div>
                  <% elsif activity.has_photos? %>
                    <%= image_tag activity.photos.first, 
                        alt: activity.description.truncate(50), 
                        class: "w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" %>
                    <% if activity.photos.count > 1 %>
                      <div class="absolute top-4 right-4 bg-white/95 px-3 py-1.5 rounded-md text-xs font-semibold text-gray-900 shadow-sm">
                        +<%= activity.photos.count - 1 %>
                      </div>
                    <% end %>
                  <% else %>
                    <div class="w-full h-full bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
                      <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                      </svg>
                    </div>
                  <% end %>
                  
                  <!-- Activity Type Badge -->
                  <div class="absolute top-4 left-4">
                    <span class="inline-block px-3 py-1.5 bg-white/95 backdrop-blur-sm text-gray-900 text-xs font-semibold rounded-md shadow-sm">
                      <%= activity.activity_type.humanize %>
                    </span>
                  </div>
                </div>

                <!-- Content -->
                <div class="flex-1 p-6 flex flex-col">
                  <!-- Author and Date -->
                  <div class="flex items-center gap-2 mb-4 text-sm text-gray-500">
                    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    <span class="truncate font-medium text-gray-700"><%= activity.gwana.full_name %></span>
                    <span class="text-gray-300">•</span>
                    <time datetime="<%= activity.created_at.iso8601 %>" class="whitespace-nowrap">
                      <%= l(activity.created_at, format: :short) if activity.created_at %>
                    </time>
                  </div>
                  
                  <!-- Description -->
                  <p class="text-gray-900 text-base leading-relaxed mb-6 line-clamp-3 flex-1">
                    <%= truncate(activity.description, length: 120) %>
                  </p>
                  
                  <!-- CTA -->
                  <div class="flex items-center gap-2 text-purple-700 font-semibold text-sm group-hover:gap-3 transition-all duration-300 mt-auto">
                    <span>En savoir plus</span>
                    <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                  </div>
                </div>
              </article>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- View All Link -->
      <div class="text-center mt-16 md:mt-20">
        <%= link_to gwana_activities_path, 
            class: "inline-flex items-center gap-2 px-8 py-4 bg-purple-700 text-white rounded-lg font-semibold text-base hover:bg-purple-800 transition-colors duration-200 shadow-sm hover:shadow-md" do %>
          <span>Voir toutes les activités</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        <% end %>
      </div>
    </div>
  </section>
  <%= render "shared/youtube_modal" %>
<% end %>

