<!-- Activités des Gwanas Section -->
<% if @recent_activities.any? %>
  <section 
    class="relative py-18 bg-gray-100 overflow-hidden"
    aria-labelledby="activites-gwanas-title">
    
    <!-- Background decorative elements -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <!-- Animated gradient orbs -->
      <div class="absolute top-1/4 right-0 w-[600px] h-[600px] bg-gradient-radial from-purple-700/15 via-transparent to-transparent rounded-full blur-3xl animate-pulse-slow"></div>
      <div class="absolute bottom-1/4 left-0 w-[500px] h-[500px] bg-gradient-radial from-blue-500/10 via-transparent to-transparent rounded-full blur-3xl animate-pulse-slow" style="animation-delay: 1.5s;"></div>
      
      <!-- Geometric shapes -->
      <div class="absolute top-20 left-20 w-32 h-32 border border-purple-700/10 rounded-full animate-float"></div>
      <div class="absolute bottom-32 right-16 w-24 h-24 border border-blue-500/10 rounded-full animate-float" style="animation-delay: 2s;"></div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Title and Description -->
      <div class="text-center mb-16">
        <h2 id="activites-gwanas-title" 
          class="text-5xl md:text-6xl lg:text-7xl font-bold mb-6 text-purple-600 text-center">
          Activités des Gwanas
        </h2>
        <p class="text-lg md:text-xl text-gray-400 max-w-3xl mx-auto">
          Découvrez les activités réalisées par les membres du réseau GWANA
        </p>
      </div>

      <!-- Activities Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 max-w-7xl mx-auto">
        <% @recent_activities.each do |activity| %>
          <article 
            class="group relative overflow-hidden rounded-xl bg-gradient-to-br from-slate-950 to-slate-900 border border-purple-700/20 hover:border-purple-700/50 transition-all duration-500 transform hover:scale-[1.03] hover:shadow-xl hover:shadow-purple-700/10"
          >
            <!-- Background gradient overlay -->
            <div class="absolute inset-0 bg-white group-hover:opacity-100 transition-opacity duration-500"></div>
            
            <!-- Image Container -->
            <div class="relative h-48 overflow-hidden">
              <% if activity.has_video? %>
                <div 
                  data-controller="lazy-video"
                  class="relative w-full h-full"
                >
                  <!-- Thumbnail -->
                  <img 
                    src="<%= activity.youtube_thumbnail_url %>" 
                    alt="<%= activity.description.truncate(50) %>" 
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    data-lazy-video-target="thumbnail"
                  />
                  <!-- Play Button Overlay -->
                  <div class="absolute inset-0 bg-black/40 flex items-center justify-center">
                    <div class="w-16 h-16 bg-red-600 rounded-full flex items-center justify-center hover:bg-red-700 transition-colors cursor-pointer">
                      <svg class="w-8 h-8 text-white ml-1" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/>
                      </svg>
                    </div>
                  </div>
                  <!-- Lazy-loaded iframe -->
                  <iframe 
                    data-lazy-video-target="iframe"
                    data-src="<%= activity.youtube_embed_url %>?autoplay=1&mute=1"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    class="hidden absolute inset-0 w-full h-full"
                  ></iframe>
                </div>
              <% elsif activity.has_photos? %>
                <%= image_tag activity.photos.first, 
                    alt: activity.description.truncate(50), 
                    class: "w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" %>
                <% if activity.photos.count > 1 %>
                  <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-semibold text-purple-700">
                    +<%= activity.photos.count - 1 %>
                  </div>
                <% end %>
              <% else %>
                <div class="w-full h-full bg-gradient-to-br from-purple-700/30 to-blue-500/30 flex items-center justify-center">
                  <svg class="w-16 h-16 text-purple-700/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                  </svg>
                </div>
              <% end %>
              
              <!-- Gradient overlay on image -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"></div>
              
              <!-- Activity Type Badge -->
              <div class="absolute top-4 left-4">
                <span class="px-3 py-1 bg-purple-700/80 backdrop-blur-md text-white text-xs font-semibold rounded-full border border-white/20 shadow-lg">
                  <%= activity.activity_type.humanize %>
                </span>
              </div>
            </div>

            <!-- Content -->
            <div class="relative p-5 overflow-hidden">
              <div class="flex items-center gap-2 mb-3 text-xs text-gray-400 flex-wrap">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                <span class="truncate"><%= activity.gwana.full_name %></span>
                <span class="text-gray-500 flex-shrink-0">•</span>
                <time datetime="<%= activity.created_at.iso8601 %>" class="whitespace-nowrap">
                  <%= l(activity.created_at, format: :short) if activity.created_at %>
                </time>
              </div>
              
              <p class="text-gray-700 text-sm mb-4 line-clamp-2 leading-relaxed break-words overflow-hidden">
                <%= truncate(activity.description, length: 100) %>
              </p>
              
              <!-- View Link -->
              <%= link_to gwana_activity_path(activity), 
                  class: "flex items-center gap-2 text-amber-500 text-sm font-semibold group-hover:gap-3 transition-all duration-300" do %>
                <span>Voir les détails</span>
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              <% end %>
            </div>

            <!-- Shine effect on hover -->
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-1000 pointer-events-none"></div>
          </article>
        <% end %>
      </div>

      <!-- View All Link -->
      <div class="text-center mt-12">
        <%= link_to gwana_activities_path, 
            class: "group inline-flex items-center gap-3 px-8 py-4 bg-purple-600 backdrop-blur-md text-white rounded-xl font-semibold text-lg border border-purple-700/30 hover:border-purple-700/50 hover:from-purple-700/30 hover:to-blue-500/30 transition-all duration-300 hover:scale-105 shadow-lg hover:shadow-xl hover:shadow-purple-700/20" do %>
          <span>Toutes les activités</span>
          <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        <% end %>
      </div>
    </div>
  </section>
  <%= render "shared/youtube_modal" %>
<% end %>

