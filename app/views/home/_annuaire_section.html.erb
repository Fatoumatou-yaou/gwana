<!-- Annuaire Section -->
<% if @directory_gwanas.any? %>
  <section
    class="section-reveal relative py-16 md:py-20 bg-gradient-to-b from-purple-50 to-purple-50 overflow-hidden"
    aria-labelledby="annuaire-title"
    data-controller="section-reveal"
    data-section-reveal-animation-value="slideInUp">
    <!-- Background geometric shapes -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <!-- Wavy lines background -->
      <svg class="absolute bottom-0 left-0 w-full h-32 md:h-40 opacity-15"
        viewBox="0 0 1200 200"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="none"
      >
        <path
          d="M 0 100 Q 150 50 300 100 T 600 100 T 900 100 T 1200 100 L 1200 200 L 0 200 Z"
          fill="rgb(192,152,252)"
        />
        <path
          d="M 0 120 Q 200 70 400 120 T 800 120 T 1200 120 L 1200 200 L 0 200 Z"
          fill="rgb(250,245,255)"
          opacity="0.6"
        />
      </svg>

      <!-- Additional geometric shapes -->
      <div class="absolute top-1/4 right-20 w-32 h-32 rounded-full bg-purple-400 opacity-10 blur-2xl"></div>
      <div class="absolute bottom-1/4 left-1/4 w-48 h-48 rounded-full bg-purple-700 opacity-10 blur-3xl"></div>
    </div>

    <!-- Content -->
    <div class="container mx-auto px-4 sm:px-4 lg:px-5 relative z-10">
      <!-- Title -->
      <div class="text-center mb-12 md:mb-16">
        <h2 id="annuaire-title" class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-purple-600 text-center">
        
          Annuaire GWANA
        </h2>
      </div>

      <div class="text-center mb-12 md:mb-16">
        <p class="text-gray-600 text-lg">Découvrez ces femmes qui s'imposent dans des métiers dits masculins et qui font la différence!</p>
      </div>
      
      <!-- Carousel Container -->
      <div class="annuaire-carousel-container" data-controller="annuaire-carousel">
        <div class="annuaire-carousel-track" data-annuaire-carousel-target="track">
          <% @directory_gwanas.each do |gwana| %>
            <div class="annuaire-carousel-item" data-annuaire-carousel-target="item">
              <%= link_to gwana_path(gwana), class: "group flex flex-col items-center focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2 rounded-full transition-all duration-300" do %>
                <div class="relative gwana-avatar">
                  <% if gwana.photo.attached? %>
                    <div class="relative w-32 h-32 sm:w-40 sm:h-40 md:w-48 md:h-48 rounded-full overflow-hidden group-hover:scale-105 transition-transform duration-300">
                      <%= image_tag gwana.photo, 
                          alt: gwana.full_name, 
                          class: "w-full h-full object-cover transition-all duration-300" %>
                    </div>
                  <% else %>
                    <div class="relative w-32 h-32 sm:w-40 sm:h-40 md:w-48 md:h-48 rounded-full bg-gradient-to-br from-purple-700 to-purple-800 flex items-center justify-center border-4 border-white shadow-xl group-hover:scale-105 transition-transform duration-300">
                      <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-white">
                        <%= gwana.first_name[0].upcase %><%= gwana.last_name[0].upcase %>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% end %>
              
              <!-- Name below photo -->
              <div class="mt-4 text-center max-w-[200px] px-0">
                <h3 class="text-base sm:text-lg font-semibold text-purple-600 mb-1 line-clamp-2 leading-tight">
                  <%= link_to gwana.full_name, gwana_path(gwana), class: "hover:text-purple-600 transition-colors focus:outline-none focus:ring-2 focus:ring-purple-500 rounded px-1" %>
                </h3>
                <!-- Profession below name -->
                <p class="text-sm text-gray-600 font-medium line-clamp-2 leading-snug"><%= gwana.profession %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Link to full directory -->
      <div class="text-center mt-4 mb-2">
        <%= link_to gwanas_path, class: "group inline-flex items-center gap-2 px-8 py-4 bg-purple-600 text-white rounded-xl font-semibold text-lg shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2" do %>
          <span>Toutes les Gwanas</span>
          <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

