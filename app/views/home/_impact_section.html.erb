<!-- Impact Section -->
<section class="relative py-12 sm:py-16 md:py-20 bg-gradient-to-b from-gray-100 via-gray-200 to-slate-600 overflow-hidden" aria-labelledby="impact-title">
  <!-- Background decorative elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-gradient-to-br from-purple-700/5 to-blue-500/3 blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full bg-gradient-to-br from-amber-500/5 to-purple-700/3 blur-3xl"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Title and Description -->
    <div class="text-center mb-8 md:mb-16">
      <h2 id="impact-title" class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-purple-600 text-center mb-4 md:mb-6">
        Activités du Réseau
      </h2>
      <p class="text-base sm:text-lg md:text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed px-2">
        Des résultats concrets qui transforment la vie des femmes et des communautés au Niger
      </p>
    </div>

    <!-- Cards Grid with Overlapping Images -->
    <div class="relative max-w-7xl mx-auto overflow-hidden md:overflow-visible">
      <!-- Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-0 relative z-40 max-w-4xl mx-auto">
        <!-- Card 1: Top Left - Violet (+3 caravanes) -->
        <div class="bg-purple-600 w-full md:w-4/5 md:mt-[-1.5rem] md:ml-[-5rem] rounded-2xl p-6 sm:p-8 text-white transform hover:scale-105 transition-all duration-300 relative shadow-xl hover:shadow-2xl group">
          <div class="text-4xl sm:text-5xl md:text-6xl font-bold mb-4 text-amber-500">+3</div>
          <div class="w-12 sm:w-16 h-1 bg-amber-500/50 mb-4 rounded-full"></div>
          <p class="text-sm sm:text-base md:text-lg leading-relaxed">
           caravanes de sensibilisation organisées à Maradi, Tahoua et Dosso          
          </p>
        </div>

        <!-- Card 2: Top Right - Bleu (+500 jeunes filles) -->
        <div class="bg-blue-600 rounded-2xl p-6 sm:p-8 md:mt-[-1.5rem] md:ml-[-7rem] w-full md:w-5/6 lg:mr-20 text-white transform hover:scale-105 transition-all duration-300 relative shadow-xl hover:shadow-2xl group">
          <div class="text-4xl sm:text-5xl md:text-6xl font-bold mb-4 text-amber-500">+500</div>
          <div class="w-12 sm:w-16 h-1 bg-amber-500/50 mb-4 rounded-full"></div>
          <p class="text-sm sm:text-base md:text-lg leading-relaxed">
          jeunes filles touchées par nos programmes de sensibilisation et de mentorat
          </p>
        </div>

        <!-- Card 3: Bottom Left - Bleu (+50 communautés) -->
        <div class="bg-blue-600 rounded-2xl p-6 sm:p-8 text-white transform hover:scale-105 transition-all duration-300 relative shadow-xl hover:shadow-2xl group mt-0 md:mt-6 w-full md:w-5/6 lg:ml-[7rem]">
          <div class="text-4xl sm:text-5xl md:text-6xl font-bold mb-4 text-amber-500">+50</div>
          <div class="w-12 sm:w-16 h-1 bg-amber-500/50 mb-4 rounded-full"></div>
          <p class="text-sm sm:text-base md:text-lg leading-relaxed">
          communautés sensibilisées sur l'importance de l'éducation et de l'autonomisation des femmes
          </p>
        </div>

        <!-- Card 4: Bottom Right - Violet (+100 ateliers) -->
        <div class="bg-purple-600 w-full md:w-4/5 md:ml-auto md:mr-0 rounded-2xl p-6 sm:p-8 text-white transform hover:scale-105 transition-all duration-300 relative shadow-xl hover:shadow-2xl group mt-0 md:mt-6">
          <div class="text-4xl sm:text-5xl md:text-6xl font-bold mb-4 text-amber-500">+100</div>
          <div class="w-12 sm:w-16 h-1 bg-amber-500/50 mb-4 rounded-full"></div>
          <p class="text-sm sm:text-base md:text-lg leading-relaxed">
           ateliers de formation et de développement des compétences organisés
          </p>
        </div>
      </div>

      <!-- Left Semi-Circular Image - Overlapping bottom-left card (Card 3) and touching top-left card (Card 1) -->
      <div class="hidden md:block absolute z-10" style="left: -200px; top: 3rem; width: 500px; height: 500px;">
        <div class="w-full h-full overflow-hidden rounded-full" style="clip-path: circle(50% at 50% 50%);">
          <%= image_tag "impact1.jpeg", alt: "Impact GWANA - Sensibilisation", class: "w-full h-full object-cover" %>
        </div>
      </div>

      <!-- Right Semi-Circular Image - Overlapping top-right card (Card 2) and bottom-right card (Card 4) -->
      <div class="hidden md:block absolute z-10" style="right: -150px; top: -70px; width: 520px; height: 520px;">
        <div class="w-full h-full overflow-hidden rounded-full" style="clip-path: circle(50% at 50% 50%);">
          <%= image_tag "impact2.jpeg", alt: "Impact GWANA - Formation", class: "w-full h-full object-cover" %>
        </div>
      </div>
    </div>

    <!-- Call to Action -->
    <div class="text-center mt-8 md:mt-16">
      <%= link_to impact_path, class: "group inline-flex items-center gap-2 px-6 sm:px-8 py-3 sm:py-4 bg-purple-600 text-white rounded-xl font-semibold text-base sm:text-lg shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105" do %>
        <span>Toutes les activités</span>
        <svg class="w-4 h-4 sm:w-5 sm:h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      <% end %>
    </div>
  </div>
</section>

