<% content_for :title, "Créer un compte" %>

<div class="min-h-screen bg-gray-50 flex">
  <!-- Left side - Registration Form -->
  <div class="w-full lg:w-1/2 flex flex-col justify-center px-4 sm:px-6 lg:px-12 xl:px-16 bg-gradient-to-br from-white to-gray-50">
    <div class="mx-auto w-full max-w-2xl">
      <!-- Logo -->
      <div class="text-center mb-6">
        <a href="<%= root_path %>" class="inline-block transform hover:scale-105 transition-transform duration-200">
          <h1 class="text-4xl font-bold bg-gradient-to-r from-purple-700 to-purple-800 bg-clip-text text-transparent drop-shadow-lg">
            gwana
          </h1>
        </a>
        <h2 class="mt-2 text-xl font-bold bg-gradient-to-r from-purple-700 to-purple-800 bg-clip-text text-transparent">
          Créer un compte
        </h2>
        <p class="mt-1 text-xs text-gray-600 font-medium">
          Rejoignez la plateforme Gwana
        </p>
      </div>

      <!-- Registration Form -->
      <div class="bg-white/80 backdrop-blur-sm py-6 px-6 shadow-lg rounded-lg border border-white/20 relative overflow-hidden">
        <!-- Decorative background -->
        <div class="absolute top-0 right-0 w-16 h-16 bg-gradient-to-br from-purple-50 to-purple-700/20 rounded-full -translate-y-8 translate-x-8 opacity-50"></div>
        <div class="absolute bottom-0 left-0 w-12 h-12 bg-gradient-to-tr from-purple-50 to-purple-700/20 rounded-full translate-y-6 -translate-x-6 opacity-50"></div>
        
        <div class="relative z-10">
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
            <%= render "shared/error_messages", resource: resource %>

            <!-- Personal Information Section -->
            <div class="space-y-4">
              <h3 class="text-sm font-semibold text-gray-800 border-b border-gray-200 pb-2">Informations personnelles</h3>
              
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div class="group">
                  <%= f.label :first_name, "Prénom", class: 'block text-sm font-semibold text-gray-700 mb-1 group-focus-within:text-purple-700 transition-colors duration-200' %>
                  <div class="relative">
                    <%= f.text_field :first_name, required: true, 
                        class: "w-full p-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-purple-700/20 focus:border-purple-700 focus:outline-none transition-all duration-300 text-gray-900 placeholder-gray-400 bg-white/80 backdrop-blur-sm hover:border-gray-300 hover:bg-white/90",
                        placeholder: "Prénom" %>
                  </div>
                </div>

                <div class="group">
                  <%= f.label :last_name, "Nom", class: 'block text-sm font-semibold text-gray-700 mb-1 group-focus-within:text-purple-700 transition-colors duration-200' %>
                  <div class="relative">
                    <%= f.text_field :last_name, required: true, 
                        class: "w-full p-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-purple-700/20 focus:border-purple-700 focus:outline-none transition-all duration-300 text-gray-900 placeholder-gray-400 bg-white/80 backdrop-blur-sm hover:border-gray-300 hover:bg-white/90",
                        placeholder: "Nom" %>
                  </div>
                </div>
              </div>

              <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div class="group">
                  <%= f.label :gender, "Genre", class: 'block text-sm font-semibold text-gray-700 mb-1 group-focus-within:text-purple-700 transition-colors duration-200' %>
                  <div class="relative">
                    <%= f.select :gender, options_for_select([["Homme", "male"], ["Femme", "female"], ["Autre", "other"]], f.object.gender), 
                        { prompt: "Sélectionnez un genre" }, 
                        { required: true, 
                          class: "w-full p-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-purple-700/20 focus:border-purple-700 focus:outline-none transition-all duration-300 text-gray-900 bg-white/80 backdrop-blur-sm hover:border-gray-300 hover:bg-white/90" } %>
                  </div>
                </div>

                <div class="group">
                  <%= f.label :date_of_birth, "Date de naissance", class: 'block text-sm font-semibold text-gray-700 mb-1 group-focus-within:text-purple-700 transition-colors duration-200' %>
                  <div class="relative">
                    <%= f.date_field :date_of_birth, required: true, 
                        class: "w-full p-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-purple-700/20 focus:border-purple-700 focus:outline-none transition-all duration-300 text-gray-900 placeholder-gray-400 bg-white/80 backdrop-blur-sm hover:border-gray-300 hover:bg-white/90",
                        max: Date.today - 13.years %>
                  </div>
                </div>
              </div>
            </div>

            <!-- Contact Information Section -->
            <div class="space-y-4">
              <h3 class="text-sm font-semibold text-gray-800 border-b border-gray-200 pb-2">Informations de connexion</h3>
              
              <div class="group">
                <%= f.label :email, "Email", class: 'block text-sm font-semibold text-gray-700 mb-1 group-focus-within:text-purple-700 transition-colors duration-200' %>
                <div class="relative">
                  <%= f.email_field :email, autocomplete: "email", required: true, 
                      class: "w-full p-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-purple-700/20 focus:border-purple-700 focus:outline-none transition-all duration-300 text-gray-900 placeholder-gray-400 bg-white/80 backdrop-blur-sm hover:border-gray-300 hover:bg-white/90",
                      placeholder: "email@exemple.com" %>
                </div>
              </div>

              <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div class="group">
                  <%= f.label :country_code, "Code pays", class: 'block text-sm font-semibold text-gray-700 mb-1 group-focus-within:text-purple-700 transition-colors duration-200' %>
                  <div class="relative">
                    <%= f.text_field :country_code, required: true, 
                        class: "w-full p-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-purple-700/20 focus:border-purple-700 focus:outline-none transition-all duration-300 text-gray-900 placeholder-gray-400 bg-white/80 backdrop-blur-sm hover:border-gray-300 hover:bg-white/90",
                        placeholder: "+223" %>
                  </div>
                </div>

                <div class="group">
                  <%= f.label :phone, "Téléphone", class: 'block text-sm font-semibold text-gray-700 mb-1 group-focus-within:text-purple-700 transition-colors duration-200' %>
                  <div class="relative">
                    <%= f.telephone_field :phone, required: true, pattern: "[0-9]{8,15}", 
                        class: "w-full p-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-purple-700/20 focus:border-purple-700 focus:outline-none transition-all duration-300 text-gray-900 placeholder-gray-400 bg-white/80 backdrop-blur-sm hover:border-gray-300 hover:bg-white/90",
                        placeholder: "12345678" %>
                  </div>
                </div>
              </div>
            </div>

            <!-- Security Section -->
            <div class="space-y-4">
              <h3 class="text-sm font-semibold text-gray-800 border-b border-gray-200 pb-2">Sécurité</h3>
              
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div class="group">
                  <%= f.label :password, "Mot de passe", class: 'block text-sm font-semibold text-gray-700 mb-1 group-focus-within:text-purple-700 transition-colors duration-200' %>
                  <div class="relative">
                    <%= f.password_field :password, autocomplete: "new-password", required: true, minlength: 6, 
                        class: "w-full p-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-purple-700/20 focus:border-purple-700 focus:outline-none transition-all duration-300 text-gray-900 placeholder-gray-400 bg-white/80 backdrop-blur-sm hover:border-gray-300 hover:bg-white/90",
                        placeholder: "••••••••" %>
                  </div>
                </div>

                <div class="group">
                  <%= f.label :password_confirmation, "Confirmer", class: 'block text-sm font-semibold text-gray-700 mb-1 group-focus-within:text-purple-700 transition-colors duration-200' %>
                  <div class="relative">
                    <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, 
                        class: "w-full p-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-purple-700/20 focus:border-purple-700 focus:outline-none transition-all duration-300 text-gray-900 placeholder-gray-400 bg-white/80 backdrop-blur-sm hover:border-gray-300 hover:bg-white/90",
                        placeholder: "••••••••" %>
                  </div>
                </div>
              </div>
            </div>

            <!-- Submit Button -->
            <div class="pt-4">
              <button type="submit" class="w-full flex justify-center items-center py-3 px-4 border border-transparent rounded-lg shadow text-base font-bold text-white bg-gradient-to-r from-purple-700 via-purple-800 to-purple-700 hover:from-purple-800 hover:via-purple-700 hover:to-purple-800 focus:outline-none focus:ring-2 focus:ring-purple-700/30 transition-all duration-300 cursor-pointer transform hover:scale-[1.01] hover:shadow-md active:scale-[0.99] relative overflow-hidden group">
                <span class="relative z-10 flex items-center">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
                  </svg>
                  S'inscrire
                </span>
                <div class="absolute inset-0 bg-gradient-to-r from-white/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              </button>
            </div>
          <% end %>

          <!-- Sign in link -->
          <div class="mt-4 text-center">
            <p class="text-sm text-gray-600 font-medium">
              Déjà un compte ? 
              <%= link_to "Connectez-vous", new_user_session_path, class: "font-semibold text-purple-700 hover:text-purple-600 transition-colors duration-200" %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Right side - Decorative Background -->
  <div class="hidden lg:block lg:w-1/2">
    <div class="h-full w-full relative bg-gradient-to-br from-purple-700 via-purple-800 to-purple-700 overflow-hidden">
      <!-- Decorative shapes -->
      <div class="absolute top-0 right-0 w-96 h-96 bg-purple-50/20 rounded-full -translate-y-48 translate-x-48 blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-amber-500/10 rounded-full translate-y-40 -translate-x-40 blur-3xl"></div>
      <div class="absolute top-1/2 left-1/2 w-64 h-64 bg-purple-50/10 rounded-full -translate-x-1/2 -translate-y-1/2 blur-2xl"></div>
      
      <!-- Text overlay -->
      <div class="absolute inset-0 flex items-end justify-start p-12">
        <div class="text-white">
          <h3 class="text-2xl font-bold mb-2">Rejoignez Gwana</h3>
          <p class="text-lg opacity-90">Créez votre compte et commencez votre parcours</p>
        </div>
      </div>
    </div>
  </div>
</div>
