<% content_for :title, "Me connecter" %>

<div class="min-h-screen bg-gray-50 flex">
  <!-- Left side - Login Form -->
  <div class="w-full lg:w-1/2 flex flex-col justify-center px-6 sm:px-8 lg:px-16 xl:px-20 bg-gradient-to-br from-white to-gray-50">
    <div class="mx-auto w-full max-w-lg">
      <!-- Logo -->
      <div class="text-center mb-10">
        <a href="<%= root_path %>" class="inline-block transform hover:scale-105 transition-transform duration-200">
          <h1 class="text-6xl font-bold bg-gradient-to-r from-purple-700 to-purple-800 bg-clip-text text-transparent drop-shadow-lg">
            gwana
          </h1>
        </a>
        <h2 class="mt-8 text-4xl font-bold bg-gradient-to-r from-purple-700 to-purple-800 bg-clip-text text-transparent">
          Connexion
        </h2>
        <p class="mt-3 text-lg text-gray-600 font-medium">
          Accédez à votre espace personnel
        </p>
      </div>

      <!-- Login Form -->
      <div class="bg-white/80 backdrop-blur-sm py-10 px-8 shadow-2xl rounded-3xl border border-white/20 relative overflow-hidden">
        <!-- Decorative background -->
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-purple-50 to-purple-700/20 rounded-full -translate-y-16 translate-x-16 opacity-50"></div>
        <div class="absolute bottom-0 left-0 w-24 h-24 bg-gradient-to-tr from-purple-50 to-purple-700/20 rounded-full translate-y-12 -translate-x-12 opacity-50"></div>
        
        <div class="relative z-10">
          <%= form_for(resource, as: resource_name, url: session_path(resource_name), class: "space-y-8") do |f| %>
            <!-- Email Field -->
            <div class="group mb-4">
              <%= f.label :email, 'Email ou Numéro de téléphone', class: 'block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-purple-700 transition-colors duration-200 tracking-wide' %>
              <div class="relative">
                <%= f.text_field :email, 
                    autofocus: true, 
                    class: "w-full p-2 border-1 border-gray-200 rounded-xl focus:ring-4 focus:ring-purple-700/20 focus:border-purple-700 focus:outline-none transition-all duration-300 text-gray-900 placeholder-gray-400 bg-white/80 backdrop-blur-sm hover:border-gray-300 hover:bg-white/90",
                    placeholder: "votre.email@exemple.com" %>
              </div>
            </div>

            <!-- Password Field -->
            <div class="group mb-4">
              <%= f.label :password, 'Mot de passe', class: 'block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-purple-700 transition-colors duration-200 tracking-wide' %>
              <div class="relative">
                <%= f.password_field :password, 
                    class: "w-full p-2 border-1 border-gray-200 rounded-xl focus:ring-4 focus:ring-purple-700/20 focus:border-purple-700 focus:outline-none transition-all duration-300 text-gray-900 placeholder-gray-400 bg-white/80 backdrop-blur-sm hover:border-gray-300 hover:bg-white/90",
                    placeholder: "••••••••" %>
              </div>
            </div>
            
            <!-- Remember me and Forgot password -->
            <div class="flex items-center justify-between pt-2">
              <% if devise_mapping.rememberable? -%>
              <div class="flex items-center group">
                <%= f.check_box :remember_me, class: "h-5 w-5 text-purple-700 focus:ring-purple-700 border-gray-300 rounded-lg transition-all duration-200" %>
                <%= f.label :remember_me, "Se souvenir de moi", class: "ml-3 block text-sm font-semibold text-gray-700 group-hover:text-gray-900 transition-colors duration-200" %>
              </div>
              <% end -%>
              <div class="text-sm">
                <%= link_to "Mot de passe oublié ?", new_user_password_path, class: "font-bold text-purple-700 hover:text-purple-600 transition-all duration-200 hover:underline" %>
              </div>
            </div>

            <!-- Submit Button -->
            <div class="pt-4">
              <button type="submit" class="w-full flex justify-center items-center py-3 px-6 border border-transparent rounded-xl shadow-lg text-lg font-bold text-white bg-gradient-to-r from-purple-700 via-purple-800 to-purple-700 hover:from-purple-800 hover:via-purple-700 hover:to-purple-800 focus:outline-none focus:ring-4 focus:ring-purple-700/30 transition-all duration-300 cursor-pointer transform hover:scale-[1.02] hover:shadow-xl active:scale-[0.98] relative overflow-hidden group">
                <span class="relative z-10 flex items-center">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
                  </svg>
                  Se connecter
                </span>
                <div class="absolute inset-0 bg-gradient-to-r from-white/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              </button>
            </div>
          <% end %>

          <!-- Sign up link -->
          <div class="mt-8 text-center">
            <p class="text-sm text-gray-600 font-medium">
              Pas encore de compte ? 
              <%= link_to "Créer un compte", new_user_registration_path, class: "font-semibold text-purple-700 hover:text-purple-600 transition-colors duration-200" %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Right side - Decorative Background -->
  <div class="hidden lg:block lg:w-1/2">
    <div class="h-full w-full relative bg-gradient-to-br from-purple-700 via-purple-800 to-purple-700 overflow-hidden">
      <!-- Decorative shapes -->
      <div class="absolute top-0 right-0 w-96 h-96 bg-purple-50/20 rounded-full -translate-y-48 translate-x-48 blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-amber-500/10 rounded-full translate-y-40 -translate-x-40 blur-3xl"></div>
      <div class="absolute top-1/2 left-1/2 w-64 h-64 bg-purple-50/10 rounded-full -translate-x-1/2 -translate-y-1/2 blur-2xl"></div>
      
      <!-- Text overlay -->
      <div class="absolute inset-0 flex items-end justify-start p-12">
        <div class="text-white">
          <h3 class="text-2xl font-bold mb-2">Bienvenue sur Gwana</h3>
          <p class="text-lg opacity-90">Plateforme de gestion des membres</p>
        </div>
      </div>
    </div>
  </div>
</div>

