<h1>Nouvelle demande de mise à jour de profil</h1>

<p>
  Bonjour <%= @admin.gwana_profile&.full_name || @admin.email %>,
</p>

<p>
  Une nouvelle demande de mise à jour de profil a été soumise par <strong><%= @gwana.full_name %></strong>.
</p>

<% if @gwana_update_request.has_bio_update? %>
  <p>
    <strong>Bio modifiée :</strong><br>
    <%= simple_format(@gwana_update_request.bio) %>
  </p>
<% end %>

<% if @gwana_update_request.has_photo_update? %>
  <p>
    <strong>Photo modifiée</strong>
  </p>
<% end %>

<p>
  <%= link_to "Voir la demande", admin_gwana_update_request_url(@gwana_update_request, locale: I18n.locale), class: "button" %>
</p>

