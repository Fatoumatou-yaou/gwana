<% content_for :title, @gwana.full_name %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
  <!-- Header Section with Photo -->
  <div class="bg-gradient-to-br from-white via-purple-50/30 to-gray-50 rounded-2xl p-6 md:p-8 mb-8 border border-purple-700/30 shadow-xl hover:shadow-2xl transition-shadow duration-300">
    <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
      <!-- Photo -->
      <div class="flex-shrink-0">
      <% if @gwana.photo.attached? %>
          <div class="relative">
            <div class="absolute inset-0 bg-gradient-to-br from-purple-700 to-amber-500 rounded-full blur-2xl opacity-50"></div>
            <%= image_tag @gwana.photo, alt: @gwana.full_name, class: "relative w-40 h-40 rounded-full object-cover border-4 border-purple-700/50 shadow-2xl" %>
          </div>
      <% else %>
          <div class="relative">
            <div class="absolute inset-0 bg-gradient-to-br from-purple-700 to-amber-500 rounded-full blur-2xl opacity-50"></div>
            <div class="relative w-40 h-40 rounded-full bg-gradient-to-br from-purple-700 to-purple-800 flex items-center justify-center border-4 border-purple-700/50 shadow-2xl">
              <div class="text-5xl font-bold text-white">
          <%= @gwana.first_name[0].upcase %><%= @gwana.last_name[0].upcase %>
        </div>
            </div>
          </div>
      <% end %>
    </div>

      <!-- Name and Basic Info -->
      <div class="flex-1 text-center md:text-left">
        <h1 class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-amber-500 to-amber-400 bg-clip-text text-transparent mb-3">
          <%= @gwana.full_name %>
        </h1>
        <p class="text-2xl text-amber-500 font-semibold mb-4"><%= @gwana.profession %></p>
        
        <!-- Location Info -->
        <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 mb-4 text-gray-700">
          <% if @gwana.region.present? %>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span><%= @gwana.region %></span>
              <% if @gwana.commune.present? %>
                <span class="text-gray-500">• <%= @gwana.commune.name %></span>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Badge and Social Links -->
        <div class="flex flex-wrap items-center justify-center md:justify-start gap-4">
          <% if @gwana.available_for_mentorship? %>
            <span class="inline-flex items-center gap-2 bg-gradient-to-r from-purple-700/30 to-purple-800/30 text-amber-500 font-semibold px-5 py-2 rounded-full border border-amber-500/30 shadow-lg">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
              Disponible pour mentorat
            </span>
    <% end %>

          <!-- Social Links -->
          <div class="flex items-center gap-3">
      <% if @gwana.linkedin_url.present? %>
              <%= link_to @gwana.linkedin_url, target: "_blank", rel: "noopener", class: "w-10 h-10 flex items-center justify-center bg-purple-700/20 hover:bg-purple-700/40 text-amber-500 rounded-full transition-all hover:scale-110 border border-purple-700/30" do %>
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
        <% end %>
      <% end %>
      <% if @gwana.twitter_url.present? %>
              <%= link_to @gwana.twitter_url, target: "_blank", rel: "noopener", class: "w-10 h-10 flex items-center justify-center bg-purple-700/20 hover:bg-purple-700/40 text-amber-500 rounded-full transition-all hover:scale-110 border border-purple-700/30" do %>
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/></svg>
        <% end %>
      <% end %>
      <% if @gwana.website_url.present? %>
              <%= link_to @gwana.website_url, target: "_blank", rel: "noopener", class: "w-10 h-10 flex items-center justify-center bg-purple-700/20 hover:bg-purple-700/40 text-amber-500 rounded-full transition-all hover:scale-110 border border-purple-700/30" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
    <!-- Left Column - Main Info -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Biographie -->
      <% if @gwana.bio.present? %>
        <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
              <svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-amber-500">Biographie</h2>
          </div>
          <div class="gwana-bio text-gray-700 leading-relaxed break-words overflow-wrap-anywhere">
            <%= simple_format(@gwana.bio) %>
          </div>
        </div>
      <% end %>

      <!-- Expériences -->
      <% if @gwana.experiences.present? %>
        <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
              <svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-amber-500">Expériences professionnelles</h2>
          </div>
          <div class="gwana-bio text-gray-700 leading-relaxed break-words overflow-wrap-anywhere">
            <%= simple_format(@gwana.experiences) %>
          </div>
        </div>
      <% end %>

      <!-- Formations -->
      <% if @gwana.formations.present? %>
        <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
              <svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-amber-500">Formations</h2>
          </div>
          <div class="gwana-bio text-gray-700 leading-relaxed break-words overflow-wrap-anywhere">
            <%= simple_format(@gwana.formations) %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Right Column - Sidebar Info -->
    <div class="space-y-6 lg:sticky lg:top-6 lg:self-start">
      <!-- Compétences -->
      <% if @gwana.skills.present? && @gwana.skills_array.any? %>
        <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
              <svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
              </svg>
            </div>
            <h2 class="text-xl font-bold text-amber-500">Compétences</h2>
          </div>
          <div class="flex flex-wrap gap-2">
            <% @gwana.skills_array.each do |skill| %>
              <span class="bg-purple-700/20 text-amber-500 px-4 py-2 rounded-full text-sm font-medium border border-purple-700/30 hover:bg-purple-700/30 hover:border-purple-700/50 transition-all duration-200 cursor-default">
                <%= skill %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Call to Action - Demander mentorat -->
      <% if @gwana.available_for_mentorship? %>
        <div class="bg-gradient-to-br from-purple-700 via-purple-800 to-purple-900 rounded-xl p-6 border border-amber-500/30 shadow-lg hover:shadow-xl transition-all duration-300">
          <div class="text-center mb-4">
            <div class="w-16 h-16 bg-amber-500/20 rounded-full flex items-center justify-center mx-auto mb-3">
              <svg class="w-8 h-8 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Intéressé(e) par un mentorat ?</h3>
            <p class="text-gray-200 text-sm mb-4">Contactez <%= @gwana.first_name %> pour discuter de vos objectifs professionnels</p>
          </div>
          <% if user_signed_in? %>
            <% if current_user.user? && @gwana.user != current_user %>
              <%= link_to new_mentorship_request_path(mentor_id: @gwana.user_id), class: "block w-full bg-amber-500 hover:bg-amber-400 text-purple-900 font-bold px-6 py-3 rounded-lg transition-all transform hover:scale-105 shadow-lg text-center" do %>
                <span class="flex items-center justify-center gap-2">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                  </svg>
                  Demander un mentorat
                </span>
              <% end %>
            <% elsif current_user == @gwana.user %>
              <p class="text-gray-300 text-sm text-center">C'est votre propre profil</p>
            <% else %>
              <p class="text-gray-300 text-sm text-center">Seuls les membres peuvent demander un mentorat</p>
            <% end %>
          <% else %>
            <%= link_to new_user_session_path, class: "block w-full bg-amber-500 hover:bg-amber-400 text-purple-900 font-bold px-6 py-3 rounded-lg transition-all transform hover:scale-105 shadow-lg text-center" do %>
              <span class="flex items-center justify-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Se connecter pour demander un mentorat
              </span>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
