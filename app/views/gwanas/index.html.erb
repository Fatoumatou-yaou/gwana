<% content_for :title, "Gwanas" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10" data-controller="filters-toggle">
  <!-- Header -->
  <div class="mb-8 sm:mb-12">
    <h1 class="text-3xl sm:text-5xl font-bold mb-3 sm:mb-4 text-center text-purple-600"
      >Répertoire des Gwanas
    </h1>
    <p class="text-gray-600 text-base sm:text-lg text-center">Découvrez notre réseau de femmes pionnières et expertes</p>
  </div>

  <!-- Mobile Filter Button -->
  <div class="lg:hidden mb-6">
    <button 
      type="button"
      data-action="click->filters-toggle#toggle"
      data-filters-toggle-target="button"
      class="w-full flex items-center justify-center gap-3 bg-white border-2 border-purple-600 text-purple-600 px-6 py-4 rounded-2xl font-semibold transition-all duration-300 shadow-lg hover:shadow-xl transform hover:scale-[1.02] active:scale-[0.98]"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
      </svg>
      <span>Filtres</span>
    </button>
  </div>

  <!-- Mobile Filters Overlay -->
  <div 
    data-filters-toggle-target="overlay"
    class="lg:hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-40 hidden transition-opacity duration-300"
    data-action="click->filters-toggle#close"
  ></div>

  <!-- Mobile Filters Panel -->
  <div 
    data-filters-toggle-target="panel"
    class="lg:hidden fixed top-0 right-0 h-full w-full max-w-md bg-white/95 backdrop-blur-xl z-50 shadow-2xl hidden flex-col transform translate-x-full transition-all duration-300 ease-out overflow-hidden"
  >
    <!-- Panel Header -->
    <div class="flex items-center justify-between p-6 border-b border-gray-200/50 bg-gradient-to-r from-purple-50/50 to-transparent flex-shrink-0">
      <h2 class="text-2xl font-bold text-gray-900">Filtres</h2>
      <button 
        type="button"
        data-action="click->filters-toggle#close"
        class="p-2 rounded-full hover:bg-gray-100 transition-colors"
        aria-label="Fermer les filtres"
      >
        <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Panel Content -->
    <div class="flex-1 overflow-y-auto overflow-x-hidden" style="padding-bottom: env(safe-area-inset-bottom, 0);">
      <div class="p-6" style="padding-bottom: 12rem;">
        <%= form_with url: gwanas_path, method: :get, local: true, class: "space-y-6" do |f| %>
          <!-- Search -->
          <div>
            <%= f.label :search, "Recherche", class: "block text-sm font-semibold text-gray-900 mb-2" %>
            <%= f.text_field :search, 
                placeholder: "Nom, profession, compétences...", 
                value: params[:search], 
                class: "w-full px-4 py-3.5 bg-white/80 backdrop-blur-sm border-2 border-gray-200 rounded-xl text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-700/30 focus:border-purple-700 transition-all shadow-sm" %>
          </div>

          <!-- Region -->
          <div class="relative" data-controller="custom-select">
            <%= f.label :region, "Région", class: "block text-sm font-semibold text-gray-900 mb-2" %>
            <%= f.hidden_field :region, value: params[:region], data: { custom_select_target: "input" } %>
            <button
              type="button"
              data-custom-select-target="button"
              data-action="click->custom-select#toggle"
              data-placeholder="Toutes les régions"
              class="w-full px-4 py-3.5 pr-10 bg-white border-2 border-gray-200 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-purple-700/30 focus:border-purple-700 transition-all shadow-sm text-left flex items-center justify-between"
            >
              <span><%= params[:region].present? ? params[:region] : "Toutes les régions" %></span>
              <svg class="w-5 h-5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div 
              data-custom-select-target="menu"
              class="hidden absolute z-50 w-full mt-1 bg-white border-2 border-gray-200 rounded-xl shadow-xl max-h-60 overflow-y-auto"
            >
              <button
                type="button"
                data-action="click->custom-select#selectOption"
                data-value=""
                class="w-full px-4 py-3 text-left text-gray-900 hover:bg-purple-50 transition-colors <%= 'bg-purple-50 font-semibold' if params[:region].blank? %>">
                Toutes les régions
              </button>
              <% Region.ordered.each do |region| %>
                <button
                  type="button"
                  data-action="click->custom-select#selectOption"
                  data-value="<%= region.name %>"
                  class="w-full px-4 py-3 text-left text-gray-900 hover:bg-purple-50 transition-colors <%= 'bg-purple-50 font-semibold' if params[:region] == region.name %>"
                >
                  <%= region.name %>
                </button>
              <% end %>
            </div>
          </div>

          <!-- Available for mentorship -->
          <div class="flex items-center p-4 bg-purple-50/50 rounded-xl border-2 border-purple-100">
            <%= f.check_box :available, 
                { checked: params[:available] == "true", 
                  class: "w-5 h-5 text-purple-700 bg-white border-2 border-gray-300 rounded-lg focus:ring-purple-700/50 focus:ring-2 transition-all" }, 
                "true", 
                "" %>
            <%= f.label :available, "Disponible pour mentorat uniquement", class: "ml-3 text-gray-900 font-medium cursor-pointer hover:text-purple-700 transition-colors" %>
          </div>

          <!-- Submit Button -->
          <div class="pt-4 space-y-3">
            <%= f.submit "Appliquer les filtres", class: "w-full bg-gradient-to-r from-purple-700 to-purple-800 hover:from-purple-800 hover:to-purple-700 text-white px-6 py-4 rounded-xl font-semibold transition-all duration-300 shadow-lg hover:shadow-xl transform hover:scale-[1.02] active:scale-[0.98]" %>
            <% if params[:search].present? || params[:region].present? || params[:available] == "true" %>
              <%= link_to "Réinitialiser", gwanas_path, class: "block w-full text-center bg-gray-100 hover:bg-gray-200 text-gray-900 px-6 py-4 rounded-xl font-semibold transition-all duration-300" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Desktop Filters -->
  <div class="hidden lg:block mb-10">
    <div class="bg-white/80 backdrop-blur-xl rounded-3xl p-8 border border-gray-200/50 shadow-xl">
      <%= form_with url: gwanas_path, method: :get, local: true, class: "space-y-6" do |f| %>
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-end">
          <div class="md:col-span-5">
            <%= f.label :search, "Recherche", class: "block text-sm font-semibold text-gray-900 mb-2" %>
            <%= f.text_field :search, 
                placeholder: "Rechercher par nom, profession, compétences...", 
                value: params[:search], 
                class: "w-full px-5 py-4 bg-white/90 backdrop-blur-sm border-2 border-gray-200 rounded-xl text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-700/30 focus:border-purple-700 transition-all shadow-sm" %>
          </div>
          <div class="md:col-span-4 relative" data-controller="custom-select">
            <%= f.label :region, "Région", class: "block text-sm font-semibold text-gray-900 mb-2" %>
            <%= f.hidden_field :region, value: params[:region], data: { custom_select_target: "input" } %>
            <button
              type="button"
              data-custom-select-target="button"
              data-action="click->custom-select#toggle"
              data-placeholder="Toutes les régions"
              class="w-full px-5 py-4 pr-10 bg-white border-2 border-gray-200 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-purple-700/30 focus:border-purple-700 transition-all shadow-sm text-left flex items-center justify-between"
            >
              <span><%= params[:region].present? ? params[:region] : "Toutes les régions" %></span>
              <svg class="w-5 h-5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div 
              data-custom-select-target="menu"
              class="hidden absolute z-50 w-full mt-1 bg-white border-2 border-gray-200 rounded-xl shadow-xl max-h-60 overflow-y-auto"
            >
              <button
                type="button"
                data-action="click->custom-select#selectOption"
                data-value=""
                class="w-full px-5 py-3 text-left text-gray-900 hover:bg-purple-50 transition-colors <%= 'bg-purple-50 font-semibold' if params[:region].blank? %>">
                Toutes les régions
              </button>
              <% Region.ordered.each do |region| %>
                <button
                  type="button"
                  data-action="click->custom-select#selectOption"
                  data-value="<%= region.name %>"
                  class="w-full px-5 py-3 text-left text-gray-900 hover:bg-purple-50 transition-colors <%= 'bg-purple-50 font-semibold' if params[:region] == region.name %>">
                  <%= region.name %>
                </button>
              <% end %>
            </div>
          </div>
          <div class="md:col-span-3">
            <%= f.submit "Rechercher", class: "w-full bg-gradient-to-r from-purple-700 to-purple-800 hover:from-purple-800 hover:to-purple-700 text-white px-6 py-4 rounded-xl font-semibold transition-all duration-300 shadow-lg hover:shadow-xl transform hover:scale-[1.02] active:scale-[0.98]" %>
          </div>
        </div>
        <div class="flex items-center p-4 bg-purple-50/50 rounded-xl border-2 border-purple-100">
          <%= f.check_box :available, 
              { checked: params[:available] == "true", 
                class: "w-5 h-5 text-purple-700 bg-white border-2 border-gray-300 rounded-lg focus:ring-purple-700/50 focus:ring-2 transition-all" }, 
              "true", 
              "" %>
          <%= f.label :available, "Disponible pour mentorat uniquement", class: "ml-3 text-gray-900 font-medium cursor-pointer hover:text-purple-700 transition-colors" %>
        </div>
        <% if params[:search].present? || params[:region].present? || params[:available] == "true" %>
          <div class="pt-2">
            <%= link_to "Réinitialiser les filtres", gwanas_path, class: "text-sm text-purple-700 hover:text-purple-800 font-medium transition-colors" %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Gwanas Grid -->
  <% if @gwanas.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      <% @gwanas.each do |gwana| %>
        <%= link_to gwana_path(gwana), class: "group block" do %>
          <div class="bg-white/90 backdrop-blur-sm rounded-3xl p-6 sm:p-8 border-2 border-gray-200/50 hover:border-purple-700/40 transition-all duration-500 shadow-lg hover:shadow-2xl transform hover:-translate-y-2 relative overflow-hidden h-full">
            <!-- Decorative gradient overlay on hover -->
            <div class="absolute inset-0 bg-gradient-to-br from-purple-700/5 via-transparent to-amber-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            
            <div class="relative z-10">
              <!-- Photo Section -->
              <div class="flex justify-center mb-6">
                <% if gwana.photo.attached? %>
                  <div class="relative">
                    <div class="absolute inset-0 bg-gradient-to-br from-purple-700 to-amber-500 rounded-full blur-xl opacity-40 group-hover:opacity-60 transition-opacity duration-500"></div>
                    <%= image_tag gwana.photo, alt: gwana.full_name, class: "relative w-28 h-28 sm:w-32 sm:h-32 rounded-full object-cover border-4 border-purple-700/20 group-hover:border-amber-500/40 transition-all duration-500 transform group-hover:scale-110 shadow-xl" %>
                  </div>
                <% else %>
                  <div class="relative">
                    <div class="absolute inset-0 bg-gradient-to-br from-purple-700 to-amber-500 rounded-full blur-xl opacity-40 group-hover:opacity-60 transition-opacity duration-500"></div>
                    <div class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-full bg-gradient-to-br from-purple-700 to-purple-800 flex items-center justify-center border-4 border-purple-700/20 group-hover:border-amber-500/40 transition-all duration-500 transform group-hover:scale-110 shadow-xl">
                      <div class="text-3xl sm:text-4xl font-bold text-white">
                        <%= gwana.first_name[0].upcase %><%= gwana.last_name[0].upcase %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>

              <!-- Name and Title -->
              <div class="text-center mb-5">
                <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-2 group-hover:text-purple-700 transition-colors duration-300">
                  <%= gwana.full_name %>
                </h3>
                <p class="text-amber-500 font-semibold text-sm sm:text-base mb-2"><%= gwana.profession %></p>
                <p class="text-gray-600 text-xs sm:text-sm flex items-center justify-center gap-1.5">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  <%= gwana.region %>
                </p>
              </div>

              <!-- Bio Preview -->
              <% if gwana.bio.present? %>
                <p class="text-gray-600 text-sm mb-5 line-clamp-2 text-center leading-relaxed">
                  <%= truncate(gwana.bio, length: 120) %>
                </p>
              <% end %>

              <!-- Skills -->
              <% if gwana.skills.present? && gwana.skills_array.any? %>
                <div class="flex flex-wrap gap-2 justify-center mb-5">
                  <% gwana.skills_array.first(3).each do |skill| %>
                    <span class="bg-purple-700/10 text-purple-700 text-xs px-3 py-1.5 rounded-full border border-purple-700/20 font-medium">
                      <%= skill %>
                    </span>
                  <% end %>
                  <% if gwana.skills_array.length > 3 %>
                    <span class="text-gray-500 text-xs px-2 py-1.5">+<%= gwana.skills_array.length - 3 %></span>
                  <% end %>
                </div>
              <% end %>

              <!-- Badges -->
              <div class="flex items-center justify-center gap-2 mt-6">
                <% if gwana.available_for_mentorship? %>
                  <span class="inline-flex items-center gap-1.5 bg-gradient-to-r from-purple-700/10 to-purple-800/10 text-black text-xs font-semibold px-4 py-2 rounded-full border-2 border-purple-700/20">
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    Disponible pour mentorat
                  </span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-20 sm:py-24">
      <div class="max-w-md mx-auto">
        <svg class="mx-auto h-20 w-20 sm:h-24 sm:w-24 text-gray-400 mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
        </svg>
        <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">Aucun résultat trouvé</h3>
        <p class="text-gray-600 mb-8 text-lg">Essayez de modifier vos critères de recherche</p>
        <%= link_to "Réinitialiser les filtres", gwanas_path, class: "inline-block bg-gradient-to-r from-purple-700 to-purple-800 hover:from-purple-800 hover:to-purple-700 text-white px-8 py-4 rounded-xl font-semibold transition-all duration-300 shadow-lg hover:shadow-xl transform hover:scale-[1.02] active:scale-[0.98]" %>
      </div>
    </div>
  <% end %>
</div>
