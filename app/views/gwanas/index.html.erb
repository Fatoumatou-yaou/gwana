<% content_for :title, "Gwanas" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="mb-10">
    <h1 class="text-5xl font-bold mb-4 bg-gradient-to-r from-purple-700 via-amber-500 to-purple-700 bg-clip-text text-transparent">
      Répertoire des Gwanas
    </h1>
    <p class="text-gray-600 text-lg">Découvrez notre réseau de femmes pionnières et expertes</p>
  </div>

  <!-- Search and Filters -->
  <div class="bg-white rounded-xl p-6 mb-10 border border-gray-200 shadow-sm">
    <%= form_with url: gwanas_path, method: :get, local: true, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="md:col-span-2">
          <%= f.text_field :search, placeholder: "Rechercher par nom, profession, compétences...", value: params[:search], class: "w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-700/20 focus:border-purple-700 transition-all" %>
        </div>
        <div>
          <%= f.select :region, options_for_select([["Toutes les régions", ""]] + Gwana.distinct.pluck(:region).compact.map { |r| [r, r] }, params[:region]), {}, { class: "w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-purple-700/20 focus:border-purple-700 transition-all" } %>
        </div>
        <div>
          <%= f.submit "Rechercher", class: "w-full bg-gradient-to-r from-purple-700 to-purple-800 hover:from-purple-800 hover:to-purple-700 text-white px-4 py-3 rounded-lg font-semibold transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5" %>
        </div>
      </div>
      <div class="flex items-center pt-2">
        <%= f.check_box :available, { checked: params[:available] == "true", class: "w-4 h-4 text-purple-700 bg-white border-gray-300 rounded focus:ring-purple-700/50" }, "true", "" %>
        <%= f.label :available, "Disponible pour mentorat uniquement", class: "ml-3 text-gray-700 cursor-pointer hover:text-gray-900 transition-colors" %>
      </div>
    <% end %>
  </div>

  <!-- Gwanas Grid -->
  <% if @gwanas.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% @gwanas.each do |gwana| %>
        <%= link_to gwana_path(gwana), class: "group block" do %>
          <div class="bg-white rounded-xl p-6 border border-gray-200 hover:border-purple-700/60 transition-all duration-300 shadow-lg hover:shadow-2xl transform hover:-translate-y-2 relative overflow-hidden">
            <!-- Decorative gradient overlay on hover -->
            <div class="absolute inset-0 bg-gradient-to-br from-purple-700/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            
            <div class="relative z-10">
              <!-- Photo Section -->
              <div class="flex justify-center mb-6">
          <% if gwana.photo.attached? %>
                  <div class="relative">
                    <div class="absolute inset-0 bg-gradient-to-br from-purple-700 to-amber-500 rounded-full blur-lg opacity-50 group-hover:opacity-75 transition-opacity"></div>
                    <%= image_tag gwana.photo, alt: gwana.full_name, class: "relative w-32 h-32 rounded-full object-cover border-4 border-purple-700/30 group-hover:border-amber-500/50 transition-all duration-300 transform group-hover:scale-105 shadow-xl" %>
                  </div>
          <% else %>
                  <div class="relative">
                    <div class="absolute inset-0 bg-gradient-to-br from-purple-700 to-amber-500 rounded-full blur-lg opacity-50 group-hover:opacity-75 transition-opacity"></div>
                    <div class="relative w-32 h-32 rounded-full bg-gradient-to-br from-purple-700 to-purple-800 flex items-center justify-center border-4 border-purple-700/30 group-hover:border-amber-500/50 transition-all duration-300 transform group-hover:scale-105 shadow-xl">
                      <div class="text-4xl font-bold text-white">
              <%= gwana.first_name[0].upcase %><%= gwana.last_name[0].upcase %>
                      </div>
                    </div>
            </div>
          <% end %>
              </div>

              <!-- Name and Title -->
              <div class="text-center mb-4">
                <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-amber-500 transition-colors">
                  <%= gwana.full_name %>
          </h3>
                <p class="text-amber-500 font-medium text-sm mb-1"><%= gwana.profession %></p>
                <p class="text-gray-600 text-xs flex items-center justify-center gap-1">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  <%= gwana.region %>
                </p>
              </div>

              <!-- Bio Preview -->
              <% if gwana.bio.present? %>
                <p class="text-gray-600 text-sm mb-4 line-clamp-2 text-center">
                  <%= truncate(gwana.bio, length: 100) %>
                </p>
              <% end %>

              <!-- Skills -->
              <% if gwana.skills.present? && gwana.skills_array.any? %>
                <div class="flex flex-wrap gap-2 justify-center mb-4">
                  <% gwana.skills_array.first(3).each do |skill| %>
                    <span class="bg-purple-700/20 text-amber-500 text-xs px-3 py-1 rounded-full border border-purple-700/30">
                      <%= skill %>
                    </span>
                  <% end %>
                  <% if gwana.skills_array.length > 3 %>
                    <span class="text-gray-500 text-xs px-2 py-1">+<%= gwana.skills_array.length - 3 %></span>
                  <% end %>
                </div>
              <% end %>

              <!-- Badges -->
              <div class="flex items-center justify-center gap-2 mt-4">
          <% if gwana.available_for_mentorship? %>
                  <span class="inline-flex items-center gap-1 bg-gradient-to-r from-purple-700/30 to-purple-800/30 text-amber-500 text-xs font-semibold px-4 py-2 rounded-full border border-amber-500/30">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    Disponible pour mentorat
                  </span>
          <% end %>
        </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-20">
      <div class="max-w-md mx-auto">
        <svg class="mx-auto h-24 w-24 text-gray-600 mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
        </svg>
        <h3 class="text-2xl font-semibold text-gray-700 mb-2">Aucun résultat trouvé</h3>
        <p class="text-gray-500 mb-6">Essayez de modifier vos critères de recherche</p>
        <%= link_to "Réinitialiser les filtres", gwanas_path, class: "inline-block bg-purple-700 hover:bg-purple-800 text-white px-6 py-3 rounded-lg font-semibold transition-colors" %>
      </div>
    </div>
  <% end %>
</div>
