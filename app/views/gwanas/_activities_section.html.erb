<!-- Activités -->
<% if @gwana.activities.any? %>
  <div class="bg-gradient-to-br from-white via-purple-50/30 to-gray-50 rounded-2xl p-8 border border-purple-700/30 shadow-xl hover:shadow-2xl transition-all duration-500 overflow-hidden relative">
    <!-- Decorative background elements -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-br from-purple-700/5 to-transparent rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-48 h-48 bg-gradient-to-tr from-amber-500/5 to-transparent rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10">
      <!-- Header -->
      <div class="flex items-center justify-between mb-8">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-purple-700 to-purple-800 flex items-center justify-center shadow-lg transform hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
          </div>
          <div>
            <h2 class="text-3xl font-bold bg-gradient-to-r from-amber-500 to-amber-400 bg-clip-text text-transparent">Activités</h2>
            <p class="text-sm text-gray-600 mt-1"><%= @gwana.activities.count %> activité<%= "s" if @gwana.activities.count > 1 %> réalisée<%= "s" if @gwana.activities.count > 1 %></p>
          </div>
        </div>
      </div>

      <!-- Activities Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% @gwana.activities.recent.each do |activity| %>
          <%= link_to gwana_activity_path(activity), class: "group block" do %>
            <article class="relative h-full bg-white rounded-2xl overflow-hidden border border-gray-200/50 hover:border-purple-700/50 transition-all duration-500 transform hover:scale-[1.02] hover:shadow-2xl hover:shadow-purple-700/20">
              <!-- Shine effect on hover -->
              <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-1000 pointer-events-none z-10"></div>
              
              <!-- Media Section -->
              <div class="relative h-48 overflow-hidden bg-gradient-to-br from-gray-100 to-gray-200">
                <% if activity.has_video? %>
                  <div class="relative w-full h-full">
                    <img 
                      src="<%= activity.youtube_thumbnail_url %>" 
                      alt="<%= activity.description.truncate(50) %>" 
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" 
                    />
                    <!-- Gradient overlay -->
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
                    <!-- Play button -->
                    <div class="absolute inset-0 flex items-center justify-center">
                      <div class="w-20 h-20 bg-red-600 rounded-full flex items-center justify-center shadow-2xl transform group-hover:scale-110 transition-transform duration-300">
                        <svg class="w-10 h-10 text-white ml-1" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/>
                        </svg>
                      </div>
                    </div>
                    <!-- Video badge -->
                    <div class="absolute top-4 left-4 z-20">
                      <span class="px-3 py-1.5 bg-red-600/90 backdrop-blur-sm text-white text-xs font-semibold rounded-full border border-white/20 shadow-lg flex items-center gap-1.5">
                        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM14.553 7.106A1 1 0 0014 8v4a1 1 0 00.553.894l2 1A1 1 0 0018 13V7a1 1 0 00-1.447-.894l-2 1z"/>
                        </svg>
                        Vidéo
                      </span>
                    </div>
                  </div>
                <% elsif activity.has_photos? %>
                  <div class="relative w-full h-full">
                    <div class="grid grid-cols-2 h-full gap-1">
                      <% activity.photos.first(4).each_with_index do |photo, index| %>
                        <div class="<%= 'col-span-2' if index == 0 && activity.photos.count == 1 %> overflow-hidden">
                          <%= image_tag photo, class: "w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" %>
                        </div>
                      <% end %>
                    </div>
                    <!-- Gradient overlay -->
                    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
                    <!-- Photo count badge -->
                    <% if activity.photos.count > 4 %>
                      <div class="absolute top-4 right-4 z-20">
                        <span class="px-3 py-1.5 bg-white/90 backdrop-blur-sm text-purple-700 text-xs font-semibold rounded-full border border-purple-700/20 shadow-lg flex items-center gap-1.5">
                          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/>
                          </svg>
                          +<%= activity.photos.count - 4 %>
                        </span>
                      </div>
                    <% end %>
                  </div>
                <% else %>
                  <div class="w-full h-full bg-gradient-to-br from-purple-700/20 via-purple-500/10 to-amber-500/10 flex items-center justify-center">
                    <svg class="w-20 h-20 text-purple-700/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                  </div>
                <% end %>

                <!-- Activity Type Badge -->
                <div class="absolute bottom-4 left-4 z-20">
                  <span class="px-4 py-2 bg-purple-700/90 backdrop-blur-md text-white text-sm font-bold rounded-xl border border-white/20 shadow-xl">
                    <%= activity.activity_type.humanize %>
                  </span>
                </div>
              </div>

              <!-- Content Section -->
              <div class="p-6 bg-white">
                <!-- Date -->
                <div class="flex items-center gap-2 mb-4 text-xs text-gray-500">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  <time datetime="<%= activity.activity_date %>">
                    <%= l(activity.activity_date, format: :long) %>
                  </time>
                </div>

                <!-- Description -->
                <p class="text-gray-800 text-base leading-relaxed mb-4 line-clamp-3 break-words overflow-hidden font-medium">
                  <%= activity.description %>
                </p>

                <!-- CTA -->
                <div class="flex items-center gap-2 text-purple-700 font-semibold text-sm group-hover:gap-3 transition-all duration-300">
                  <span>Voir les détails</span>
                  <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </div>
              </div>
            </article>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
