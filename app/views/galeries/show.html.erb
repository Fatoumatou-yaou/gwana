<% content_for :title, @network_event.name %>

<div class="min-h-screen bg-white">
  <!-- En-tête avec retour -->
  <header class="sticky top-0 z-10 bg-white/95 backdrop-blur border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <%= link_to galeries_path, class: "flex items-center justify-center w-10 h-10 rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      <% end %>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-4 py-6">
    <div class="mb-8">
      <h1 class="text-3xl sm:text-5xl font-bold mb-3 sm:mb-4 text-center text-purple-600"><%= @network_event.name %></h1>
      <p class="text-base sm:text-lg text-gray-600 text-center"><%= l(@network_event.event_date, format: :long) %></p>
    </div>

    <% if @network_event.description.present? %>
      <div class="mb-8 p-4 md:p-6 bg-gray-50 rounded-2xl">
        <p class="text-gray-700 text-sm md:text-base leading-relaxed whitespace-pre-wrap"><%= @network_event.description %></p>
      </div>
    <% end %>

    <% if @network_event.photos.attached? %>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-2 md:gap-4">
        <% @network_event.photos.each do |photo| %>
          <div class="relative group rounded-2xl overflow-hidden bg-gray-100 aspect-[4/3]">
            <%= image_tag photo, class: "w-full h-full object-cover rounded-2xl", loading: "lazy" %>
            <a href="<%= url_for(photo) %>" target="_blank" rel="noopener" class="absolute bottom-2 right-2 flex items-center justify-center w-9 h-9 rounded-full bg-white/90 text-gray-700 hover:bg-white shadow-sm transition-opacity opacity-0 group-hover:opacity-100" aria-label="Agrandir">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
            </a>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="py-16 text-center rounded-2xl bg-gray-50">
        <p class="text-gray-500">Aucune photo pour cet événement.</p>
      </div>
    <% end %>
  </main>
</div>
