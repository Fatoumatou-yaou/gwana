<% content_for :title, "Galerie des événements" %>

<div class="min-h-screen bg-white">
  <!-- En-tête style référence : titre + sous-titre avec compteur -->
  <header class="max-w-6xl mx-auto px-4 pt-6 pb-4">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <h1 class="text-3xl sm:text-5xl font-bold mb-3 sm:mb-4 text-center text-purple-600">Galerie</h1>
      <p class="text-base sm:text-lg text-gray-600 text-center">Découvrez les moments forts de notre réseau</p>
    </div>

  </header>

  <% if @featured_event && @featured_event.photos.attached? %>
    <!-- Grille type masonry : photos du premier événement -->
    <section class="max-w-6xl mx-auto px-4 pb-6">
      <div class="galerie-masonry">
        <% @featured_event.photos.each do |photo| %>
          <%= link_to galery_path(@featured_event), class: "galerie-masonry-item block relative rounded-2xl overflow-hidden bg-gray-100 group" do %>
            <%= image_tag photo, class: "w-full h-auto object-cover rounded-2xl transition-transform duration-300 group-hover:scale-[1.02]", loading: "lazy" %>
            <span class="absolute bottom-2 right-2 flex items-center justify-center w-9 h-9 rounded-full bg-white/90 text-gray-600 shadow-sm opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none" aria-hidden="true">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
            </span>
          <% end %>
        <% end %>
      </div>
    </section>

    <!-- Section "Autres événements" : bloc style "People" avec lien vers le show de chaque événement -->
    <% if @other_events&.any? %>
      <section class="border-t border-gray-100 bg-gray-50/50">
        <div class="max-w-6xl mx-auto px-4 py-4 md:py-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Autres événements</h2>
          <div class="space-y-3">
            <% @other_events.each do |event| %>
              <%= link_to galery_path(event), class: "flex items-center justify-between gap-4 p-4 bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md hover:border-purple-100 transition-all duration-200 group" do %>
                <div class="flex items-center gap-4 min-w-0 flex-1">
                  <% if event.photos.attached? %>
                    <div class="flex-shrink-0 w-14 h-14 md:w-16 md:h-16 rounded-xl overflow-hidden bg-gray-100">
                      <%= image_tag event.photos.first, class: "w-full h-full object-cover", loading: "lazy" %>
                    </div>
                  <% else %>
                    <div class="flex-shrink-0 w-14 h-14 md:w-16 md:h-16 rounded-xl bg-gradient-to-br from-purple-100 to-blue-100 flex items-center justify-center">
                      <svg class="w-7 h-7 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    </div>
                  <% end %>
                  <div class="min-w-0">
                    <h3 class="font-semibold text-gray-900 truncate group-hover:text-purple-700 transition-colors"><%= event.name %></h3>
                    <p class="text-sm text-gray-500"><%= event.photos_count %> photo<%= event.photos_count != 1 ? "s" : "" %></p>
                  </div>
                </div>
                <span class="flex-shrink-0 flex items-center justify-center w-9 h-9 rounded-full bg-gray-100 text-gray-500 group-hover:bg-purple-100 group-hover:text-purple-700 transition-colors">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>
  <% else %>
    <!-- Aucun événement ou aucune photo : liste des événements (dont le premier si pas de photos) -->
    <section class="max-w-6xl mx-auto px-4 py-16">
      <p class="text-gray-500 mb-6 text-center">Aucune photo disponible pour le moment.</p>
      <% events_to_list = (@featured_event ? [@featured_event] : []) + (@other_events&.to_a || []) %>
      <% if events_to_list.any? %>
        <h2 class="text-lg font-semibold text-gray-900 mb-3"><%= @featured_event && !@featured_event.photos.attached? ? "Événements" : "Autres événements" %></h2>
        <div class="space-y-3 max-w-md mx-auto">
          <% events_to_list.each do |event| %>
            <%= link_to galery_path(event), class: "flex items-center justify-between gap-4 p-4 bg-gray-50 rounded-2xl hover:bg-gray-100 transition-colors group" do %>
              <span class="font-medium text-gray-900"><%= event.name %></span>
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>

  <% unless @featured_event || @other_events&.any? %>
    <section class="max-w-6xl mx-auto px-4 py-24 text-center">
      <p class="text-gray-500">Les galeries seront bientôt disponibles.</p>
    </section>
  <% end %>
</div>
