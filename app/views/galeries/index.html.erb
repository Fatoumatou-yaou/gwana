<% content_for :title, "Galerie des événements" %>

<div class="min-h-screen bg-white">
  <!-- En-tête -->
    <div class="max-w-7xl mx-auto px-4 text-center">
      <h1 class="text-3xl sm:text-5xl font-bold mb-3 sm:mb-4 text-center text-purple-600">Galerie</h1>
      <p class="text-base sm:text-lg text-gray-600 text-center">Découvrez les moments forts de notre réseau</p>
    </div>

  <!-- Premier événement avec effet pixel -->
  <% if @featured_event %>
    <section class="py-16">
      <div class="max-w-7xl mx-auto px-4">
        <!-- Photos avec effet pixel -->
        <% if @featured_event.photos.attached? %>
          <div class="space-y-12 md:space-y-16" data-controller="pixel-scroll">
            <% photos_array = @featured_event.photos.to_a %>
            <% skip_next = false %>
            <% photos_array.each_with_index do |photo, index| %>
              <% if skip_next %>
                <% skip_next = false %>
                <% next %>
              <% end %>
              
              <% if index == 0 %>
                <!-- Première photo avec titre et description à droite, alignés en bas -->
                <div class="mb-12">
                  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 items-end">
                    <div class="pixel-image-container w-full max-w-lg mx-auto lg:mx-0" data-pixel-scroll-target="container">
                      <%= image_tag photo, 
                          class: "hidden", 
                          data: { pixel_scroll_target: "source" },
                          loading: "lazy" %>
                      <canvas 
                        data-pixel-scroll-target="canvas" 
                        class="w-full h-auto rounded-lg shadow-lg"
                        style="display: block;"
                      ></canvas>
                    </div>
                    
                    <!-- Titre et description à droite, alignés en bas -->
                    <div class="space-y-3 lg:pb-4">
                      <h2 class="text-xl md:text-2xl font-bold text-gray-900 leading-tight">
                        <%= @featured_event.name.upcase %>
                      </h2>
                      <p class="text-xs md:text-sm text-gray-600">
                        <%= l(@featured_event.event_date, format: :long) %>
                      </p>
                      <p class="text-gray-700 text-xs md:text-sm leading-relaxed">
                        <%= @featured_event.description %>
                      </p>
                    </div>
                  </div>
                </div>
              <% else %>
                <!-- Autres photos - formats horizontaux variés -->
                <% case (index - 1) % 6 %>
                <% when 0 %>
                  <!-- Photo large horizontale centrée -->
                  <div class="pixel-image-container w-full max-w-xs md:max-w-4xl lg:max-w-5xl mx-auto" data-pixel-scroll-target="container">
                    <%= image_tag photo, 
                        class: "hidden", 
                        data: { pixel_scroll_target: "source" },
                        loading: "lazy" %>
                    <canvas 
                      data-pixel-scroll-target="canvas" 
                      class="w-full h-auto rounded-lg shadow-xl"
                      style="display: block; aspect-ratio: 16/9;"
                    ></canvas>
                  </div>
                <% when 1 %>
                  <!-- Photo moyenne horizontale à gauche -->
                  <div class="pixel-image-container w-full max-w-xs md:max-w-2xl lg:max-w-3xl" data-pixel-scroll-target="container">
                    <%= image_tag photo, 
                        class: "hidden", 
                        data: { pixel_scroll_target: "source" },
                        loading: "lazy" %>
                    <canvas 
                      data-pixel-scroll-target="canvas" 
                      class="w-full h-auto rounded-lg shadow-lg"
                      style="display: block; aspect-ratio: 4/3;"
                    ></canvas>
                  </div>
                <% when 2 %>
                  <!-- Photo moyenne horizontale à droite -->
                  <div class="pixel-image-container w-full max-w-xs md:max-w-2xl lg:max-w-3xl ml-auto" data-pixel-scroll-target="container">
                    <%= image_tag photo, 
                        class: "hidden", 
                        data: { pixel_scroll_target: "source" },
                        loading: "lazy" %>
                    <canvas 
                      data-pixel-scroll-target="canvas" 
                      class="w-full h-auto rounded-lg shadow-lg"
                      style="display: block; aspect-ratio: 4/3;"
                    ></canvas>
                  </div>
                <% when 3 %>
                  <!-- Photo très large horizontale centrée -->
                  <div class="pixel-image-container w-full max-w-xs md:max-w-5xl lg:max-w-6xl mx-auto" data-pixel-scroll-target="container">
                    <%= image_tag photo, 
                        class: "hidden", 
                        data: { pixel_scroll_target: "source" },
                        loading: "lazy" %>
                    <canvas 
                      data-pixel-scroll-target="canvas" 
                      class="w-full h-auto rounded-lg shadow-xl"
                      style="display: block; aspect-ratio: 21/9;"
                    ></canvas>
                  </div>
                <% when 4 %>
                  <!-- Photo horizontale moyenne centrée -->
                  <div class="pixel-image-container w-full max-w-xs md:max-w-3xl lg:max-w-4xl mx-auto" data-pixel-scroll-target="container">
                    <%= image_tag photo, 
                        class: "hidden", 
                        data: { pixel_scroll_target: "source" },
                        loading: "lazy" %>
                    <canvas 
                      data-pixel-scroll-target="canvas" 
                      class="w-full h-auto rounded-lg shadow-lg"
                      style="display: block; aspect-ratio: 3/2;"
                    ></canvas>
                  </div>
                <% when 5 %>
                  <!-- Photo horizontale à gauche -->
                  <div class="pixel-image-container w-full max-w-xs md:max-w-2xl lg:max-w-3xl" data-pixel-scroll-target="container">
                    <%= image_tag photo, 
                        class: "hidden", 
                        data: { pixel_scroll_target: "source" },
                        loading: "lazy" %>
                    <canvas 
                      data-pixel-scroll-target="canvas" 
                      class="w-full h-auto rounded-lg shadow-lg"
                      style="display: block; aspect-ratio: 5/3;"
                    ></canvas>
                  </div>
                <% end %>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-16 text-gray-500">
            <p>Aucune photo disponible pour cet événement.</p>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <!-- Autres événements -->
  <% if @other_events&.any? %>
    <section class="py-16 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-purple-600 mb-8 text-center">Autres événements</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% @other_events.each do |event| %>
            <div class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
              <% if event.photos.attached? %>
                <%= image_tag event.photos.first, 
                    alt: event.name, 
                    class: "w-full h-48 object-cover" %>
              <% else %>
                <div class="w-full h-48 bg-gradient-to-br from-purple-700/20 to-blue-500/20 flex items-center justify-center">
                  <svg class="w-16 h-16 text-purple-700/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                </div>
              <% end %>
              
              <div class="p-6">
                <h3 class="text-xl font-bold text-gray-900 mb-2"><%= event.name %></h3>
                <p class="text-sm text-gray-600 mb-3">
                  <%= l(event.event_date, format: :short) %>
                </p>
                <p class="text-gray-700 text-sm line-clamp-3 mb-4">
                  <%= event.description %>
                </p>
                <div class="flex items-center justify-between">
                  <span class="text-sm text-purple-700 font-semibold">
                    <%= event.photos_count %> photo<%= 's' if event.photos_count > 1 %>
                  </span>
                  <%= link_to "Voir la galerie", galeries_path, 
                      class: "text-purple-700 hover:text-purple-800 font-semibold text-sm" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <!-- Message si aucun événement -->
  <% unless @featured_event || @other_events&.any? %>
    <section class="py-32 text-center">
      <div class="max-w-2xl mx-auto px-4">
        <svg class="w-24 h-24 text-gray-400 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Aucun événement disponible</h2>
        <p class="text-gray-600">Les galeries d'événements seront bientôt disponibles.</p>
      </div>
    </section>
  <% end %>
</div>

