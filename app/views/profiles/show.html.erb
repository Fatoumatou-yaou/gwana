<% content_for :title, "Mon Profil" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
  <!-- Informations de base - Une seule carte -->
  <div class="bg-gradient-to-br from-white via-purple-50/30 to-gray-50 rounded-2xl p-6 md:p-8 mb-8 border border-purple-700/30 shadow-xl hover:shadow-2xl transition-shadow duration-300">
    <div class="flex flex-col lg:flex-row gap-8">
      <!-- Photo ou Avatar -->
      <div class="flex-shrink-0 flex justify-center lg:justify-start">
        <% if @gwana&.persisted? && @gwana&.photo&.attached? %>
          <div class="relative">
            <div class="absolute inset-0 bg-gradient-to-br from-purple-700 to-amber-500 rounded-full blur-2xl opacity-50"></div>
            <%= image_tag @gwana.photo, alt: current_user.full_name, class: "relative w-32 h-32 rounded-full object-cover border-4 border-purple-700/50 shadow-2xl" %>
          </div>
        <% else %>
          <div class="relative">
            <div class="absolute inset-0 bg-gradient-to-br from-purple-700 to-amber-500 rounded-full blur-2xl opacity-50"></div>
            <div class="relative w-32 h-32 rounded-full bg-gradient-to-br from-purple-700 to-purple-800 flex items-center justify-center border-4 border-purple-700/50 shadow-2xl">
              <div class="text-4xl font-bold text-white">
                <%= current_user.first_name&.first&.upcase || 'U' %><%= current_user.last_name&.first&.upcase || '' %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Informations principales -->
      <div class="flex-1">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-6">
          <div>
            <h1 class="text-3xl md:text-4xl font-bold bg-gradient-to-r from-purple-700 to-purple-800 bg-clip-text text-transparent mb-2">
              <%= current_user.full_name %>
            </h1>
            <% if @gwana&.profession.present? %>
              <p class="text-xl text-amber-500 font-semibold mb-3"><%= @gwana.profession %></p>
            <% end %>
          </div>
          <%= link_to edit_profile_path, class: "inline-flex items-center gap-2 px-4 py-2 bg-purple-700 hover:bg-purple-800 text-white rounded-lg font-semibold transition-all duration-300 hover:scale-105 shadow-lg self-start" do %>
            <span class="material-symbols-outlined text-lg">edit</span>
            Modifier
          <% end %>
        </div>

        <!-- Grille d'informations -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Informations personnelles -->
          <div class="space-y-4">
            <h3 class="text-sm font-semibold text-purple-700 uppercase tracking-wide mb-3">Informations personnelles</h3>
            
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-purple-700 text-xl mt-0.5">email</span>
              <div>
                <p class="text-xs text-gray-500 uppercase">Email</p>
                <p class="text-gray-900 font-medium break-all"><%= current_user.email %></p>
              </div>
            </div>

            <% if @gwana&.phone.present? %>
              <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-purple-700 text-xl mt-0.5">phone</span>
                <div>
                  <p class="text-xs text-gray-500 uppercase">Téléphone</p>
                  <p class="text-gray-900 font-medium"><%= @gwana.phone %></p>
                </div>
              </div>
            <% end %>

            <% if @gwana&.address.present? %>
              <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-purple-700 text-xl mt-0.5">location_on</span>
                <div>
                  <p class="text-xs text-gray-500 uppercase">Adresse</p>
                  <p class="text-gray-900 font-medium break-words"><%= @gwana.address %></p>
                </div>
              </div>
            <% end %>

            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-purple-700 text-xl mt-0.5">person</span>
              <div>
                <p class="text-xs text-gray-500 uppercase">Profil</p>
                <span class="inline-flex items-center gap-1 bg-purple-700/20 text-purple-700 font-semibold px-3 py-1 rounded-full text-sm border border-purple-700/30">
                  <%= current_user.profile.capitalize %>
                </span>
              </div>
            </div>
          </div>

          <!-- Localisation et statut -->
          <div class="space-y-4">
            <h3 class="text-sm font-semibold text-purple-700 uppercase tracking-wide mb-3">Localisation & Statut</h3>
            
            <% if @gwana&.region.present? %>
              <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-purple-700 text-xl mt-0.5">place</span>
                <div>
                  <p class="text-xs text-gray-500 uppercase">Localisation</p>
                  <p class="text-gray-900 font-medium">
                    <%= @gwana.region %>
                    <% if @gwana.commune.present? %>
                      <span class="text-gray-600">• <%= @gwana.commune.name %></span>
                    <% end %>
                  </p>
                </div>
              </div>
            <% end %>

            <% if @gwana&.available_for_mentorship? %>
              <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-amber-500 text-xl mt-0.5">star</span>
                <div>
                  <p class="text-xs text-gray-500 uppercase">Disponibilité</p>
                  <span class="inline-flex items-center gap-1 bg-gradient-to-r from-purple-700/30 to-purple-800/30 text-amber-500 font-semibold px-3 py-1 rounded-full text-sm border border-amber-500/30">
                    Disponible pour mentorat
                  </span>
                </div>
              </div>
            <% end %>

            <!-- Réseaux sociaux -->
            <% if @gwana && (@gwana.linkedin_url.present? || @gwana.twitter_url.present? || @gwana.website_url.present?) %>
              <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-purple-700 text-xl mt-0.5">share</span>
                <div>
                  <p class="text-xs text-gray-500 uppercase mb-2">Réseaux sociaux</p>
                  <div class="flex items-center gap-2">
                    <% if @gwana.linkedin_url.present? %>
                      <%= link_to @gwana.linkedin_url, target: "_blank", rel: "noopener", class: "w-9 h-9 flex items-center justify-center bg-purple-700/20 hover:bg-purple-700/40 text-purple-700 rounded-full transition-all hover:scale-110 border border-purple-700/30" do %>
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                      <% end %>
                    <% end %>
                    <% if @gwana.twitter_url.present? %>
                      <%= link_to @gwana.twitter_url, target: "_blank", rel: "noopener", class: "w-9 h-9 flex items-center justify-center bg-purple-700/20 hover:bg-purple-700/40 text-purple-700 rounded-full transition-all hover:scale-110 border border-purple-700/30" do %>
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/></svg>
                      <% end %>
                    <% end %>
                    <% if @gwana.website_url.present? %>
                      <%= link_to @gwana.website_url, target: "_blank", rel: "noopener", class: "w-9 h-9 flex items-center justify-center bg-purple-700/20 hover:bg-purple-700/40 text-purple-700 rounded-full transition-all hover:scale-110 border border-purple-700/30" do %>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats Section -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <% if current_user.user? %>
      <div class="bg-white rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-12 h-12 rounded-full bg-purple-700/20 flex items-center justify-center">
            <span class="material-symbols-outlined text-purple-700 text-2xl">send</span>
          </div>
          <div>
            <div class="text-3xl font-bold text-purple-700"><%= current_user.mentorship_requests_as_requester.count %></div>
            <div class="text-gray-600 text-sm">Demandes envoyées</div>
          </div>
        </div>
      </div>
    <% end %>

    <% if current_user.gwana? %>
      <div class="bg-white rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-12 h-12 rounded-full bg-amber-500/20 flex items-center justify-center">
            <span class="material-symbols-outlined text-amber-500 text-2xl">inbox</span>
          </div>
          <div>
            <div class="text-3xl font-bold text-amber-500"><%= current_user.mentorship_requests_as_mentor.count %></div>
            <div class="text-gray-600 text-sm">Demandes reçues</div>
          </div>
        </div>
      </div>
      <div class="bg-white rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-12 h-12 rounded-full bg-green-500/20 flex items-center justify-center">
            <span class="material-symbols-outlined text-green-500 text-2xl">check_circle</span>
          </div>
          <div>
            <div class="text-3xl font-bold text-green-500"><%= current_user.mentorship_requests_as_mentor.accepted.count %></div>
            <div class="text-gray-600 text-sm">Mentorats actifs</div>
          </div>
        </div>
      </div>
    <% end %>


  </div>

  <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
      <!-- Left Column - Main Info -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Biographie -->
        <% if @gwana.bio.present? %>
          <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
                <span class="material-symbols-outlined text-amber-500 text-xl">person</span>
              </div>
              <h2 class="text-2xl font-bold text-amber-500">Biographie</h2>
            </div>
            <div class="text-gray-700 leading-relaxed">
              <%= simple_format(@gwana.bio) %>
            </div>
          </div>
        <% end %>

        <!-- Expériences -->
        <% if @gwana.experiences.present? %>
          <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
                <span class="material-symbols-outlined text-amber-500 text-xl">work</span>
              </div>
              <h2 class="text-2xl font-bold text-amber-500">Expériences professionnelles</h2>
            </div>
            <div class="text-gray-700 leading-relaxed">
              <%= simple_format(@gwana.experiences) %>
            </div>
          </div>
        <% end %>

        <!-- Formations -->
        <% if @gwana.formations.present? %>
          <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
                <span class="material-symbols-outlined text-amber-500 text-xl">school</span>
              </div>
              <h2 class="text-2xl font-bold text-amber-500">Formations</h2>
            </div>
            <div class="text-gray-700 leading-relaxed">
              <%= simple_format(@gwana.formations) %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Right Column - Sidebar Info -->
      <div class="space-y-6 lg:sticky lg:top-6 lg:self-start">
        <!-- Compétences -->
        <% if @gwana.skills.present? && @gwana.skills_array.any? %>
          <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
                <span class="material-symbols-outlined text-amber-500 text-xl">psychology</span>
              </div>
              <h2 class="text-xl font-bold text-amber-500">Compétences</h2>
            </div>
            <div class="flex flex-wrap gap-2">
              <% @gwana.skills_array.each do |skill| %>
                <span class="bg-purple-700/20 text-amber-500 px-4 py-2 rounded-full text-sm font-medium border border-purple-700/30 hover:bg-purple-700/30 hover:border-purple-700/50 transition-all duration-200 cursor-default">
                  <%= skill %>
                </span>
              <% end %>
            </div>
          </div>
        <% end %>

    </div>
</div>
