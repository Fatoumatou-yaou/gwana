<% content_for :title, "Mon Profil" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
  <!-- Header Section -->
  <div class="bg-gradient-to-br from-white via-purple-50/30 to-gray-50 rounded-2xl p-6 md:p-8 mb-8 border border-purple-700/30 shadow-xl hover:shadow-2xl transition-shadow duration-300">
    <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
      <!-- Photo ou Avatar -->
      <div class="flex-shrink-0">
        <% if @gwana&.persisted? && @gwana&.photo&.attached? %>
          <div class="relative">
            <div class="absolute inset-0 bg-gradient-to-br from-purple-700 to-amber-500 rounded-full blur-2xl opacity-50"></div>
            <%= image_tag @gwana.photo, alt: current_user.full_name, class: "relative w-40 h-40 rounded-full object-cover border-4 border-purple-700/50 shadow-2xl" %>
          </div>
        <% else %>
          <div class="relative">
            <div class="absolute inset-0 bg-gradient-to-br from-purple-700 to-amber-500 rounded-full blur-2xl opacity-50"></div>
            <div class="relative w-40 h-40 rounded-full bg-gradient-to-br from-purple-700 to-purple-800 flex items-center justify-center border-4 border-purple-700/50 shadow-2xl">
              <div class="text-5xl font-bold text-white">
                <%= current_user.first_name&.first&.upcase || 'U' %><%= current_user.last_name&.first&.upcase || '' %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Name and Basic Info -->
      <div class="flex-1 text-center md:text-left">
        <div class="flex items-center justify-center md:justify-start gap-4 mb-4">
          <h1 class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-purple-700 to-purple-800 bg-clip-text text-transparent">
            <%= current_user.full_name %>
          </h1>
          <%= link_to edit_profile_path, class: "inline-flex items-center gap-2 px-4 py-2 bg-purple-700 hover:bg-purple-800 text-white rounded-lg font-semibold transition-all duration-300 hover:scale-105 shadow-lg" do %>
            <span class="material-symbols-outlined text-lg">edit</span>
            Modifier mon profil
          <% end %>
        </div>
        
        <p class="text-xl text-gray-600 mb-2"><%= current_user.email %></p>
        
        <div class="flex items-center justify-center md:justify-start gap-3 mb-4">
          <span class="inline-flex items-center gap-2 bg-purple-700/20 text-purple-700 font-semibold px-4 py-1.5 rounded-full border border-purple-700/30">
            <span class="material-symbols-outlined text-base">person</span>
            <%= current_user.profile.capitalize %>
          </span>
          <% if @gwana&.profession.present? %>
            <span class="text-lg text-amber-500 font-semibold"><%= @gwana.profession %></span>
          <% end %>
        </div>

        <!-- Location Info -->
        <% if @gwana&.region.present? %>
          <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 mb-4 text-gray-700">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span><%= @gwana.region %></span>
              <% if @gwana.commune.present? %>
                <span class="text-gray-500">• <%= @gwana.commune.name %></span>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Badge and Social Links -->
        <div class="flex flex-wrap items-center justify-center md:justify-start gap-4">
          <% if @gwana&.available_for_mentorship? %>
            <span class="inline-flex items-center gap-2 bg-gradient-to-r from-purple-700/30 to-purple-800/30 text-amber-500 font-semibold px-5 py-2 rounded-full border border-amber-500/30 shadow-lg">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
              Disponible pour mentorat
            </span>
          <% end %>

          <!-- Social Links -->
          <% if @gwana %>
            <div class="flex items-center gap-3">
              <% if @gwana.linkedin_url.present? %>
                <%= link_to @gwana.linkedin_url, target: "_blank", rel: "noopener", class: "w-10 h-10 flex items-center justify-center bg-purple-700/20 hover:bg-purple-700/40 text-amber-500 rounded-full transition-all hover:scale-110 border border-purple-700/30" do %>
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                <% end %>
              <% end %>
              <% if @gwana.twitter_url.present? %>
                <%= link_to @gwana.twitter_url, target: "_blank", rel: "noopener", class: "w-10 h-10 flex items-center justify-center bg-purple-700/20 hover:bg-purple-700/40 text-amber-500 rounded-full transition-all hover:scale-110 border border-purple-700/30" do %>
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/></svg>
                <% end %>
              <% end %>
              <% if @gwana.website_url.present? %>
                <%= link_to @gwana.website_url, target: "_blank", rel: "noopener", class: "w-10 h-10 flex items-center justify-center bg-purple-700/20 hover:bg-purple-700/40 text-amber-500 rounded-full transition-all hover:scale-110 border border-purple-700/30" do %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats Section -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <% if current_user.user? %>
      <div class="bg-white rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-12 h-12 rounded-full bg-purple-700/20 flex items-center justify-center">
            <span class="material-symbols-outlined text-purple-700 text-2xl">send</span>
          </div>
          <div>
            <div class="text-3xl font-bold text-purple-700"><%= current_user.mentorship_requests_as_requester.count %></div>
            <div class="text-gray-600 text-sm">Demandes envoyées</div>
          </div>
        </div>
      </div>
    <% end %>

    <% if current_user.gwana? %>
      <div class="bg-white rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-12 h-12 rounded-full bg-amber-500/20 flex items-center justify-center">
            <span class="material-symbols-outlined text-amber-500 text-2xl">inbox</span>
          </div>
          <div>
            <div class="text-3xl font-bold text-amber-500"><%= current_user.mentorship_requests_as_mentor.count %></div>
            <div class="text-gray-600 text-sm">Demandes reçues</div>
          </div>
        </div>
      </div>
      <div class="bg-white rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-12 h-12 rounded-full bg-green-500/20 flex items-center justify-center">
            <span class="material-symbols-outlined text-green-500 text-2xl">check_circle</span>
          </div>
          <div>
            <div class="text-3xl font-bold text-green-500"><%= current_user.mentorship_requests_as_mentor.accepted.count %></div>
            <div class="text-gray-600 text-sm">Mentorats actifs</div>
          </div>
        </div>
      </div>
    <% end %>

    <% if current_user.admin? %>
      <div class="bg-white rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-12 h-12 rounded-full bg-purple-700/20 flex items-center justify-center">
            <span class="material-symbols-outlined text-purple-700 text-2xl">admin_panel_settings</span>
          </div>
          <div>
            <div class="text-3xl font-bold text-purple-700">Admin</div>
            <div class="text-gray-600 text-sm">Panneau d'administration</div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
      <!-- Left Column - Main Info -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Biographie -->
        <% if @gwana.bio.present? %>
          <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
                <span class="material-symbols-outlined text-amber-500 text-xl">person</span>
              </div>
              <h2 class="text-2xl font-bold text-amber-500">Biographie</h2>
            </div>
            <div class="text-gray-700 leading-relaxed">
              <%= simple_format(@gwana.bio) %>
            </div>
          </div>
        <% end %>

        <!-- Expériences -->
        <% if @gwana.experiences.present? %>
          <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
                <span class="material-symbols-outlined text-amber-500 text-xl">work</span>
              </div>
              <h2 class="text-2xl font-bold text-amber-500">Expériences professionnelles</h2>
            </div>
            <div class="text-gray-700 leading-relaxed">
              <%= simple_format(@gwana.experiences) %>
            </div>
          </div>
        <% end %>

        <!-- Formations -->
        <% if @gwana.formations.present? %>
          <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
                <span class="material-symbols-outlined text-amber-500 text-xl">school</span>
              </div>
              <h2 class="text-2xl font-bold text-amber-500">Formations</h2>
            </div>
            <div class="text-gray-700 leading-relaxed">
              <%= simple_format(@gwana.formations) %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Right Column - Sidebar Info -->
      <div class="space-y-6 lg:sticky lg:top-6 lg:self-start">
        <!-- Compétences -->
        <% if @gwana.skills.present? && @gwana.skills_array.any? %>
          <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
                <span class="material-symbols-outlined text-amber-500 text-xl">psychology</span>
              </div>
              <h2 class="text-xl font-bold text-amber-500">Compétences</h2>
            </div>
            <div class="flex flex-wrap gap-2">
              <% @gwana.skills_array.each do |skill| %>
                <span class="bg-purple-700/20 text-amber-500 px-4 py-2 rounded-full text-sm font-medium border border-purple-700/30 hover:bg-purple-700/30 hover:border-purple-700/50 transition-all duration-200 cursor-default">
                  <%= skill %>
                </span>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Informations de contact -->
        <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 border border-purple-700/30 shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-purple-700/20 flex items-center justify-center">
              <span class="material-symbols-outlined text-amber-500 text-xl">contact_mail</span>
            </div>
            <h2 class="text-xl font-bold text-amber-500">Contact</h2>
          </div>
          <div class="space-y-3 text-gray-700">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-purple-700 text-lg">email</span>
              <span class="text-sm"><%= current_user.email %></span>
            </div>
            <% if @gwana.phone.present? %>
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-purple-700 text-lg">phone</span>
                <span class="text-sm"><%= @gwana.phone %></span>
              </div>
            <% end %>
            <% if @gwana.address.present? %>
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-purple-700 text-lg">location_on</span>
                <span class="text-sm"><%= @gwana.address %></span>
              </div>
            <% end %>
          </div>
        </div>
    </div>
</div>
